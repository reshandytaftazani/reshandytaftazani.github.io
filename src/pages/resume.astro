  <!-- Interactive Scripts: ESC to home, Copy Plain Text (ATS), Print Trigger -->
  <script>
    function setupResumeInteractions() {
      // 1. ESC Key returns to Homepage
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          // If any modal/drawer overlay is active, let the overlay close itself and DO NOT navigate away
          if ((window as any).isAnyOverlayOpen && (window as any).isAnyOverlayOpen()) {
            return;
          }

          if ((window as any).navigateWithCurtain) {
            (window as any).navigateWithCurtain("/");
          } else {
            window.location.href = "/";
          }
        }
      });

      // 2. Print Button Trigger
      const printBtn = document.getElementById("print-cv-button");
      if (printBtn) {
        printBtn.addEventListener("click", () => {
          window.print();
        });
      }

      // 3. Copy Plain Text (ATS) to Clipboard with tactile state feedback
      const copyBtn = document.getElementById("copy-ats-button");
      const copyTextEl = document.getElementById("copy-ats-text");
      const plainTextStore = document.getElementById("ats-plain-text");

      if (copyBtn && copyTextEl && plainTextStore) {
        copyBtn.addEventListener("click", () => {
          const content = plainTextStore.textContent || "";
          
          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(content).then(showCopiedState).catch(() => fallbackCopy(content));
          } else {
            fallbackCopy(content);
          }
        });

        function showCopiedState() {
          if (!copyTextEl || !copyBtn) return;
          const originalText = copyTextEl.textContent;
          copyTextEl.textContent = "COPIED TO CLIPBOARD ✓";
          copyBtn.classList.add("border-accent", "bg-accent", "text-black");
          
          setTimeout(() => {
            copyTextEl.textContent = originalText;
            copyBtn.classList.remove("border-accent", "bg-accent", "text-black");
          }, 2500);
        }

        function fallbackCopy(text: string) {
          try {
            const temp = document.createElement("textarea");
            temp.value = text;
            temp.style.position = "fixed";
            temp.style.opacity = "0";
            document.body.appendChild(temp);
            temp.focus();
            temp.select();
            document.execCommand("copy");
            document.body.removeChild(temp);
            showCopiedState();
          } catch (err) {
            console.error("Fallback clipboard copy failed:", err);
          }
        }
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupResumeInteractions);
    } else {
      setupResumeInteractions();
    }
    document.addEventListener("astro:page-load", setupResumeInteractions);
  </script>
