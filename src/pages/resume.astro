<Layout 
  title="Reshandy Taftazani Aulya — Curriculum Vitae | ML & Systems Engineer"
  description="Printable Swiss Technical CV of Reshandy Taftazani Aulya. Computer Science undergraduate at Universitas Indonesia (Fasilkom UI). Machine Learning Engineering & Software Systems."
  ogImage="/api/og/resume.png"
>
  <!-- Hidden ATS Text Store for Clipboard copy (Stored in script to avoid layout rendering) -->
  <script id="ats-plain-text" type="text/plain" class="no-print" aria-hidden="true">{plainTextATS}</script>

  <!-- Screen Sticky Quick Action Bar (Suppressed on Print) -->
  <header class="no-print sticky top-0 z-40 w-full border-b border-[#262626] bg-[#0a0a0a]/95 backdrop-blur-md text-foreground">
    <div class="mx-auto flex max-w-[120rem] items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
      
      <!-- Left: Return to Home / ESC -->
      <a 
        href="/" 
        id="cv-back-home-link"
        class="group inline-flex items-center gap-1.5 sm:gap-2 font-mono text-xs font-bold text-neutral hover:text-white transition-colors"
        title="Return to Homepage (or press ESC)"
      >
        <span class="text-accent group-hover:-translate-x-1 transition-transform duration-200">←</span>
        <span class="hidden sm:inline">BACK TO HOME</span>
        <span class="sm:hidden">HOME</span>
        <span class="hidden md:inline-block text-[10px] text-neutral-dark group-hover:text-neutral font-mono border border-[#333] px-1 py-0.5 rounded-xs">ESC</span>
      </a>

      <!-- Quick Link to Notes (Screen only) -->
      <a 
        href="/notes" 
        class="hidden sm:inline-flex items-center gap-1 font-mono text-xs font-bold text-neutral hover:text-accent transition-colors"
        title="Technical Field Notes"
      >
        <span>FIELD NOTES</span>
        <span class="text-accent text-[10px]">↗</span>
      </a>

      <!-- Center: Technical Document Telemetry (Desktop) -->
      <div class="hidden lg:flex items-center gap-2 font-mono text-[11px] text-neutral-dark uppercase tracking-wider select-none">
        <span class="text-foreground font-bold">{personalInfo.docId}</span>
        <span>//</span>
        <span class="text-accent font-semibold">SWISS_TECHNICAL_SPEC</span>
        <span>//</span>
        <span class="text-neutral">A4_OPTIMIZED</span>
      </div>

      <!-- Right: Action Buttons (Print & Copy ATS) -->
      <div class="flex items-center gap-2 sm:gap-3 font-mono text-xs">
        
        <!-- Copy Plain Text (ATS) -->
        <button 
          type="button" 
          id="copy-ats-button"
          class="group inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-xs border border-neutral-dark/60 hover:border-accent bg-[#161616] hover:bg-accent text-neutral hover:text-black font-bold transition-all duration-200 cursor-pointer shadow-2xs active:scale-95 select-none"
          title="Copy formatted plain text (ATS-friendly) to clipboard"
          aria-label="Copy plain text ATS resume to clipboard"
        >
          <span class="text-neutral-dark group-hover:text-black transition-transform duration-200 group-hover:-translate-x-0.5">[</span>
          <span id="copy-ats-text" class="tracking-wider group-hover:text-black">COPY PLAIN TEXT (ATS)</span>
          <svg class="w-3 h-3 text-accent group-hover:text-black transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="1" ry="1"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span class="text-neutral-dark group-hover:text-black transition-transform duration-200 group-hover:translate-x-0.5">]</span>
        </button>

        <!-- Print / Save PDF -->
        <button 
          type="button" 
          id="print-cv-button"
          class="group inline-flex items-center gap-1.5 px-3 sm:px-3.5 py-1.5 rounded-xs border border-accent bg-accent text-black hover:bg-white hover:border-white font-bold transition-all duration-200 cursor-pointer shadow-xs active:scale-95 select-none"
          title="Print document or Save as PDF (Ctrl + P)"
          aria-label="Print or Save Resume as PDF"
        >
          <span class="tracking-wider">PRINT / SAVE PDF</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
        </button>

      </div>

    </div>
  </header>

