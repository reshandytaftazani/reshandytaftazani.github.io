---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project, index) => {
    const prevProject = index > 0 ? projects[index - 1] : projects[projects.length - 1];
    const nextProject = index < projects.length - 1 ? projects[index + 1] : projects[0];
    return {
      params: { slug: project.id },
      props: { project, prevProject, nextProject },
    };
  });
}

const { project, prevProject, nextProject } = Astro.props;
const { Content } = await render(project);
---

<Layout 
  title={`${project.data.title} — System Spec & Architecture | Reshandy Taftazani`}
  description={project.data.subtitle}
>
  <main class="min-h-screen bg-[#0a0a0a] text-neutral-200 selection:bg-[#ff4500] selection:text-white font-sans relative">
    
    <!-- Topbar Navigation -->
    <header class="sticky top-0 z-40 w-full border-b border-[#1f1f1f] bg-[#0a0a0a]/90 backdrop-blur-md">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
        
        <!-- Left: Back to Works -->
        <a 
          href="/#projects" 
          id="back-link"
          class="group inline-flex items-center gap-2 font-mono text-xs font-semibold text-neutral-400 hover:text-white transition-colors"
          title="Return to Selected Works (or press ESC)"
        >
          <span class="text-[#ff4500] group-hover:-translate-x-1 transition-transform duration-200">←</span>
          <span>WORKS</span>
          <span class="hidden sm:inline-block text-[10px] text-neutral-600 group-hover:text-neutral-400 font-mono border border-[#262626] px-1 py-0.2 rounded-xs">ESC</span>
        </a>

        <!-- Center: Telemetry Breadcrumb -->
        <div class="hidden md:flex items-center gap-2 font-mono text-[11px] text-neutral-500 uppercase tracking-wider">
          <span>SPEC</span>
          <span class="text-[#333]">//</span>
          <span class="text-[#ff4500] font-semibold">{project.data.category}</span>
          <span class="text-[#333]">//</span>
          <span class="text-neutral-300 truncate max-w-[200px]">{project.data.title}</span>
        </div>

        <!-- Right: Status Ping & Clock -->
        <div class="flex items-center gap-3 font-mono text-xs">
          <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-[#141414] border border-[#222]">
            <span class="h-1.5 w-1.5 rounded-full bg-[#ff4500] animate-pulse"></span>
            <span class="text-[10px] text-neutral-400 uppercase tracking-widest font-semibold">{project.data.status}</span>
          </div>
        </div>

      </div>
    </header>

    <!-- Blueprint Grid Layout -->
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
      
      <!-- HERO TELEMETRY -->
      <section class="border-b border-[#1f1f1f] pb-12 sm:pb-16">
        
        <!-- Meta Pills Row -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 font-mono text-xs mb-6">
          <span class="px-2.5 py-1 rounded-xs bg-[#ff4500]/15 text-[#ff4500] font-bold uppercase tracking-wider border border-[#ff4500]/30">
            {project.data.category}
          </span>
          <span class="px-2.5 py-1 rounded-xs bg-[#171717] text-neutral-400 border border-[#262626]">
            TIMELINE: {project.data.timeline}
          </span>
          <span class="px-2.5 py-1 rounded-xs bg-[#171717] text-neutral-400 border border-[#262626]">
            ROLE: {project.data.role}
          </span>
        </div>

        <!-- Big Display Title -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight leading-[1.05]">
          {project.data.title}<span class="text-[#ff4500]">.</span>
        </h1>
        
        <p class="mt-4 text-lg sm:text-2xl text-neutral-400 font-normal max-w-3xl leading-relaxed">
          {project.data.subtitle}
        </p>

        <!-- Tech Stack Tags -->
        <div class="mt-6 flex flex-wrap gap-1.5 sm:gap-2">
          {project.data.techStack.map((tech) => (
            <span class="font-mono text-xs px-2.5 py-1 rounded-xs bg-[#141414] text-neutral-300 border border-[#222]">
              {tech}
            </span>
          ))}
        </div>

        <!-- Quick Action Bar -->
        <div class="mt-8 flex flex-wrap items-center gap-3 font-mono text-xs">
          <!-- View on GitHub -->
          <a 
            href={project.data.githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xs bg-white text-black font-bold hover:bg-[#ff4500] hover:text-white transition-all duration-200"
          >
            <span>SOURCE CODE</span>
            <span class="text-sm font-bold">↗</span>
          </a>

          <!-- Quick Run CLI Micro-interaction -->
          <button 
            type="button" 
            class="copy-cmd-btn inline-flex items-center gap-2 px-4 py-2 rounded-xs bg-[#141414] hover:bg-[#1f1f1f] text-neutral-200 border border-[#262626] transition-all duration-200 cursor-pointer font-bold"
            data-run-cmd={project.data.runCommand}
          >
            <span class="text-[#ff4500]">$</span>
            <span class="cmd-text">{project.data.runCommand}</span>
            <span class="copy-feedback text-[10px] text-neutral-500 uppercase tracking-widest ml-1 font-semibold">COPY</span>
          </button>
        </div>

      </section>

      <!-- METRICS MATRIX -->
      <section class="border-b border-[#1f1f1f] py-10 sm:py-12">
        <div class="flex items-center gap-2 font-mono text-xs text-[#ff4500] uppercase font-bold tracking-wider mb-6">
          <span>●</span>
          <span>VERIFIED DEFENSIVE METRICS</span>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          {project.data.metrics.map((metric) => (
            <div class="bg-[#121212] border border-[#222] p-5 rounded-xs flex flex-col justify-between">
              <div>
                <span class="font-mono text-xs text-neutral-400 uppercase tracking-wider block mb-1">
                  {metric.label}
                </span>
                <span class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-mono">
                  {metric.value}
                </span>
              </div>
              <p class="mt-4 text-xs text-neutral-400 leading-relaxed font-sans">
                {metric.detail}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- SPECIFICATION & ARCHITECTURE BODY -->
      <article class="prose-blueprint py-12 sm:py-16 max-w-none">
        <Content />
      </article>

      <!-- INTER-PROJECT PAGINATION FOOTER -->
      <nav class="border-t border-[#1f1f1f] pt-12 pb-16 flex flex-col sm:flex-row items-center justify-between gap-6" aria-label="Project pagination">
        
        <!-- Prev Project -->
        <a 
          href={`/projects/${prevProject.id}`}
          class="group flex flex-col items-start gap-1 p-4 rounded-xs border border-[#1f1f1f] hover:border-[#ff4500]/50 bg-[#121212] w-full sm:w-1/2 transition-all duration-200"
        >
          <span class="font-mono text-[11px] text-neutral-500 uppercase tracking-wider group-hover:text-[#ff4500] transition-colors">
            ← PREVIOUS SYSTEM
          </span>
          <span class="text-base sm:text-lg font-bold text-white group-hover:translate-x-1 transition-transform duration-200">
            {prevProject.data.title}
          </span>
          <span class="text-xs text-neutral-400 font-mono">
            [{prevProject.data.category}]
          </span>
        </a>

        <!-- Next Project -->
        <a 
          href={`/projects/${nextProject.id}`}
          class="group flex flex-col items-end gap-1 p-4 rounded-xs border border-[#1f1f1f] hover:border-[#ff4500]/50 bg-[#121212] w-full sm:w-1/2 transition-all duration-200 text-right"
        >
          <span class="font-mono text-[11px] text-neutral-500 uppercase tracking-wider group-hover:text-[#ff4500] transition-colors">
            NEXT SYSTEM →
          </span>
          <span class="text-base sm:text-lg font-bold text-white group-hover:-translate-x-1 transition-transform duration-200">
            {nextProject.data.title}
          </span>
          <span class="text-xs text-neutral-400 font-mono">
            [{nextProject.data.category}]
          </span>
        </a>

      </nav>

    </div>
  </main>

  <!-- Interactive Scripts: ESC key to return, Copy CLI command -->
  <script>
    function setupBlueprintInteractions() {
      // 1. ESC Key returns to Works
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          window.location.href = "/#projects";
        }
      });

      // 2. Quick Copy CLI Command
      document.querySelectorAll<HTMLButtonElement>(".copy-cmd-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const cmd = btn.getAttribute("data-run-cmd");
          const feedback = btn.querySelector(".copy-feedback");
          if (!cmd || !feedback) return;

          navigator.clipboard.writeText(cmd).then(() => {
            feedback.textContent = "COPIED ✓";
            feedback.classList.add("text-[#ff4500]");
            setTimeout(() => {
              feedback.textContent = "COPY";
              feedback.classList.remove("text-[#ff4500]");
            }, 2000);
          });
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupBlueprintInteractions);
    } else {
      setupBlueprintInteractions();
    }
  </script>
</Layout>

<style is:global>
  /* High-Rigor Blueprint Typography */
  .prose-blueprint h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffffff;
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #1f1f1f;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .prose-blueprint h2::before {
    content: "■";
    color: #ff4500;
    font-size: 0.875rem;
  }
  .prose-blueprint h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #f5f5f5;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }
  .prose-blueprint p {
    color: #a3a3a3;
    line-height: 1.75;
    margin-bottom: 1.25rem;
    font-size: 1rem;
  }
  .prose-blueprint strong {
    color: #ffffff;
    font-weight: 600;
  }
  .prose-blueprint ul {
    margin-bottom: 1.5rem;
    padding-left: 1.25rem;
    list-style-type: square;
    color: #a3a3a3;
  }
  .prose-blueprint li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }
  .prose-blueprint li::marker {
    color: #ff4500;
  }
  
  /* Monospace Diagrams & ASCII Blueprints */
  .prose-blueprint pre {
    background-color: #0d0d0d !important;
    border: 1px solid #222222;
    border-radius: 2px;
    padding: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 1.75rem;
    overflow-x: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: #d4d4d4;
  }
  .prose-blueprint code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875em;
    background-color: #171717;
    color: #f5f5f5;
    padding: 0.15rem 0.35rem;
    border-radius: 2px;
    border: 1px solid #262626;
  }
  .prose-blueprint pre code {
    background-color: transparent;
    padding: 0;
    border: none;
    color: inherit;
    font-size: inherit;
  }

  /* Benchmark & Comparison Tables */
  .prose-blueprint table {
    width: 100%;
    margin-top: 1.5rem;
    margin-bottom: 2rem;
    border-collapse: collapse;
    font-size: 0.875rem;
    border: 1px solid #222222;
  }
  .prose-blueprint th {
    background-color: #141414;
    color: #ffffff;
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #262626;
    border-right: 1px solid #1f1f1f;
  }
  .prose-blueprint td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #1a1a1a;
    border-right: 1px solid #1f1f1f;
    color: #a3a3a3;
  }
  .prose-blueprint tr:last-child td {
    border-bottom: none;
  }
  .prose-blueprint tr:nth-child(even) td {
    background-color: #0f0f0f;
  }
  .prose-blueprint tr:hover td {
    background-color: #141414;
    color: #f5f5f5;
  }
</style>
