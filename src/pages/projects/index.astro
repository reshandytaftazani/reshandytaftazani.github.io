---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');

// Sort: Featured first, then alphabetical/timeline
const sortedProjects = [...allProjects].sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return a.data.title.localeCompare(b.data.title);
});

// Extract unique categories
const categories = ["ALL", ...new Set(allProjects.map((p) => p.data.category))];
---

<Layout 
  title="Projects & Engineering Directory | Reshandy Taftazani"
  description="Comprehensive archival directory of machine learning frameworks, defensive accounting engines, distributed platforms, and verification harnesses by Reshandy Taftazani."
>
  <main class="min-h-screen bg-[#0a0a0a] text-neutral-200 selection:bg-[#ff4500] selection:text-white font-sans relative">
    
    <!-- Topbar Navigation -->
    <header class="sticky top-0 z-40 w-full border-b border-[#1f1f1f] bg-[#0a0a0a]/90 backdrop-blur-md">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
        
        <!-- Left: Back to Home -->
        <a 
          href="/#projects" 
          id="back-home-link"
          class="group inline-flex items-center gap-2 font-mono text-xs font-semibold text-neutral-400 hover:text-white transition-colors"
          title="Return to Selected Works (or press ESC)"
        >
          <span class="text-[#ff4500] group-hover:-translate-x-1 transition-transform duration-200">←</span>
          <span>HOME</span>
          <span class="hidden sm:inline-block text-[10px] text-neutral-600 group-hover:text-neutral-400 font-mono border border-[#262626] px-1 py-0.2 rounded-xs">ESC</span>
        </a>

        <!-- Center: Telemetry Indicator -->
        <div class="hidden md:flex items-center gap-2 font-mono text-[11px] text-neutral-500 uppercase tracking-wider select-none">
          <span>CATALOG</span>
          <span class="text-[#333]">//</span>
          <span class="text-[#ff4500] font-semibold">SYSTEMS_DIRECTORY</span>
          <span class="text-[#333]">//</span>
          <span class="text-neutral-300">ALL_WORKS</span>
        </div>

        <!-- Right: Actions & CV Link -->
        <div class="flex items-center gap-3 font-mono text-xs">
          <div class="hidden sm:flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-[#141414] border border-[#222]">
            <span class="h-1.5 w-1.5 rounded-full bg-[#ff4500] animate-pulse"></span>
            <span class="text-[10px] text-neutral-400 uppercase tracking-widest font-semibold">{allProjects.length} REPOSITORIES</span>
          </div>

          <a 
            href="/resume" 
            class="group inline-flex items-center gap-1 px-2.5 py-1 rounded-xs border border-[#333] hover:border-[#ff4500] bg-[#141414] hover:bg-[#ff4500] text-neutral-300 hover:text-black font-bold transition-all duration-200"
            title="View Printable Swiss Technical CV"
          >
            <span>CV</span>
            <span class="text-[#ff4500] group-hover:text-black text-xs">↗</span>
          </a>
        </div>

      </div>
    </header>

    <!-- Main Container -->
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
      
      <!-- HERO DIRECTORY TITLE -->
      <section class="border-b border-[#1f1f1f] pb-10 sm:pb-12">
        <div class="flex items-center gap-2 font-mono text-xs text-[#ff4500] tracking-widest uppercase mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-[#ff4500] animate-pulse"></span>
          <span>SYSTEMS ARCHIVE // DIRECTORY SPECIFICATION</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight leading-[1.05]">
          ENGINEERING DIRECTORY<span class="text-[#ff4500]">.</span>
        </h1>
        
        <p class="mt-4 text-base sm:text-xl text-neutral-400 font-normal max-w-3xl leading-relaxed">
          Comprehensive chronological index of machine learning frameworks, defensive accounting engines, distributed platforms, and temporal verification harnesses.
        </p>

        <!-- Search & Category Filters Bar -->
        <div class="mt-8 flex flex-col md:flex-row md:items-center justify-between gap-4 font-mono text-xs">
          
          <!-- Category Pills -->
          <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Filter projects by category">
            {categories.map((cat, idx) => (
              <button
                type="button"
                data-archive-filter={cat}
                class={`archive-filter-btn px-3 py-1.5 rounded-xs border transition-all duration-200 cursor-pointer select-none font-bold uppercase ${
                  idx === 0 
                    ? "active bg-white text-black border-white" 
                    : "border-[#262626] text-neutral-400 hover:border-[#ff4500] hover:text-white bg-[#141414]"
                }`}
                role="tab"
                aria-selected={idx === 0 ? "true" : "false"}
              >
                {cat === "ALL" ? `ALL [0${allProjects.length}]` : cat}
              </button>
            ))}
          </div>

          <!-- Instant Search Input -->
          <div class="relative w-full md:w-72 shrink-0">
            <input 
              type="text" 
              id="directory-search-input"
              placeholder="SEARCH SYSTEMS / TECH..." 
              class="w-full bg-[#111111] border border-[#262626] focus:border-[#ff4500] focus:outline-none px-3 py-1.5 pl-8 rounded-xs text-xs text-white placeholder-neutral-600 font-mono transition-colors"
              aria-label="Filter projects by name or technology"
            />
            <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-neutral-600 font-mono text-xs" aria-hidden="true">⌕</span>
          </div>

        </div>
      </section>

      <!-- TABULAR DIRECTORY (DESKTOP) -->
      <section class="mt-8 hidden lg:block" aria-label="Projects Table">
        <div class="w-full border border-[#1f1f1f] bg-[#0d0d0d] overflow-hidden rounded-xs">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-[#1f1f1f] bg-[#121212] font-mono text-[10.5px] uppercase tracking-wider text-neutral-400">
                <th class="py-3 px-4 w-24">TIMELINE</th>
                <th class="py-3 px-4 w-72">SYSTEM / REPOSITORY</th>
                <th class="py-3 px-4 w-48">DOMAIN &amp; ROLE</th>
                <th class="py-3 px-4">CORE STACK</th>
                <th class="py-3 px-4 w-40">STATUS</th>
                <th class="py-3 px-4 w-44 text-right">SPECIFICATION</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#171717] font-mono text-xs" id="directory-table-body">
              {sortedProjects.map((proj) => (
                <tr 
                  class="directory-row group hover:bg-[#141414] transition-colors duration-150"
                  data-category={proj.data.category}
                  data-search-terms={`${proj.data.title} ${proj.data.subtitle} ${proj.data.category} ${proj.data.techStack.join(' ')} ${proj.data.role}`.toLowerCase()}
                >
                  <!-- Timeline -->
                  <td class="py-4 px-4 text-neutral-500 font-medium whitespace-nowrap">
                    {proj.data.timeline}
                  </td>

                  <!-- Title & Subtitle -->
                  <td class="py-4 px-4">
                    <div class="flex items-center gap-2">
                      <a 
                        href={`/projects/${proj.id}`} 
                        class="text-white font-bold text-sm tracking-tight group-hover:text-[#ff4500] transition-colors"
                      >
                        {proj.data.title}
                      </a>
                      {proj.data.featured && (
                        <span class="text-[9px] font-bold px-1.5 py-0.2 bg-[#ff4500]/15 text-[#ff4500] border border-[#ff4500]/30 rounded-xs uppercase">
                          FLAGSHIP
                        </span>
                      )}
                    </div>
                    <p class="text-[11px] text-neutral-400 font-sans mt-0.5 line-clamp-1">
                      {proj.data.subtitle}
                    </p>
                  </td>

                  <!-- Domain & Role -->
                  <td class="py-4 px-4">
                    <span class="text-[10px] text-neutral-400 uppercase block font-semibold">
                      {proj.data.category}
                    </span>
                    <span class="text-neutral-500 text-[10.5px]">
                      {proj.data.role}
                    </span>
                  </td>

                  <!-- Tech Stack -->
                  <td class="py-4 px-4">
                    <div class="flex flex-wrap gap-1">
                      {proj.data.techStack.map((tech) => (
                        <span class="text-[10px] px-1.5 py-0.5 rounded-xs bg-[#171717] text-neutral-300 border border-[#222]">
                          {tech}
                        </span>
                      ))}
                    </div>
                  </td>

                  <!-- Status -->
                  <td class="py-4 px-4 whitespace-nowrap">
                    <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-neutral-300">
                      <span class={`h-1.5 w-1.5 rounded-full ${proj.data.featured ? "bg-[#ff4500] animate-pulse" : "bg-neutral-500"}`}></span>
                      <span>{proj.data.status}</span>
                    </span>
                  </td>

                  <!-- Action Buttons -->
                  <td class="py-4 px-4 text-right whitespace-nowrap">
                    <div class="flex items-center justify-end gap-2 font-mono text-[11px]">
                      <a 
                        href={`/projects/${proj.id}`} 
                        class="group/spec px-2.5 py-1 rounded-xs bg-[#1c1c1c] hover:bg-[#ff4500] text-neutral-200 hover:text-black font-bold border border-[#2a2a2a] hover:border-[#ff4500] transition-all duration-150 inline-flex items-center gap-1 cursor-pointer select-none"
                        title={`View architectural case study for ${proj.data.title}`}
                      >
                        <span>SPEC</span>
                        <span class="text-[#ff4500] group-hover/spec:text-black transition-all duration-150 group-hover/spec:translate-x-0.5 group-hover/spec:-translate-y-0.5">↗</span>
                      </a>
                      <a 
                        href={proj.data.githubUrl} 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        class="group/git px-2 py-1 rounded-xs bg-transparent hover:bg-white text-neutral-400 hover:text-black border border-[#262626] hover:border-white transition-all duration-150 inline-flex items-center gap-1 cursor-pointer select-none"
                        title="View Source on GitHub"
                      >
                        <span>GIT</span>
                        <span class="text-neutral-500 group-hover/git:text-black transition-all duration-150 group-hover/git:translate-x-0.5 group-hover/git:-translate-y-0.5 text-[10px]">↗</span>
                      </a>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- RESPONSIVE CARDS (MOBILE & TABLET) -->
      <section class="mt-8 lg:hidden space-y-4" id="directory-mobile-list" aria-label="Projects Mobile Cards">
        {sortedProjects.map((proj) => (
          <div 
            class="directory-card p-5 bg-[#0e0e0e] border border-[#1f1f1f] rounded-xs space-y-3"
            data-category={proj.data.category}
            data-search-terms={`${proj.data.title} ${proj.data.subtitle} ${proj.data.category} ${proj.data.techStack.join(' ')} ${proj.data.role}`.toLowerCase()}
          >
            <!-- Card Header -->
            <div class="flex items-start justify-between gap-2 border-b border-[#1a1a1a] pb-3">
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-mono text-[10px] text-[#ff4500] font-bold uppercase">
                    {proj.data.category}
                  </span>
                  {proj.data.featured && (
                    <span class="text-[9px] font-bold px-1.5 py-0.2 bg-[#ff4500]/15 text-[#ff4500] border border-[#ff4500]/30 rounded-xs uppercase font-mono">
                      FLAGSHIP
                    </span>
                  )}
                </div>
                <h2 class="text-xl font-bold text-white tracking-tight mt-1">
                  <a href={`/projects/${proj.id}`} class="hover:text-[#ff4500] transition-colors">
                    {proj.data.title}
                  </a>
                </h2>
              </div>
              <span class="font-mono text-[11px] text-neutral-500 whitespace-nowrap">
                {proj.data.timeline}
              </span>
            </div>

            <p class="text-sm text-neutral-400 leading-relaxed font-sans">
              {proj.data.subtitle}
            </p>

            <!-- Tech Stack Tags -->
            <div class="flex flex-wrap gap-1 pt-1 font-mono">
              {proj.data.techStack.map((tech) => (
                <span class="text-[10px] px-2 py-0.5 rounded-xs bg-[#161616] text-neutral-300 border border-[#222]">
                  {tech}
                </span>
              ))}
            </div>

            <!-- Card Footer: Status & Actions -->
            <div class="pt-3 border-t border-[#1a1a1a] flex items-center justify-between gap-2 font-mono text-xs">
              <span class="text-[10px] text-neutral-400 truncate max-w-[150px]">
                {proj.data.status}
              </span>
              <div class="flex items-center gap-2">
                <a 
                  href={`/projects/${proj.id}`} 
                  class="px-3 py-1 rounded-xs bg-[#ff4500] text-black font-bold text-xs hover:bg-white transition-colors"
                >
                  SPEC ↗
                </a>
                <a 
                  href={proj.data.githubUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="px-2.5 py-1 rounded-xs border border-[#333] text-neutral-300 hover:text-white hover:border-white transition-colors text-xs"
                >
                  GIT
                </a>
              </div>
            </div>
          </div>
        ))}
      </section>

      <!-- Empty State -->
      <div id="no-results-state" class="hidden py-16 text-center font-mono">
        <p class="text-neutral-500 text-sm">NO SYSTEMS MATCH THE ACTIVE FILTER CRITERIA.</p>
        <button 
          type="button" 
          id="reset-filter-btn"
          class="mt-3 text-xs text-[#ff4500] underline underline-offset-4 hover:text-white cursor-pointer"
        >
          RESET ALL FILTERS
        </button>
      </div>

    </div>
  </main>

  <!-- Interactive Directory Script (Instant Search & Filter, ESC navigation) -->
  <script>
    function setupDirectoryPage() {
      // 1. ESC Key returns to home
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          window.location.href = "/#projects";
        }
      });

      // 2. Real-time Search & Category Filtering
      const searchInput = document.getElementById("directory-search-input") as HTMLInputElement | null;
      const filterBtns = document.querySelectorAll<HTMLButtonElement>(".archive-filter-btn");
      const rows = document.querySelectorAll<HTMLTableRowElement>(".directory-row");
      const cards = document.querySelectorAll<HTMLElement>(".directory-card");
      const emptyState = document.getElementById("no-results-state");
      const resetBtn = document.getElementById("reset-filter-btn");

      let currentCategory = "ALL";
      let searchQuery = "";

      function applyFilter() {
        let visibleCount = 0;

        function checkMatch(el: HTMLElement) {
          const category = el.getAttribute("data-category") || "";
          const terms = el.getAttribute("data-search-terms") || "";

          const matchesCategory = currentCategory === "ALL" || category === currentCategory;
          const matchesSearch = !searchQuery || terms.includes(searchQuery);

          return matchesCategory && matchesSearch;
        }

        rows.forEach((row) => {
          if (checkMatch(row)) {
            row.style.display = "";
            visibleCount++;
          } else {
            row.style.display = "none";
          }
        });

        cards.forEach((card) => {
          if (checkMatch(card)) {
            card.style.display = "";
          } else {
            card.style.display = "none";
          }
        });

        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? "block" : "none";
        }
      }

      filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          currentCategory = btn.getAttribute("data-archive-filter") || "ALL";

          filterBtns.forEach((b) => {
            b.classList.remove("active", "bg-white", "text-black", "border-white");
            b.classList.add("border-[#262626]", "text-neutral-400", "bg-[#141414]");
            b.setAttribute("aria-selected", "false");
          });

          btn.classList.add("active", "bg-white", "text-black", "border-white");
          btn.classList.remove("border-[#262626]", "text-neutral-400", "bg-[#141414]");
          btn.setAttribute("aria-selected", "true");

          applyFilter();
        });
      });

      if (searchInput) {
        searchInput.addEventListener("input", (e) => {
          searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
          applyFilter();
        });
      }

      if (resetBtn) {
        resetBtn.addEventListener("click", () => {
          currentCategory = "ALL";
          searchQuery = "";
          if (searchInput) searchInput.value = "";
          
          filterBtns.forEach((b, idx) => {
            if (idx === 0) {
              b.classList.add("active", "bg-white", "text-black", "border-white");
              b.classList.remove("border-[#262626]", "text-neutral-400", "bg-[#141414]");
              b.setAttribute("aria-selected", "true");
            } else {
              b.classList.remove("active", "bg-white", "text-black", "border-white");
              b.classList.add("border-[#262626]", "text-neutral-400", "bg-[#141414]");
              b.setAttribute("aria-selected", "false");
            }
          });

          applyFilter();
        });
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupDirectoryPage);
    } else {
      setupDirectoryPage();
    }
    document.addEventListener("astro:page-load", setupDirectoryPage);
  </script>
</Layout>