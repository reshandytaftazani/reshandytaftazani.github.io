    function setupNoteReader() {
      // 1. Reading Progress Bar & TOC Scrollspy
      const progressBar = document.getElementById("reading-progress-bar");
      const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
      const headings = Array.from(document.querySelectorAll<HTMLElement>("article.prose-editorial h2, article.prose-editorial h3"));

      function onScroll() {
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrolled = (window.scrollY / Math.max(1, docHeight)) * 100;
        
        if (progressBar) {
          progressBar.style.width = `${Math.min(100, Math.max(0, scrolled))}%`;
        }

        // Scrollspy for TOC
        const scrollPos = window.scrollY + 120;
        let activeSlug = "";

        for (let i = headings.length - 1; i >= 0; i--) {
          const heading = headings[i];
          if (heading.offsetTop <= scrollPos) {
            activeSlug = heading.id;
            break;
          }
        }

        tocLinks.forEach((link) => {
          const targetSlug = link.getAttribute("data-toc-link");
          if (targetSlug === activeSlug) {
            link.classList.add("text-[#ff4500]", "bg-[#141414]", "font-bold");
            link.classList.remove("text-neutral-400", "text-neutral-500");
          } else {
            link.classList.remove("text-[#ff4500]", "bg-[#141414]", "font-bold");
            if (link.classList.contains("pl-5")) {
              link.classList.add("text-neutral-500");
            } else {
              link.classList.add("text-neutral-400");
            }
          }
        });
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      // 2. Interactive Annotation Drawer Controller
      const drawer = document.getElementById("annotation-drawer");
      const closeBtn = document.getElementById("ann-close-btn");
      const annCategory = document.getElementById("ann-category");
      const annTitle = document.getElementById("ann-title");
      const annFormulaBox = document.getElementById("ann-formula-box");
      const annDesc = document.getElementById("ann-desc");
      const annInvariant = document.getElementById("ann-invariant");

      let isDrawerOpen = false;

      function closeDrawer() {
        if (!drawer) return;
        drawer.classList.add("translate-y-8", "opacity-0", "pointer-events-none");
        drawer.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto");
        isDrawerOpen = false;
      }

      function openDrawer(item: AnnotationItem) {
        if (!drawer) return;
        playClick(1400, 0.015, 0.035);

        if (annCategory) annCategory.textContent = item.category;
        if (annTitle) annTitle.textContent = item.title;
        if (annFormulaBox) annFormulaBox.textContent = item.codeOrFormula;
        if (annDesc) annDesc.textContent = item.desc;
        if (annInvariant) annInvariant.textContent = item.invariant;

        drawer.classList.remove("translate-y-8", "opacity-0", "pointer-events-none");
        drawer.classList.add("translate-y-0", "opacity-100", "pointer-events-auto");
        isDrawerOpen = true;
      }

      closeBtn?.addEventListener("click", () => {
        closeDrawer();
      });

      // Dismiss on click outside
      document.addEventListener("click", (e) => {
        if (!isDrawerOpen || !drawer) return;
        const target = e.target as HTMLElement;
        if (
          !drawer.contains(target) &&
          !target.closest(".math-annotation-btn") &&
          !target.closest(".code-annotation-line")
        ) {
          closeDrawer();
        }
      });

      // 3. ESC Key Navigation (Closes Drawer if open, else navigates back to /notes)
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          if (isDrawerOpen) {
            closeDrawer();
            e.stopPropagation();
            e.preventDefault();
            return;
          }

          if ((window as any).navigateWithCurtain) {
            (window as any).navigateWithCurtain("/notes");
          } else {
            window.location.href = "/notes";
          }
        }
      });

      // 4. Back to top button in TOC
      const backToTopBtn = document.getElementById("back-to-top-note");
      if (backToTopBtn) {
        backToTopBtn.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      }

      // 5. Share button (Copies URL with visual feedback)
      const shareBtn = document.getElementById("share-note-btn");
      const shareText = document.getElementById("share-btn-text");
      if (shareBtn && shareText) {
        shareBtn.addEventListener("click", () => {
          navigator.clipboard.writeText(window.location.href).then(() => {
            shareText.textContent = "COPIED ✓";
            shareBtn.classList.add("bg-[#ff4500]", "text-black");
            setTimeout(() => {
              shareText.textContent = "SHARE";
              shareBtn.classList.remove("bg-[#ff4500]", "text-black");
            }, 2000);
          });
        });
      }

      // 6. Article Scanner: Enhance Math Symbols & Code Lines
      const article = document.querySelector<HTMLElement>("article.prose-editorial");
      if (!article) return;

      // Enhance Math Symbols in Paragraphs and Headings
      const mathReplacements: Array<{ pattern: RegExp; id: string; symbol: string; label: string; fullTitle: string }> = [
        { pattern: /\$?\\tau\$?/g, id: "param-tau", symbol: "τ", label: "horizon", fullTitle: "Prediction Horizon (τ)" },
        { pattern: /\$h\$/g, id: "param-h", symbol: "h", label: "embargo", fullTitle: "Embargo Buffer Duration (h)" },
        { pattern: /\$t_\{i,0\}\$/g, id: "param-t0", symbol: "t_{i,0}", label: "as-of time", fullTitle: "Feature Watermark (t_{i,0})" },
        { pattern: /\$t_\{i,1\}\$/g, id: "param-t1", symbol: "t_{i,1}", label: "resolution", fullTitle: "Label Resolution (t_{i,1})" },
        { pattern: /\$y_i\$/g, id: "param-yi", symbol: "y_i", label: "target return", fullTitle: "Target Return (y_i)" },
        { pattern: /\$T_\\text\{drain\}\$/g, id: "param-tdrain", symbol: "T_drain", label: "max drain", fullTitle: "Max Drain Window (T_drain)" },
        { pattern: /\$\\epsilon\$/g, id: "param-epsilon", symbol: "ε", label: "safety margin", fullTitle: "Container Safety Margin (ε)" },
        { pattern: /\$\\Delta t_\\text\{ingress\\_sync\}\$/g, id: "param-ingress-sync", symbol: "Δt_ingress", label: "route sync", fullTitle: "Route Deprecation Window (Δt_ingress)" },
      ];

      const textContainers = article.querySelectorAll<HTMLElement>("p, li, blockquote");
      textContainers.forEach((container) => {
        let html = container.innerHTML;
        let modified = false;

        for (const { pattern, id, symbol, label, fullTitle } of mathReplacements) {
          if (pattern.test(html)) {
            html = html.replace(pattern, () => {
              modified = true;
              return `<button type="button" class="math-annotation-btn font-mono" data-ann-id="${id}" title="Click to inspect: ${fullTitle} — Invariant & Math Definition"><span class="sym-symbol font-bold text-[#ff4500]">${symbol}</span><span class="sym-sep text-neutral-500 font-normal">·</span><span class="sym-label text-neutral-300 text-[10px] uppercase font-semibold tracking-wider">${label}</span><span class="ann-icon text-[9px] text-[#ff4500] font-bold">ⓘ</span></button>`;
            });
          }
        }

        if (modified) {
          container.innerHTML = html;
        }
      });

      // Enhance Code Blocks with Line-Level Justification Callouts
      const codeBlocks = article.querySelectorAll<HTMLElement>("pre code");
      codeBlocks.forEach((codeEl) => {
        const rawHtml = codeEl.innerHTML;
        const lines = rawHtml.split("\n");
        let modified = false;

        const enhancedLines = lines.map((line) => {
          if (line.includes("assert len(np.intersect1d")) {
            modified = true;
            return `<div class="code-annotation-line" data-ann-id="code-assert-intersect"><span class="code-line-content">${line}</span><span class="ann-badge">WHY? ⓘ</span></div>`;
          }
          if (line.includes("t_purge_cutoff = ")) {
            modified = true;
            return `<div class="code-annotation-line" data-ann-id="code-purge-cutoff"><span class="code-line-content">${line}</span><span class="ann-badge">WHY? ⓘ</span></div>`;
          }
          if (line.includes("t_embargo_cutoff = ")) {
            modified = true;
            return `<div class="code-annotation-line" data-ann-id="code-embargo-cutoff"><span class="code-line-content">${line}</span><span class="ann-badge">WHY? ⓘ</span></div>`;
          }
          if (line.includes("loop.add_signal_handler") || line.includes("signal.signal(signal.SIGTERM")) {
            modified = true;
            return `<div class="code-annotation-line" data-ann-id="code-signal-handler"><span class="code-line-content">${line}</span><span class="ann-badge">WHY? ⓘ</span></div>`;
          }
          if (line.includes("torch.cuda.synchronize()")) {
            modified = true;
            return `<div class="code-annotation-line" data-ann-id="code-cuda-sync"><span class="code-line-content">${line}</span><span class="ann-badge">WHY? ⓘ</span></div>`;
          }
          if (line.includes("sys.exit(0)")) {
            modified = true;
            return `<div class="code-annotation-line" data-ann-id="code-sys-exit"><span class="code-line-content">${line}</span><span class="ann-badge">WHY? ⓘ</span></div>`;
          }
          if (line.includes("class IFeatureStorageAdapter(Protocol)")) {
            modified = true;
            return `<div class="code-annotation-line" data-ann-id="code-protocol"><span class="code-line-content">${line}</span><span class="ann-badge">WHY? ⓘ</span></div>`;
          }
          if (line.includes("@dataclass(frozen=True)")) {
            modified = true;
            return `<div class="code-annotation-line" data-ann-id="code-frozen-dataclass"><span class="code-line-content">${line}</span><span class="ann-badge">WHY? ⓘ</span></div>`;
          }
          return line;
        });

        if (modified) {
          codeEl.innerHTML = enhancedLines.join("\n");
        }
      });

      // Bind Click Events to Math Annotation Buttons
      article.querySelectorAll<HTMLButtonElement>(".math-annotation-btn").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const annId = btn.getAttribute("data-ann-id");
          if (annId && ANNOTATIONS[annId]) {
            openDrawer(ANNOTATIONS[annId]);
          }
        });
      });

      // Bind Click Events to Code Annotation Lines
      article.querySelectorAll<HTMLElement>(".code-annotation-line").forEach((lineEl) => {
        lineEl.addEventListener("click", (e) => {
          e.stopPropagation();
          const annId = lineEl.getAttribute("data-ann-id");
          if (annId && ANNOTATIONS[annId]) {
            openDrawer(ANNOTATIONS[annId]);
          }
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupNoteReader);
    } else {
      setupNoteReader();
    }
    document.addEventListener("astro:page-load", setupNoteReader);
  </script>

