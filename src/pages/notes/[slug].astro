---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import TemporalSplitterSimulator from '../../components/TemporalSplitterSimulator.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  
  // Sort chronologically (newest first)
  const sortedNotes = [...notes].sort((a, b) => {
    return new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime();
  });

  return sortedNotes.map((note, index) => {
    // prevNote = older dispatch; nextNote = newer dispatch
    const prevNote = index < sortedNotes.length - 1 ? sortedNotes[index + 1] : null;
    const nextNote = index > 0 ? sortedNotes[index - 1] : null;
    
    return {
      params: { slug: note.id },
      props: { 
        note, 
        prevNote, 
        nextNote,
        dispatchNumber: String(sortedNotes.length - index).padStart(2, '0'),
      },
    };
  });
}

const { note, prevNote, nextNote, dispatchNumber } = Astro.props;
const { Content, headings } = await render(note);

// Filter table of contents for h2 and h3
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Dynamic reading time calculation
function calculateReadingTime(body?: string, fallback: string = '6 MIN READ'): string {
  if (!body) return fallback;
  const wordCount = body.trim().split(/\s+/).length;
  const minutes = Math.max(1, Math.ceil(wordCount / 200));
  return `${minutes} MIN READ`;
}

const readingTime = calculateReadingTime(note.body, note.data.readingTime);
---

<Layout 
  title={`${note.data.title} — Technical Field Note | Reshandy Taftazani`}
  description={note.data.abstract}
>
  <!-- Thin Swiss Reading Progress Bar -->
  <div 
    id="reading-progress-bar" 
    class="fixed top-0 left-0 h-[2px] bg-[#ff4500] z-50 transition-all duration-75 w-0 origin-left"
    aria-hidden="true"
  ></div>

  <main class="min-h-screen bg-[#0a0a0a] text-neutral-200 selection:bg-[#ff4500] selection:text-white font-sans relative">
    
    <!-- Topbar Navigation -->
    <header class="sticky top-0 z-40 w-full border-b border-[#1f1f1f] bg-[#0a0a0a]/90 backdrop-blur-md">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
        
        <!-- Left: Back Navigation -->
        <div class="flex items-center gap-3 font-mono text-xs font-semibold">
          <a 
            href="/notes" 
            id="back-notes-link"
            class="group inline-flex items-center gap-1.5 text-neutral-400 hover:text-white transition-colors"
            title="Return to Technical Field Notes (or press ESC)"
          >
            <span class="text-[#ff4500] group-hover:-translate-x-1 transition-transform duration-200">←</span>
            <span>NOTES</span>
            <span class="hidden sm:inline-block text-[10px] text-neutral-600 group-hover:text-neutral-400 font-mono border border-[#262626] px-1 py-0.2 rounded-xs">ESC</span>
          </a>
          <span class="text-neutral-700">/</span>
          <span class="text-neutral-400 font-mono text-[11px] truncate max-w-[140px] sm:max-w-[220px]">
            {note.data.title}
          </span>
        </div>

        <!-- Center: Telemetry Breadcrumb -->
        <div class="hidden md:flex items-center gap-2 font-mono text-[11px] text-neutral-500 uppercase tracking-wider select-none">
          <span>DISPATCH</span>
          <span class="text-[#333]">#{dispatchNumber}</span>
          <span class="text-[#333]">//</span>
          <span class="text-[#ff4500] font-semibold">{note.data.category}</span>
        </div>

        <!-- Right: Actions & Share -->
        <div class="flex items-center gap-2.5 font-mono text-xs">
          {note.id === 'eliminating-lookahead-bias' && (
            <a 
              href="#interactive-simulator" 
              class="group inline-flex items-center gap-1 px-2.5 py-1 rounded-xs border border-[#ff4500]/50 hover:border-[#ff4500] bg-[#ff4500]/15 hover:bg-[#ff4500] text-[#ff4500] hover:text-black font-bold transition-all duration-200"
              title="Jump to Live In-Browser Simulator"
            >
              <span class="text-[9px]">►</span>
              <span>SIMULATE</span>
            </a>
          )}

          <div class="hidden sm:flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-[#141414] border border-[#222]">
            <span class="h-1.5 w-1.5 rounded-full bg-[#ff4500] animate-pulse"></span>
            <span class="text-[10px] text-neutral-400 font-semibold">{readingTime}</span>
          </div>

          <button 
            type="button" 
            id="share-note-btn"
            class="group inline-flex items-center gap-1 px-2.5 py-1 rounded-xs border border-[#333] hover:border-[#ff4500] bg-[#141414] hover:bg-[#ff4500] text-neutral-300 hover:text-black font-bold transition-all duration-200 cursor-pointer select-none"
            title="Copy URL to Clipboard"
          >
            <svg class="w-3 h-3 text-[#ff4500] group-hover:text-black transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
            <span id="share-btn-text">SHARE</span>
          </button>

          <a 
            href="/rss.xml" 
            target="_blank"
            class="hidden md:inline-flex items-center gap-1 px-2 py-1 rounded-xs border border-[#262626] text-neutral-400 hover:text-white hover:border-white transition-colors"
            title="RSS Feed"
          >
            <span>RSS</span>
            <span class="text-[10px]">↗</span>
          </a>
        </div>

      </div>
    </header>

    <!-- Main Container -->
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
      
      <!-- HERO EDITORIAL HEADER -->
      <section class="border-b border-[#1f1f1f] pb-12 sm:pb-16">
        
        <!-- Meta Telemetry Badges -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 font-mono text-xs mb-6">
          <span class="px-2.5 py-1 rounded-xs bg-[#ff4500]/15 text-[#ff4500] font-bold uppercase tracking-wider border border-[#ff4500]/30">
            {note.data.category}
          </span>
          <span class="px-2.5 py-1 rounded-xs bg-[#171717] text-neutral-400 border border-[#262626]">
            DISPATCH #{dispatchNumber}
          </span>
          <span class="px-2.5 py-1 rounded-xs bg-[#171717] text-neutral-400 border border-[#262626]">
            DATE: {note.data.publishedAt}
          </span>
          <span class="px-2.5 py-1 rounded-xs bg-[#171717] text-neutral-400 border border-[#262626]">
            EST. {readingTime}
          </span>
        </div>

        <!-- Big Display Title -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.1]">
          {note.data.title}<span class="text-[#ff4500]">.</span>
        </h1>
        
        <!-- Subtitle -->
        <p class="mt-4 text-lg sm:text-2xl text-neutral-300 font-normal max-w-4xl leading-relaxed">
          {note.data.subtitle}
        </p>

        <!-- Abstract Callout Box -->
        <div class="mt-8 p-5 sm:p-6 rounded-xs bg-[#0f0f0f] border-l-2 border-[#ff4500] border-y border-r border-[#1f1f1f]">
          <div class="flex items-center gap-2 font-mono text-[11px] text-[#ff4500] uppercase tracking-wider font-bold mb-2">
            <span>●</span>
            <span>EXECUTIVE ABSTRACT &amp; PROBLEM CONTEXT</span>
          </div>
          <p class="text-sm sm:text-base text-neutral-300 leading-relaxed font-sans">
            {note.data.abstract}
          </p>
        </div>

        <!-- Architectural Invariants Bar -->
        {note.data.invariants && note.data.invariants.length > 0 && (
          <div class="mt-6 pt-6 border-t border-[#1a1a1a]">
            <div class="flex items-center gap-2 font-mono text-[11px] text-neutral-500 uppercase tracking-wider mb-3">
              <span class="text-[#ff4500] font-bold">✓</span>
              <span>VERIFIED ARCHITECTURAL INVARIANTS:</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-2.5">
              {note.data.invariants.map((inv, idx) => (
                <div class="flex items-start gap-2 p-3 rounded-xs bg-[#121212] border border-[#222]">
                  <span class="text-[#ff4500] font-mono font-bold text-xs shrink-0">
                    [0{idx + 1}]
                  </span>
                  <span class="font-mono text-xs text-neutral-300 leading-snug">
                    {inv}
                  </span>
                </div>
              ))}
            </div>
          </div>
        )}

      </section>

      <!-- TWO-COLUMN LAYOUT: STICKY TOC + ARTICLE BODY -->
      <div class="mt-12 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- SIDEBAR: TABLE OF CONTENTS (Desktop Sticky) -->
        <aside class="hidden lg:block lg:col-span-3 sticky top-20 self-start">
          <div class="p-5 rounded-xs bg-[#0d0d0d] border border-[#1f1f1f] font-mono text-xs space-y-4">
            
            <div class="flex items-center justify-between border-b border-[#1a1a1a] pb-3">
              <span class="text-[#ff4500] font-bold tracking-wider text-[11px] uppercase">
                TABLE OF CONTENTS
              </span>
              <span class="text-[10px] text-neutral-500 tabular-nums">
                {tocHeadings.length} SECTIONS
              </span>
            </div>

            <nav aria-label="Article Table of Contents" class="space-y-1 max-h-[calc(100vh-16rem)] overflow-y-auto pr-1">
              {tocHeadings.map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  data-toc-link={heading.slug}
                  class={`toc-link block py-1.5 px-2 rounded-xs transition-colors duration-150 text-neutral-400 hover:text-white hover:bg-[#161616] ${
                    heading.depth === 3 ? "pl-5 text-[11px] text-neutral-500" : "font-semibold text-xs"
                  }`}
                >
                  <span class="truncate block">
                    {heading.text}
                  </span>
                </a>
              ))}
              {note.id === 'eliminating-lookahead-bias' && (
                <a
                  href="#interactive-simulator"
                  data-toc-link="interactive-simulator"
                  class="toc-link block py-1.5 px-2 rounded-xs transition-colors duration-150 text-[#ff4500] hover:bg-[#161616] font-bold text-xs"
                >
                  <span class="flex items-center gap-1.5 truncate">
                    <span class="text-[9px] text-[#ff4500]">►</span>
                    <span>LIVE SIMULATOR</span>
                  </span>
                </a>
              )}
            </nav>

            <div class="pt-3 border-t border-[#1a1a1a] flex items-center justify-between text-[10px] text-neutral-500">
              <button 
                type="button" 
                id="back-to-top-note"
                class="hover:text-[#ff4500] transition-colors cursor-pointer select-none flex items-center gap-1"
              >
                <span>↑</span>
                <span>BACK TO TOP</span>
              </button>
              <a href="/notes" class="hover:text-white transition-colors">
                <span>ALL NOTES →</span>
              </a>
            </div>

          </div>
        </aside>

        <!-- MAIN ARTICLE BODY (Editorial Prose) -->
        <div class="lg:col-span-9">
          
          <!-- Mobile TOC Collapsible Dropdown -->
          <div class="lg:hidden mb-8 p-4 rounded-xs bg-[#0e0e0e] border border-[#1f1f1f]">
            <details class="group">
              <summary class="flex items-center justify-between cursor-pointer list-none font-mono text-xs text-neutral-300 font-bold select-none">
                <span class="flex items-center gap-2">
                  <span class="text-[#ff4500]">≡</span>
                  <span>TABLE OF CONTENTS ({tocHeadings.length} SECTIONS)</span>
                </span>
                <span class="text-neutral-500 group-open:rotate-180 transition-transform duration-200">▼</span>
              </summary>
              <nav class="mt-4 pt-3 border-t border-[#1a1a1a] space-y-1.5 font-mono text-xs">
                {tocHeadings.map((heading) => (
                  <a
                    href={`#${heading.slug}`}
                    class={`block py-1 text-neutral-400 hover:text-[#ff4500] transition-colors ${
                      heading.depth === 3 ? "pl-4 text-[11px]" : "font-semibold"
                    }`}
                  >
                    {heading.text}
                  </a>
                ))}
              </nav>
            </details>
          </div>

          <!-- Editorial Markdown Prose -->
          <article class="prose-editorial max-w-none">
            <Content />
          </article>

          <!-- EMBEDDED INTERACTIVE LAB SIMULATOR -->
          {note.id === 'eliminating-lookahead-bias' && (
            <section id="interactive-simulator" class="mt-16 pt-10 border-t border-[#1f1f1f] scroll-mt-20">
              <div class="flex items-center gap-2 font-mono text-xs text-[#ff4500] tracking-widest uppercase mb-4">
                <span class="w-1.5 h-1.5 rounded-full bg-[#ff4500] animate-pulse"></span>
                <span>INTERACTIVE LAB // TEMPORAL PARTITION SIMULATOR</span>
              </div>
              <TemporalSplitterSimulator />
            </section>
          )}

          <!-- POST-ARTICLE: AUTHOR ATTRIBUTION CARD -->
          <div class="mt-16 p-6 sm:p-8 rounded-xs bg-[#0d0d0d] border border-[#1f1f1f] font-mono text-xs">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-[#1a1a1a] pb-6">
              <div>
                <span class="text-[10px] text-[#ff4500] uppercase font-bold tracking-wider block mb-1">
                  AUTHOR &amp; RESEARCH INQUIRIES
                </span>
                <h3 class="text-lg font-bold text-white tracking-tight">
                  Reshandy Taftazani Aulya
                </h3>
                <p class="text-xs text-neutral-400 font-sans mt-0.5">
                  Computer Science @ Universitas Indonesia • Machine Learning Engineering &amp; Software Systems
                </p>
              </div>

              <div class="flex items-center gap-2">
                <a 
                  href="/resume" 
                  class="px-3 py-1.5 rounded-xs bg-[#161616] border border-[#2a2a2a] hover:border-[#ff4500] text-neutral-300 hover:text-white transition-colors"
                >
                  CV ↗
                </a>
                <a 
                  href="https://github.com/reshandytaftazani" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="px-3 py-1.5 rounded-xs bg-[#161616] border border-[#2a2a2a] hover:border-[#ff4500] text-neutral-300 hover:text-white transition-colors"
                >
                  GITHUB ↗
                </a>
              </div>
            </div>

            <div class="pt-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-[11px] text-neutral-500">
              <span>CITATION: Taftazani, R. (2026). "{note.data.title}". Technical Field Notes.</span>
              <a href="/rss.xml" class="text-neutral-400 hover:text-[#ff4500] transition-colors flex items-center gap-1">
                <svg class="w-3 h-3 text-[#ff4500]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
                <span>SUBSCRIBE VIA RSS</span>
              </a>
            </div>
          </div>

          <!-- INTER-NOTE PAGINATION FOOTER -->
          <nav class="mt-10 border-t border-[#1f1f1f] pt-10 pb-16 grid grid-cols-1 sm:grid-cols-12 gap-4 items-stretch" aria-label="Notes pagination">
            
            <!-- Previous Note (Older Dispatch) -->
            {prevNote ? (
              <a 
                href={`/notes/${prevNote.id}`}
                class="group sm:col-span-5 flex flex-col items-start justify-between gap-3 p-5 rounded-xs border border-[#1f1f1f] hover:border-[#ff4500]/50 bg-[#0e0e0e] transition-all duration-200"
              >
                <span class="font-mono text-[11px] text-neutral-500 uppercase tracking-wider group-hover:text-[#ff4500] transition-colors flex items-center gap-1.5">
                  <span class="group-hover:-translate-x-1 transition-transform duration-200">←</span>
                  <span>PREVIOUS DISPATCH</span>
                </span>
                <div>
                  <div class="text-base font-bold text-white group-hover:text-[#ff4500] transition-colors line-clamp-1">
                    {prevNote.data.title}
                  </div>
                  <span class="text-xs text-neutral-400 font-mono">
                    [{prevNote.data.category}] • {prevNote.data.publishedAt}
                  </span>
                </div>
              </a>
            ) : (
              <div class="hidden sm:block sm:col-span-5"></div>
            )}

            <!-- Center: All Field Notes Hub -->
            <a 
              href="/notes" 
              class="group sm:col-span-2 flex flex-col items-center justify-center gap-1.5 p-4 rounded-xs border border-[#222] hover:border-[#ff4500] bg-[#0d0d0d] hover:bg-[#141414] transition-all duration-200 text-center select-none cursor-pointer"
              title="Browse all technical field notes"
            >
              <span class="text-[#ff4500] group-hover:scale-110 transition-transform duration-200 text-lg">⊞</span>
              <span class="font-mono text-[10px] text-neutral-300 uppercase tracking-wider group-hover:text-white transition-colors font-bold">
                ALL NOTES
              </span>
              <span class="font-mono text-[9px] text-neutral-500 group-hover:text-[#ff4500] transition-colors">
                ARCHIVE →
              </span>
            </a>

            <!-- Next Note (Newer Dispatch) -->
            {nextNote ? (
              <a 
                href={`/notes/${nextNote.id}`}
                class="group sm:col-span-5 flex flex-col items-end justify-between gap-3 p-5 rounded-xs border border-[#1f1f1f] hover:border-[#ff4500]/50 bg-[#0e0e0e] transition-all duration-200 text-right"
              >
                <span class="font-mono text-[11px] text-neutral-500 uppercase tracking-wider group-hover:text-[#ff4500] transition-colors flex items-center gap-1.5">
                  <span>NEXT DISPATCH</span>
                  <span class="group-hover:translate-x-1 transition-transform duration-200">→</span>
                </span>
                <div>
                  <div class="text-base font-bold text-white group-hover:text-[#ff4500] transition-colors line-clamp-1">
                    {nextNote.data.title}
                  </div>
                  <span class="text-xs text-neutral-400 font-mono">
                    [{nextNote.data.category}] • {nextNote.data.publishedAt}
                  </span>
                </div>
              </a>
            ) : (
              <div class="hidden sm:block sm:col-span-5"></div>
            )}

          </nav>

        </div>

      </div>

    </div>
  </main>

  <!-- Interactive Scripts: Reading Progress Bar, Scrollspy, ESC navigation, Share Button -->
  <script>
    function setupNoteReader() {
      // 1. Reading Progress Bar & TOC Scrollspy
      const progressBar = document.getElementById("reading-progress-bar");
      const tocLinks = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
      const headings = Array.from(document.querySelectorAll<HTMLElement>("article.prose-editorial h2, article.prose-editorial h3"));

      function onScroll() {
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const scrolled = (window.scrollY / Math.max(1, docHeight)) * 100;
        
        if (progressBar) {
          progressBar.style.width = `${Math.min(100, Math.max(0, scrolled))}%`;
        }

        // Scrollspy for TOC
        const scrollPos = window.scrollY + 120;
        let activeSlug = "";

        for (let i = headings.length - 1; i >= 0; i--) {
          const heading = headings[i];
          if (heading.offsetTop <= scrollPos) {
            activeSlug = heading.id;
            break;
          }
        }

        tocLinks.forEach((link) => {
          const targetSlug = link.getAttribute("data-toc-link");
          if (targetSlug === activeSlug) {
            link.classList.add("text-[#ff4500]", "bg-[#141414]", "font-bold");
            link.classList.remove("text-neutral-400", "text-neutral-500");
          } else {
            link.classList.remove("text-[#ff4500]", "bg-[#141414]", "font-bold");
            if (link.classList.contains("pl-5")) {
              link.classList.add("text-neutral-500");
            } else {
              link.classList.add("text-neutral-400");
            }
          }
        });
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      // 2. ESC Key navigation back to /notes
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          window.location.href = "/notes";
        }
      });

      // 3. Back to top button in TOC
      const backToTopBtn = document.getElementById("back-to-top-note");
      if (backToTopBtn) {
        backToTopBtn.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });
      }

      // 4. Share button (Copies URL with visual feedback)
      const shareBtn = document.getElementById("share-note-btn");
      const shareText = document.getElementById("share-btn-text");
      if (shareBtn && shareText) {
        shareBtn.addEventListener("click", () => {
          navigator.clipboard.writeText(window.location.href).then(() => {
            shareText.textContent = "COPIED ✓";
            shareBtn.classList.add("bg-[#ff4500]", "text-black");
            setTimeout(() => {
              shareText.textContent = "SHARE";
              shareBtn.classList.remove("bg-[#ff4500]", "text-black");
            }, 2000);
          });
        });
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupNoteReader);
    } else {
      setupNoteReader();
    }
    document.addEventListener("astro:page-load", setupNoteReader);
  </script>

  <style is:global>
    /* Swiss Editorial Typography for Article Prose */
    .prose-editorial {
      color: #d4d4d4;
      font-size: 1.0625rem;
      line-height: 1.75;
      font-family: 'Hanken Grotesk', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .prose-editorial h2 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 1.875rem;
      font-weight: 800;
      color: #ffffff;
      margin-top: 3.5rem;
      margin-bottom: 1.25rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid #1f1f1f;
      letter-spacing: -0.025em;
      scroll-margin-top: 5rem;
    }

    .prose-editorial h3 {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: 1.35rem;
      font-weight: 700;
      color: #ffffff;
      margin-top: 2.25rem;
      margin-bottom: 0.875rem;
      letter-spacing: -0.015em;
      scroll-margin-top: 5rem;
    }

    .prose-editorial p {
      margin-bottom: 1.5rem;
      color: #b8b8b8;
    }

    .prose-editorial strong {
      color: #ffffff;
      font-weight: 600;
    }

    .prose-editorial hr {
      border: 0;
      border-top: 1px solid #222222;
      margin-top: 3rem;
      margin-bottom: 3rem;
    }

    .prose-editorial ul, .prose-editorial ol {
      margin-top: 1rem;
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
      color: #b8b8b8;
    }

    .prose-editorial ul {
      list-style-type: square;
    }

    .prose-editorial ol {
      list-style-type: decimal;
    }

    .prose-editorial li {
      margin-bottom: 0.5rem;
      line-height: 1.65;
    }

    .prose-editorial li::marker {
      color: #ff4500;
    }

    .prose-editorial blockquote {
      border-left: 3px solid #ff4500;
