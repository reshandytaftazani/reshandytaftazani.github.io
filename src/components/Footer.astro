---
// Footer.astro (Daniele Buser exact minimalist Swiss footer format with tactile [TOP ↑] micro-interaction)
const currentYear = 2026;
---

<footer class="relative z-10 w-full py-12 border-t border-grid-line-dark flex flex-col sm:flex-row items-center justify-between gap-6 text-caption text-neutral-dark font-mono bg-background">
  
  <!-- Left: Copyright & Identity -->
  <div class="flex items-center gap-3">
    <span class="text-foreground font-bold tracking-tight hover:text-accent transition-colors duration-200">RESHANDY TAFTAZANI</span>
    <span class="text-neutral-dark">•</span>
    <span>© {currentYear} ALL RIGHTS RESERVED</span>
  </div>

  <!-- Right: Swiss Coordinates, Field Notes, RSS & Tactile [TOP ↑] Control -->
  <div class="flex items-center gap-3 sm:gap-4 font-mono">
    <span class="hidden md:inline text-neutral-dark hover:text-neutral transition-colors">LAT -06.3627° | LON 106.8271°</span>
    <span class="hidden md:inline text-neutral-dark">•</span>
    <a href="/notes" class="text-neutral-dark hover:text-foreground transition-colors font-semibold" title="Technical Field Notes">NOTES</a>
    <span class="text-neutral-dark">•</span>
    <a href="/rss.xml" target="_blank" class="text-neutral-dark hover:text-accent transition-colors flex items-center gap-0.5" title="RSS Syndication Feed">
      <span>RSS</span>
      <span class="text-[10px]">↗</span>
    </a>
    <span class="text-neutral-dark">•</span>
    
    <!-- Tactile Swiss Top Button with Expanding Brackets & Rocket Leap -->
    <a 
      href="#about" 
      id="back-to-top"
      class="group relative inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-sm border border-neutral-dark/40 hover:border-accent bg-card-dark hover:bg-accent text-neutral hover:text-black font-mono font-bold text-caption transition-all duration-300 shadow-sm cursor-pointer select-none"
      aria-label="Return to top of page"
    >
      <span class="text-neutral-dark group-hover:text-black transition-transform duration-200 group-hover:-translate-x-0.5">[</span>
      <span class="text-foreground group-hover:text-black tracking-wider transition-colors duration-200">TOP</span>
      <span class="inline-block text-accent group-hover:text-black font-bold text-sm transition-transform duration-300 ease-out group-hover:-translate-y-1.5 group-hover:scale-125">↑</span>
      <span class="text-neutral-dark group-hover:text-black transition-transform duration-200 group-hover:translate-x-0.5">]</span>
    </a>
  </div>

</footer>

<script>
  function setupBackToTop() {
    const btn = document.getElementById("back-to-top");
    if (!btn) return;

    btn.addEventListener("click", (e) => {
      e.preventDefault();
      window.scrollTo({
        top: 0,
        behavior: "smooth",
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupBackToTop);
  } else {
    setupBackToTop();
  }
  document.addEventListener("astro:page-load", setupBackToTop);
</script>
