---
// Footer.astro
const currentYear = 2026;
---

<footer class="border-t border-slate-800 bg-[#070A10] text-slate-500 py-10 font-mono text-xs mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      
      <!-- Brand & Copyright -->
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-center sm:text-left">
        <span class="text-slate-300 font-semibold">&gt; reshandy.dev</span>
        <span class="hidden sm:inline text-slate-800">|</span>
        <span>© {currentYear} Reshandy Taftazani Aulya. All rights reserved.</span>
      </div>

      <!-- Coordinates & Top Link -->
      <div class="flex items-center gap-4 text-slate-400">
        <span class="text-[11px] text-slate-500 font-mono hidden md:inline">
          LAT -06.3627° | LON 106.8271°
        </span>
        <span class="hidden md:inline text-slate-800">|</span>
        <span class="text-[11px] text-slate-500">
          Astro + Tailwind · GitHub Pages
        </span>
        <a
          href="#"
          class="hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded px-1.5 py-0.5 bg-slate-900 border border-slate-800"
          aria-label="Return to top of page"
        >
          [Top ↑]
        </a>
      </div>

    </div>
  </div>
</footer>
