---
// Principles.astro (Sticky Stage Scrollytelling & Interactive Invariant Sandbox)
// High-craft Swiss Brutalist implementation: Single focused principle at a time,
// desktop scroll-driven sticky transition + direct interactive step navigation,
// calibrated vertical proportion to fit 100% within the viewport without clipping.

const principlesData = [
  {
    step: "01",
    tag: "TEMPORAL_INTEGRITY",
    title: "Zero Data Leakage by Design",
    description:
      "Cross-validation leakage and lookahead bias produce deceptively high metrics that collapse in production. We enforce explicit temporal partition boundaries before executing any feature transformations.",
    bullets: [
      "Point-in-time joins preventing target signal contamination in time-series data.",
      "Deterministic hashing strategies for reproducible train-validation splits.",
      "Automated boundary assertions that fail immediately upon partition violations.",
    ],
    noteUrl: "/notes/eliminating-lookahead-bias",
    noteLabel: "NOTE #02: ELIMINATING LOOKAHEAD BIAS",
    projectUrl: "/projects/leakguard-ml",
    projectLabel: "LEAKGUARD-ML ↗",
  },
  {
    step: "02",
    tag: "DEFENSIVE_CHAOS",
    title: "Defensive Verification & Chaos",
    description:
      "Testing should go beyond typical happy paths. We verify system resilience under unexpected OS process signals, interrupted workloads, and edge-case inputs through property-based tests.",
    bullets: [
      "Property-based testing against degenerate tensors and irregular distributions.",
      "Clean process supervision with signal traps on SIGINT and SIGTERM.",
      "Defensive assertions against unexpected input shapes and null embeddings.",
    ],
    noteUrl: "/notes/posix-signals-async-python",
    noteLabel: "NOTE #01: POSIX SIGNAL TRAPS",
    projectUrl: "/projects/modelarena",
    projectLabel: "MODELARENA ↗",
  },
  {
    step: "03",
    tag: "DOMAIN_ISOLATION",
    title: "Clean Architecture & Contracts",
    description:
      "By decoupling core machine learning algorithms from web frameworks and cloud SDKs, the codebase remains modular, easily testable locally, and resilient to third-party breaking changes.",
    bullets: [
      "Strict data validation contracts enforced via Pydantic at API boundaries.",
      "Hexagonal architecture separating inference routines from network adapters.",
      "Dependency inversion enabling fast, reproducible local test suites.",
    ],
    noteUrl: "/notes/hexagonal-architecture-feature-stores",
    noteLabel: "NOTE #03: HEXAGONAL ML STORES",
    projectUrl: "/projects/savebite",
    projectLabel: "SAVEBITE ↗",
  },
];
---

<!-- SCROLL TRACK WRAPPER (Desktop: 240vh for scroll progression; Mobile: auto) -->
<section 
  id="principles" 
  class="relative z-10 w-full min-h-auto lg:min-h-[240vh] pt-12 pb-16" 
  aria-labelledby="principles-heading"
>
  
  <!-- PINNED STAGE CONTAINER (Sticky on Desktop, Natural Flow on Mobile) -->
  <div class="lg:sticky lg:top-20 w-full flex flex-col justify-start">
    
    <!-- Section Header (Daniele Buser Swiss High-Density Header) -->
    <div class="reveal-init flex flex-col sm:flex-row sm:items-center justify-between border-b border-grid-line-light pb-2.5 gap-2">
      <div class="flex items-center gap-3">
        <h2 class="text-caption md:text-body uppercase text-neutral-dark font-mono tracking-wider" id="principles-heading">
          ENGINEERING PRINCIPLES
        </h2>
        <span class="text-caption font-mono text-neutral-dark font-semibold">
          [03 INVARIANTS // FOCUSED STAGE]
        </span>
      </div>

      <div class="flex items-center gap-4">
        <span class="hidden sm:inline-block font-mono text-[11px] text-neutral-dark">
          STAGE_TELEMETRY: <span id="principles-active-tag" class="text-accent font-semibold">TEMPORAL_INTEGRITY</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-mono bg-neutral-900 border border-grid-line-dark text-neutral-dark uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          <span id="principles-step-counter">01 / 03</span>
        </span>
      </div>
    </div>

    <!-- HYBRID STEPPER NAVIGATION (Direct Jump Buttons & Visual Progress Gauge) -->
    <div class="mt-4 flex flex-col space-y-1.5">
      <div 
        class="grid grid-cols-3 border border-grid-line-dark bg-card-dark divide-x divide-grid-line-dark font-mono text-[11px]" 
        role="tablist" 
        aria-label="Engineering principles navigation steps"
      >
        {principlesData.map((p, idx) => {
          const isInitial = idx === 0;
          return (
            <button
              type="button"
              role="tab"
              id={`principle-step-btn-${idx + 1}`}
              aria-selected={isInitial ? "true" : "false"}
              data-step-index={idx}
              class={`principle-step-btn relative px-3 sm:px-4 py-2.5 text-left transition-all duration-150 cursor-pointer select-none flex items-center justify-between overflow-hidden active:scale-[0.99] ${
                isInitial
                  ? 'is-active bg-black text-white'
                  : 'bg-card-dark text-neutral hover:bg-neutral-900 hover:text-white'
              }`}
              style="transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);"
            >
              <!-- Top Accent Indicator -->
              <span 
                class={`step-accent-indicator absolute inset-x-0 top-0 h-[2px] bg-accent transition-opacity duration-150 ${
                  isInitial ? 'opacity-100' : 'opacity-0'
                }`}
              ></span>

              <div class="flex items-center gap-2 min-w-0">
                <span class="step-num font-bold text-accent">P-[{p.step}]</span>
                <span class="step-label hidden sm:inline-block font-bold text-[10px] truncate">
                  {p.tag}
                </span>
              </div>

              <span class="step-dot text-accent text-[9px] font-bold">
                {isInitial ? '●' : '○'}
              </span>
            </button>
          );
        })}
      </div>

      <!-- Linear Progress Gauge Line -->
      <div class="w-full h-[2px] bg-neutral-900 overflow-hidden relative" aria-hidden="true">
        <div 
          id="principles-progress-bar" 
          class="h-full bg-accent transition-all duration-200"
          style="width: 33.333%;"
        ></div>
      </div>
    </div>

    <!-- ======================================================================= -->
    <!-- MASTER 2-COLUMN INTERACTIVE STAGE (PHILOSOPHY + DEDICATED SIMULATOR)    -->
    <!-- Calibrated height: fits 100% within viewport, never clipped at bottom   -->
    <!-- ======================================================================= -->
    <div 
      id="principles-stage-card" 
      class="mt-4 relative bg-card-dark border border-grid-line-dark p-5 sm:p-6 lg:p-7 shadow-[0_20px_50px_rgba(0,0,0,0.5)] overflow-hidden"
    >
      <!-- Scanline Laser Calibration Beam -->
      <div 
        id="stage-scanline-laser" 
        class="pointer-events-none absolute inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-accent to-transparent opacity-0 z-30" 
        aria-hidden="true"
      ></div>

      <!-- 3 Principles Content Panels (Grid-based, Only Active is Displayed) -->
      {principlesData.map((p, idx) => {
        const isDefault = idx === 0;
        return (
          <div 
            id={`principle-panel-${idx + 1}`}
            class={`principle-panel w-full grid-cols-12 gap-6 lg:gap-8 items-start transition-opacity duration-150 ${
              isDefault ? 'grid is-active' : 'hidden'
            }`}
            data-panel-index={idx}
          >
            
            <!-- SISI KIRI (5 KOLOM): ARCHITECTURAL IDENTITY & PROOF HOOKS -->
            <div class="w-full col-span-12 lg:col-span-5 flex flex-col justify-between space-y-4">
              <div class="space-y-3">
                <!-- Tag Header -->
                <div class="flex items-center justify-between font-mono text-caption text-neutral-dark border-b border-grid-line-dark pb-2">
                  <span class="text-foreground font-bold font-mono text-[13px]">
                    PRINCIPLE <span class="text-accent">P-[{p.step}]</span>
                  </span>
                  <span class="uppercase tracking-wider text-accent font-semibold text-[10px]">
                    {p.tag}
                  </span>
                </div>

                <!-- Title & Core Copy -->
                <div>
                  <h3 class="text-[1.25rem] lg:text-[1.4rem] font-bold tracking-tight text-foreground leading-tight">
                    {p.title}
                  </h3>
                  <p class="text-[12px] sm:text-[13px] text-neutral leading-relaxed mt-2">
                    {p.description}
                  </p>
                </div>

                <!-- Invariant Bullets -->
                <ul class="space-y-1.5 pt-2 border-t border-grid-line-dark text-[11px] sm:text-[12px] text-neutral">
                  {p.bullets.map((bullet) => (
                    <li class="flex items-start gap-2">
                      <span class="text-accent font-bold mt-0.5 select-none text-[11px]">•</span>
                      <span class="leading-snug">{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Verified Case Study & Technical Notes Hooks -->
              <div class="pt-3 border-t border-grid-line-dark space-y-1.5 font-mono text-[10px]">
                <div class="text-[9px] uppercase text-neutral-dark tracking-wider select-none font-semibold">
                  // VERIFIED_IMPLEMENTATION_PROOF:
                </div>
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
                  <a 
                    href={p.noteUrl}
                    class="flex-1 flex items-center justify-between px-2.5 py-1.5 bg-black hover:bg-neutral-900 border border-grid-line-dark hover:border-accent text-neutral-200 hover:text-white transition-colors duration-150"
                  >
                    <span class="truncate">{p.noteLabel}</span>
                    <span class="text-accent text-[10px]">↗</span>
                  </a>
                  <a 
                    href={p.projectUrl}
                    class="flex items-center justify-between px-2.5 py-1.5 bg-black hover:bg-accent border border-grid-line-dark hover:border-accent text-accent hover:text-black font-bold transition-all duration-150"
                  >
                    <span>{p.projectLabel}</span>
                  </a>
                </div>
              </div>
            </div>

            <!-- SISI KANAN (7 KOLOM): WIDE DEDICATED SIMULATION CANVAS -->
            <div class="w-full col-span-12 lg:col-span-7 flex flex-col space-y-3">
              
              {/* ======================================================= */}
              {/* CANVAS FOR PRINCIPLE 01 (ZERO DATA LEAKAGE)             */}
              {/* ======================================================= */}
              {idx === 0 && (
                <div class="space-y-3">
                  <!-- Control Header -->
                  <div class="flex items-center justify-between gap-2 pb-1.5 border-b border-grid-line-dark/80">
                    <span class="font-mono text-[9px] sm:text-[10px] uppercase text-neutral-dark font-semibold tracking-wider">
                      INTERACTIVE_CANVAS // PURGE_EMBARGO_SPLITTER
                    </span>
                    <span 
                      id="p1-status-badge" 
                      class="font-mono text-[9px] sm:text-[10px] tracking-wider px-2 py-0.5 border border-emerald-500/40 bg-emerald-500/10 text-emerald-400 font-bold flex items-center gap-1.5 transition-all duration-150"
                    >
                      <span id="p1-badge-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      <span id="p1-badge-text">PASS: ZERO_LEAKAGE (+9d GAP)</span>
                    </span>
                  </div>

                  <!-- Scrubber Control Box -->
                  <div class="bg-black p-3 border border-grid-line-dark space-y-2 font-mono text-[10px]">
                    <div class="flex items-center justify-between text-neutral-dark text-[9px] uppercase pb-1 border-b border-grid-line-dark/60">
                      <span>SCRUB TEMPORAL CUTOFF BOUNDARY (t)</span>
                      <span id="p1-slider-val-label" class="text-accent font-bold">CUTOFF: 2024-03-01 (45%)</span>
                    </div>

                    <!-- Range Slider Input -->
                    <div class="py-0.5">
                      <input 
                        id="p1-time-slider" 
                        type="range" 
                        min="20" 
                        max="80" 
                        value="45" 
                        step="1"
                        class="w-full h-1.5 bg-neutral-800 rounded-none appearance-none cursor-pointer accent-[#ff4500] focus:outline-none"
                        aria-label="Scrub temporal train-validation cutoff timestamp"
                      />
                    </div>

                    <!-- Quick Preset Selectors -->
                    <div class="flex items-center justify-between gap-2 pt-1 border-t border-grid-line-dark/40 text-[9px]">
                      <span class="text-neutral-dark">PRESETS:</span>
                      <div class="flex items-center gap-2">
                        <button 
                          id="p1-btn-preset-purge" 
                          type="button" 
                          class="py-0.5 px-2 bg-neutral-900 hover:bg-neutral-800 border border-emerald-500/40 text-emerald-400 font-mono tracking-wider transition-colors duration-150 active:scale-[0.98] cursor-pointer"
                        >
                          [STRICT PURGE (9d GAP)]
                        </button>
                        <button 
                          id="p1-btn-preset-leak" 
                          type="button" 
                          class="py-0.5 px-2 bg-neutral-900 hover:bg-neutral-800 border border-rose-500/40 text-rose-400 font-mono tracking-wider transition-colors duration-150 active:scale-[0.98] cursor-pointer"
                        >
                          [NAIVE OVERLAP (+5d LEAK)]
                        </button>
                      </div>
                    </div>
                  </div>

                  <!-- Wide Timeline Range Visualizer -->
                  <div class="bg-black p-3 border border-grid-line-dark font-mono text-[10px] space-y-1.5">
                    <div class="flex items-center justify-between text-neutral-dark text-[9px] uppercase pb-1 border-b border-grid-line-dark/60">
                      <span>t0: 2024-01-01</span>
                      <span id="p1-timeline-split-label" class="text-accent font-bold">GAP: +9 DAYS (EMBARGO)</span>
                      <span>t_end: 2024-04-30</span>
                    </div>

                    <!-- Multi-Bar Visualizer -->
                    <div class="relative w-full h-7 bg-neutral-900 border border-grid-line-dark flex overflow-hidden">
                      <div 
                        id="p1-train-bar" 
                        class="h-full bg-neutral-700 text-foreground flex items-center justify-center font-bold text-[9px] border-r border-background transition-all duration-75"
                        style="width: 45%;"
                      >
                        <span id="p1-train-label" class="truncate px-1.5">TRAIN [45%]</span>
                      </div>

                      <div 
                        id="p1-embargo-bar" 
                        class="h-full bg-emerald-950/70 text-emerald-400 border-r border-background flex items-center justify-center font-bold text-[8px] transition-all duration-75"
                        style="width: 10%;"
                      >
                        <span id="p1-embargo-label" class="truncate px-0.5">GAP 9d</span>
                      </div>

                      <div 
                        id="p1-eval-bar" 
                        class="h-full bg-neutral-800 text-neutral flex items-center justify-center font-bold text-[9px] transition-all duration-75"
                        style="width: 45%;"
                      >
                        <span id="p1-eval-label" class="truncate px-1.5">EVAL [45%]</span>
                      </div>
                    </div>

                    <!-- Live Sample Count Callout -->
                    <div id="p1-callout" class="flex items-center justify-between text-[10px] text-emerald-400 pt-0.5 transition-colors duration-150">
                      <span class="flex items-center gap-1 font-mono">
                        <span id="p1-callout-icon">✓</span>
                        <span id="p1-callout-text">1,420 / 1,420 samples uncontaminated. Point-in-time verified.</span>
                      </span>
                    </div>
                  </div>

                  <!-- Live Code Assert Output Console -->
                  <div class="bg-black p-2.5 border border-grid-line-dark font-mono text-caption text-neutral overflow-x-auto leading-tight">
                    <div class="text-[9px] text-neutral-dark mb-0.5 select-none flex items-center justify-between">
                      <span># LIVE_ASSERTION_MONITOR:</span>
                      <span id="p1-assert-status" class="text-emerald-400 text-[9px]">ASSERT_PASS ✓</span>
                    </div>
                    <code id="p1-assert-code" class="text-neutral text-[10px] block select-all whitespace-pre font-mono leading-relaxed">assert partition.max_timestamp &lt; eval_window.min_timestamp, \
    "LeakageDetected: lookahead contamination in split"
# [PASS] 2024-03-01 &lt; 2024-03-10 (+9d temporal gap maintained) ✓</code>
                  </div>
                </div>
              )}

              {/* ======================================================= */}
              {/* CANVAS FOR PRINCIPLE 02 (DEFENSIVE VERIFICATION & CHAOS)*/}
              {/* ======================================================= */}
              {idx === 1 && (
                <div class="space-y-3">
                  <!-- Control Header -->
                  <div class="flex items-center justify-between gap-2 pb-1.5 border-b border-grid-line-dark/80">
                    <span class="font-mono text-[9px] sm:text-[10px] uppercase text-neutral-dark font-semibold tracking-wider">
                      INTERACTIVE_CANVAS // POSIX_SIGNAL_SUPERVISOR
                    </span>
                    <span 
                      id="p2-status-badge" 
                      class="font-mono text-[9px] sm:text-[10px] tracking-wider px-2 py-0.5 border border-emerald-500/40 bg-emerald-500/10 text-emerald-400 font-bold flex items-center gap-1.5 transition-all duration-150"
                    >
                      <span id="p2-badge-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                      <span id="p2-badge-text">PID 40921: RUNNING (ACTIVE)</span>
                    </span>
                  </div>

                  <!-- Signal Selector Matrix -->
                  <div class="grid grid-cols-3 gap-2">
                    <button 
                      id="p2-btn-sigterm"
                      type="button"
                      class="p-2 bg-black border border-grid-line-dark hover:border-accent text-foreground hover:text-white font-mono text-[10px] tracking-wider transition-all duration-150 cursor-pointer select-none active:scale-[0.98] text-center"
                    >
                      <span class="block text-accent font-bold text-[11px]">SIGTERM (15)</span>
                      <span class="text-[9px] text-neutral-dark block mt-0.5">DRAIN 12/12</span>
                    </button>
                    
                    <button 
                      id="p2-btn-sigint"
                      type="button"
                      class="p-2 bg-black border border-grid-line-dark hover:border-accent text-foreground hover:text-white font-mono text-[10px] tracking-wider transition-all duration-150 cursor-pointer select-none active:scale-[0.98] text-center"
                    >
                      <span class="block text-accent font-bold text-[11px]">SIGINT (2)</span>
                      <span class="text-[9px] text-neutral-dark block mt-0.5">FLUSH CKPT</span>
                    </button>
                    
                    <button 
                      id="p2-btn-sigkill"
                      type="button"
                      class="p-2 bg-black border border-grid-line-dark hover:border-rose-500 text-foreground hover:text-rose-400 font-mono text-[10px] tracking-wider transition-all duration-150 cursor-pointer select-none active:scale-[0.98] text-center"
                    >
                      <span class="block text-rose-500 font-bold text-[11px]">SIGKILL (9)</span>
                      <span class="text-[9px] text-neutral-dark block mt-0.5">REAP TEST</span>
                    </button>
                  </div>

                  <!-- Streaming Terminal Window -->
                  <div class="bg-black p-3 border border-grid-line-dark font-mono text-[10px] space-y-1.5 min-h-[130px] max-h-[130px] flex flex-col justify-between">
                    <div class="flex items-center justify-between text-neutral-dark text-[9px] uppercase pb-1 border-b border-grid-line-dark/60 select-none">
                      <span>TTY: /DEV/PTS/2 // BUS: SHM</span>
                      <span>MEM: 142MB RSS</span>
                      <span id="p2-zombie-count" class="text-emerald-400 font-bold">ZOMBIES: 0</span>
                    </div>

                    <div id="p2-terminal-lines" class="space-y-1 text-[10px] text-neutral overflow-y-auto max-h-[75px] leading-relaxed">
                      <div class="text-neutral-dark">$ spawn_worker(task=heavy_inference, pid=40921)</div>
                      <div class="text-foreground flex items-center gap-1.5">
                        <span class="text-emerald-400">●</span>
                        <span>[RUNNING] Ingesting inference queue... 12/12 items allocated in memory</span>
                      </div>
                      <div class="text-neutral-dark">// Ready for OS interrupt chaos injection...</div>
                    </div>

                    <div class="pt-1 border-t border-grid-line-dark/50 flex items-center justify-between text-[9px] text-neutral-dark select-none">
                      <span id="p2-terminal-status" class="flex items-center gap-1 text-emerald-400">
                        <span>●</span> LISTENING FOR SIGNALS
                      </span>
                      <span id="p2-exit-code" class="text-neutral-dark font-mono">EXIT_CODE: --</span>
                    </div>
                  </div>

                  <!-- Code contract representation -->
                  <div class="bg-black p-2 border border-grid-line-dark font-mono text-caption text-neutral overflow-x-auto leading-tight">
                    <div class="text-[9px] text-neutral-dark mb-0.5 select-none"># DEFENSIVE_SUPERVISOR_TEST:</div>
                    <code class="text-neutral text-[10px] block select-all whitespace-pre font-mono">def test_worker_interrupt_leaves_no_zombies():
    proc = spawn_worker(task=heavy_inference)
    proc.send_signal(signal.SIGINT)
    assert proc.wait(timeout=1.0) == 0</code>
                  </div>
                </div>
              )}

              {/* ======================================================= */}
              {/* CANVAS FOR PRINCIPLE 03 (DOMAIN ISOLATION & CONTRACTS)  */}
              {/* ======================================================= */}
              {idx === 2 && (
                <div class="space-y-3">
                  <!-- Control Header -->
                  <div class="flex items-center justify-between gap-2 pb-1.5 border-b border-grid-line-dark/80">
                    <span class="font-mono text-[9px] sm:text-[10px] uppercase text-neutral-dark font-semibold tracking-wider">
                      INTERACTIVE_CANVAS // PYDANTIC_V2_STRICT_CORE
                    </span>
                    <span 
                      id="p3-status-badge" 
                      class="font-mono text-[9px] sm:text-[10px] tracking-wider px-2 py-0.5 border border-emerald-500/40 bg-emerald-500/10 text-emerald-400 font-bold flex items-center gap-1.5 transition-all duration-150"
                    >
                      <span id="p3-badge-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                      <span id="p3-badge-text">PASS: 200_VALIDATED</span>
                    </span>
                  </div>

                  <!-- Multi-Fault Injection Buttons -->
                  <div class="grid grid-cols-3 gap-2">
                    <button 
                      id="p3-btn-extra"
                      type="button"
                      class="p-2 bg-black border border-grid-line-dark hover:border-accent text-foreground hover:text-white font-mono text-[10px] tracking-wider transition-all duration-150 cursor-pointer select-none active:scale-[0.98] text-center"
                    >
                      <span class="block text-accent font-bold text-[11px]">+ EXTRA_PARAM</span>
                      <span class="text-[9px] text-neutral-dark block mt-0.5">EXTRA="FORBID"</span>
                    </button>
                    
                    <button 
                      id="p3-btn-dim"
                      type="button"
                      class="p-2 bg-black border border-grid-line-dark hover:border-accent text-foreground hover:text-white font-mono text-[10px] tracking-wider transition-all duration-150 cursor-pointer select-none active:scale-[0.98] text-center"
                    >
                      <span class="block text-accent font-bold text-[11px]">+ DIM_MISMATCH</span>
                      <span class="text-[9px] text-neutral-dark block mt-0.5">64 vs 128 ITEMS</span>
                    </button>
                    
                    <button 
                      id="p3-btn-null"
                      type="button"
                      class="p-2 bg-black border border-grid-line-dark hover:border-rose-500 text-foreground hover:text-rose-400 font-mono text-[10px] tracking-wider transition-all duration-150 cursor-pointer select-none active:scale-[0.98] text-center"
                    >
                      <span class="block text-rose-500 font-bold text-[11px]">+ NULL_PAYLOAD</span>
                      <span class="text-[9px] text-neutral-dark block mt-0.5">STRICT=TRUE</span>
                    </button>
                  </div>

                  <!-- Reset to Valid Payload -->
                  <button 
                    id="p3-btn-reset"
                    type="button"
                    class="w-full py-1.5 px-2 bg-neutral-900 hover:bg-neutral-800 border border-grid-line-dark text-neutral-200 hover:text-white font-mono text-[10px] font-bold tracking-wider transition-colors duration-150 active:scale-[0.99] cursor-pointer text-center"
                  >
                    [RESET TO STRICT VALID PAYLOAD (200 OK)]
                  </button>

                  <!-- Input Buffer JSON Payload Display -->
                  <div class="bg-black p-2.5 border border-grid-line-dark font-mono text-[10px] space-y-1">
                    <div class="flex items-center justify-between text-neutral-dark text-[9px] uppercase pb-0.5 border-b border-grid-line-dark/60 select-none">
                      <span>INCOMING_JSON_BUFFER</span>
                      <span id="p3-payload-type" class="text-accent font-bold">VALID_JSON_SCHEMA</span>
                    </div>

                    <div class="text-[10px] text-neutral overflow-x-auto leading-relaxed">
                      <pre id="p3-payload-display" class="font-mono whitespace-pre text-neutral-dark">&#123;
  <span id="p3-embeddings-line">"embeddings": [0.182, -0.429, ... 128 items],</span>
  <span id="p3-extra-line" class="hidden text-rose-400 bg-rose-950/40 px-1 font-bold">"extra_param": "malicious_injection", // [FORBIDDEN]</span>
&#125;</pre>
                    </div>
                  </div>

                  <!-- Real Pydantic V2 Validation Output -->
                  <div class="bg-black p-2.5 border border-grid-line-dark font-mono text-caption text-neutral overflow-x-auto leading-tight min-h-[75px]">
                    <div class="text-[9px] text-neutral-dark mb-0.5 select-none flex items-center justify-between">
                      <span># PYDANTIC_V2_RUST_CORE_RESPONSE:</span>
