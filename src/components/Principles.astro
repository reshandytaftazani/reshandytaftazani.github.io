<!-- STYLES: SCANLINE LASER & STAGE TRANSITION ANIMATIONS                      -->
<!-- ========================================================================= -->
<style>
  @keyframes stageScanlineSweep {
    0% {
      top: 0%;
      opacity: 1;
    }
    60% {
      opacity: 0.85;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  @keyframes stagePanelSlideIn {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .principle-panel.is-active {
    animation: stagePanelSlideIn 180ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  #stage-scanline-laser.is-sweeping {
    animation: stageScanlineSweep 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .principle-panel.is-active,
    #stage-scanline-laser.is-sweeping {
      animation: none !important;
      transform: none !important;
    }
  }
</style>

<!-- ========================================================================= -->
<!-- CLIENT-SIDE SCRIPT: SCROLLYTELLING ORCHESTRATOR & SIMULATORS              -->
<!-- ========================================================================= -->
<script>
  import { playClick, playSuccess, playViolation } from '../utils/audio';

  function initPrinciplesScrollytelling() {
    const section = document.getElementById('principles');
    const stepBtns = document.querySelectorAll<HTMLButtonElement>('.principle-step-btn');
    const panels = document.querySelectorAll<HTMLElement>('.principle-panel');
    const laser = document.getElementById('stage-scanline-laser');
    const progressBar = document.getElementById('principles-progress-bar');
    const counterBadge = document.getElementById('principles-step-counter');
    const activeTagLabel = document.getElementById('principles-active-tag');

    const stepTags = ['TEMPORAL_INTEGRITY', 'DEFENSIVE_CHAOS', 'DOMAIN_ISOLATION'];
    let currentStepIndex = 0;
    let isManualClickLock = false;
    let manualLockTimeout: ReturnType<typeof setTimeout> | null = null;

    function triggerScanline() {
      if (!laser) return;
      laser.classList.remove('is-sweeping');
      void laser.offsetWidth; // Force reflow
      laser.classList.add('is-sweeping');
    }

    function setActivePrinciple(stepIdx: number, shouldPlaySound = true) {
      if (stepIdx === currentStepIndex && panels[stepIdx]?.classList.contains('is-active')) {
        return;
      }
      currentStepIndex = stepIdx;
      if (shouldPlaySound) {
        playClick(1200 + stepIdx * 100);
      }
      triggerScanline();

      // 1. Update Step Buttons
      stepBtns.forEach((btn, idx) => {
        const isTarget = idx === stepIdx;
        const accentIndicator = btn.querySelector('.step-accent-indicator');
        const dot = btn.querySelector('.step-dot');

        btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');

        if (isTarget) {
          btn.classList.add('is-active', 'bg-black', 'text-white');
          btn.classList.remove('bg-card-dark', 'text-neutral');
          if (accentIndicator) accentIndicator.classList.replace('opacity-0', 'opacity-100');
          if (dot) dot.textContent = '●';
        } else {
          btn.classList.remove('is-active', 'bg-black', 'text-white');
          btn.classList.add('bg-card-dark', 'text-neutral');
          if (accentIndicator) accentIndicator.classList.replace('opacity-100', 'opacity-0');
          if (dot) dot.textContent = '○';
        }
      });

      // 2. Update Progress Bar & Counters
      if (progressBar) {
        const pct = ((stepIdx + 1) / 3) * 100;
        progressBar.style.width = `${pct}%`;
      }
      if (counterBadge) {
        counterBadge.textContent = `0${stepIdx + 1} / 03`;
      }
      if (activeTagLabel) {
        activeTagLabel.textContent = stepTags[stepIdx] || '';
      }

      // 3. Update Panels with Grid Layout
      panels.forEach((panel, idx) => {
        if (idx === stepIdx) {
          panel.classList.remove('hidden');
          panel.classList.add('grid', 'is-active');
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('grid', 'is-active');
        }
      });
    }

    // Direct Click Stepper Handler (Hybrid Navigation)
    stepBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetIdx = parseInt(btn.dataset.stepIndex || '0', 10);
        isManualClickLock = true;
        if (manualLockTimeout) clearTimeout(manualLockTimeout);
        manualLockTimeout = setTimeout(() => {
          isManualClickLock = false;
        }, 700);

        setActivePrinciple(targetIdx, true);

        // On desktop, also sync scroll position inside the track
        if (window.innerWidth >= 1024 && section) {
          const sectionTop = section.getBoundingClientRect().top + window.scrollY;
          const sectionHeight = section.offsetHeight;
          const targetScrollY = sectionTop + (targetIdx / 3) * (sectionHeight - window.innerHeight * 0.7);
          window.scrollTo({
            top: targetScrollY,
            behavior: 'smooth',
          });
        }
      });
    });

    // Desktop Scroll-Driven Observer
    function handleScroll() {
      if (window.innerWidth < 1024 || !section || isManualClickLock) return;

      const rect = section.getBoundingClientRect();
      const sectionHeight = section.offsetHeight;
      const viewportHeight = window.innerHeight;

      // Calculate scroll progress within section track (0 to 1)
      const scrolled = -rect.top;
      const maxScroll = sectionHeight - viewportHeight;

      if (scrolled >= 0 && scrolled <= maxScroll) {
        const progress = scrolled / maxScroll;
        let step = 0;
        if (progress > 0.66) {
          step = 2;
        } else if (progress > 0.33) {
          step = 1;
        }
        if (step !== currentStepIndex) {
          setActivePrinciple(step, true);
        }
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });

    // =======================================================================
    // SIMULATOR 01: ZERO DATA LEAKAGE (TIMELINE RANGE SCRUBBER)
    // =======================================================================
    const p1Slider = document.getElementById('p1-time-slider') as HTMLInputElement | null;
    const p1SliderLabel = document.getElementById('p1-slider-val-label');
    const p1BtnPresetPurge = document.getElementById('p1-btn-preset-purge');
    const p1BtnPresetLeak = document.getElementById('p1-btn-preset-leak');
    const p1StatusBadge = document.getElementById('p1-status-badge');
    const p1BadgeDot = document.getElementById('p1-badge-dot');
    const p1BadgeText = document.getElementById('p1-badge-text');
    const p1TrainBar = document.getElementById('p1-train-bar');
    const p1TrainLabel = document.getElementById('p1-train-label');
    const p1EmbargoBar = document.getElementById('p1-embargo-bar');
    const p1EmbargoLabel = document.getElementById('p1-embargo-label');
    const p1EvalBar = document.getElementById('p1-eval-bar');
    const p1EvalLabel = document.getElementById('p1-eval-label');
    const p1Callout = document.getElementById('p1-callout');
    const p1CalloutIcon = document.getElementById('p1-callout-icon');
    const p1CalloutText = document.getElementById('p1-callout-text');
    const p1AssertStatus = document.getElementById('p1-assert-status');
    const p1AssertCode = document.getElementById('p1-assert-code');
    const p1SplitLabel = document.getElementById('p1-timeline-split-label');

    let lastSliderAudio = 0;

    function updateP1Cutoff(cutoffVal: number, playAudio = true) {
      if (playAudio) {
        const now = performance.now();
        if (now - lastSliderAudio > 40) {
          playClick(1000 + cutoffVal * 8, 0.012, 0.025);
          lastSliderAudio = now;
        }
      }

      const isPurged = cutoffVal <= 50;
      const trainPct = cutoffVal;
      const evalStart = 55;

      if (isPurged) {
        const gapDays = Math.round(((evalStart - trainPct) / 10) * 9);
        const embargoPct = Math.max(0, evalStart - trainPct);
        const evalPct = 100 - evalStart;

        if (p1SliderLabel) {
          p1SliderLabel.textContent = `CUTOFF: 2024-03-01 (${trainPct}%)`;
          p1SliderLabel.className = 'text-accent font-bold';
        }

        if (p1StatusBadge) {
          p1StatusBadge.className = 'font-mono text-[9px] sm:text-[10px] tracking-wider px-2 py-0.5 border border-emerald-500/40 bg-emerald-500/10 text-emerald-400 font-bold flex items-center gap-1.5 transition-all duration-150';
        }
        if (p1BadgeDot) p1BadgeDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400';
        if (p1BadgeText) p1BadgeText.textContent = `PASS: ZERO_LEAKAGE (+${gapDays}d GAP)`;
        if (p1SplitLabel) p1SplitLabel.textContent = `EMBARGO BUFFER: +${gapDays} DAYS`;

        if (p1TrainBar) {
          p1TrainBar.style.width = `${trainPct}%`;
          p1TrainBar.className = 'h-full bg-neutral-700 text-foreground flex items-center justify-center font-bold text-[9px] border-r border-background transition-all duration-75';
        }
        if (p1TrainLabel) p1TrainLabel.textContent = `TRAIN [${trainPct}%]`;

        if (p1EmbargoBar) {
          p1EmbargoBar.style.width = `${embargoPct}%`;
          p1EmbargoBar.className = 'h-full bg-emerald-950/70 text-emerald-400 border-r border-background flex items-center justify-center font-bold text-[8px] transition-all duration-75';
        }
        if (p1EmbargoLabel) p1EmbargoLabel.textContent = `GAP ${gapDays}d`;

        if (p1EvalBar) {
          p1EvalBar.style.width = `${evalPct}%`;
          p1EvalBar.className = 'h-full bg-neutral-800 text-neutral flex items-center justify-center font-bold text-[9px] transition-all duration-75';
        }
        if (p1EvalLabel) p1EvalLabel.textContent = `EVAL [${evalPct}%]`;

        if (p1Callout) p1Callout.className = 'flex items-center justify-between text-[10px] text-emerald-400 pt-0.5 transition-colors duration-150';
        if (p1CalloutIcon) p1CalloutIcon.textContent = '✓';
        if (p1CalloutText) p1CalloutText.textContent = '1,420 / 1,420 samples uncontaminated. Point-in-time verified.';

        if (p1AssertStatus) {
          p1AssertStatus.textContent = 'ASSERT_PASS ✓';
          p1AssertStatus.className = 'text-emerald-400 text-[9px]';
        }

        if (p1AssertCode) {
          p1AssertCode.className = 'text-neutral text-[10px] block select-all whitespace-pre font-mono leading-relaxed';
          p1AssertCode.textContent = `assert partition.max_timestamp < eval_window.min_timestamp, \\
    "LeakageDetected: lookahead contamination in split"
# [PASS] 2024-03-01 < 2024-03-10 (+${gapDays}d temporal gap maintained) ✓`;
        }
      } else {
        const leakDays = Math.round(((trainPct - evalStart) / 10) * 12) + 1;
        const leakedRows = Math.round(leakDays * 56.8);

        if (p1SliderLabel) {
          p1SliderLabel.textContent = `OVERLAP: +${leakDays}d CONTAMINATED (${trainPct}%)`;
          p1SliderLabel.className = 'text-rose-400 font-bold';
        }

        if (p1StatusBadge) {
          p1StatusBadge.className = 'font-mono text-[9px] sm:text-[10px] tracking-wider px-2 py-0.5 border border-rose-500/40 bg-rose-500/10 text-rose-400 font-bold flex items-center gap-1.5 transition-all duration-150';
        }
        if (p1BadgeDot) p1BadgeDot.className = 'w-1.5 h-1.5 rounded-full bg-rose-500 animate-ping';
        if (p1BadgeText) p1BadgeText.textContent = `FAIL: LOOKAHEAD_VIOLATION (+${leakDays}d)`;
        if (p1SplitLabel) p1SplitLabel.textContent = `OVERLAP: +${leakDays}d TARGET CONTAMINATION`;

        if (p1TrainBar) {
          p1TrainBar.style.width = `${trainPct}%`;
          p1TrainBar.className = 'h-full bg-rose-950 text-rose-300 flex items-center justify-center font-bold text-[9px] border-r border-rose-500 transition-all duration-75';
        }
        if (p1TrainLabel) p1TrainLabel.textContent = `TRAIN [${trainPct}%] LEAKING`;

        if (p1EmbargoBar) {
          p1EmbargoBar.style.width = '0%';
          p1EmbargoBar.className = 'hidden';
        }

        const remainingEval = Math.max(20, 100 - trainPct);
        if (p1EvalBar) {
          p1EvalBar.style.width = `${remainingEval}%`;
          p1EvalBar.className = 'h-full bg-neutral-900 text-rose-400/80 flex items-center justify-center font-bold text-[9px] transition-all duration-75';
        }
        if (p1EvalLabel) p1EvalLabel.textContent = `EVAL [${remainingEval}%]`;

        if (p1Callout) p1Callout.className = 'flex items-center justify-between text-[10px] text-rose-400 font-bold pt-0.5 transition-colors duration-150';
        if (p1CalloutIcon) p1CalloutIcon.textContent = '✗';
        if (p1CalloutText) p1CalloutText.textContent = `VIOLATION: ${leakedRows} test labels leaked into training window!`;

        if (p1AssertStatus) {
          p1AssertStatus.textContent = 'ASSERTION_ERROR ✗';
          p1AssertStatus.className = 'text-rose-400 text-[9px] font-bold';
        }

        if (p1AssertCode) {
          p1AssertCode.className = 'text-rose-400 text-[10px] block select-all whitespace-pre font-mono leading-relaxed';
          p1AssertCode.textContent = `assert partition.max_timestamp < eval_window.min_timestamp, \\
    "LeakageDetected: lookahead contamination in split"
# AssertionError: LeakageDetected!
# train_max >= eval_min (violation: +${leakDays} days overlap)`;
        }
      }
    }

    p1Slider?.addEventListener('input', (e) => {
      const val = parseInt((e.target as HTMLInputElement).value, 10);
      updateP1Cutoff(val, true);
    });

    p1BtnPresetPurge?.addEventListener('click', () => {
      if (p1Slider) p1Slider.value = '45';
      updateP1Cutoff(45, false);
      playSuccess();
    });

    p1BtnPresetLeak?.addEventListener('click', () => {
      if (p1Slider) p1Slider.value = '64';
      updateP1Cutoff(64, false);
      playViolation();
    });

    // =======================================================================
    // SIMULATOR 02: POSIX SIGNAL MATRIX
    // =======================================================================
    const p2BtnSigterm = document.getElementById('p2-btn-sigterm');
    const p2BtnSigint = document.getElementById('p2-btn-sigint');
    const p2BtnSigkill = document.getElementById('p2-btn-sigkill');
    const p2StatusBadge = document.getElementById('p2-status-badge');
    const p2BadgeDot = document.getElementById('p2-badge-dot');
    const p2BadgeText = document.getElementById('p2-badge-text');
    const p2TerminalLines = document.getElementById('p2-terminal-lines');
    const p2TerminalStatus = document.getElementById('p2-terminal-status');
    const p2ExitCode = document.getElementById('p2-exit-code');
    const p2ZombieCount = document.getElementById('p2-zombie-count');

    let isP2Busy = false;
    let currentWorkerPid = 40921;

    function appendTerminalLine(html: string) {
      if (!p2TerminalLines) return;
      p2TerminalLines.innerHTML += html;
      p2TerminalLines.scrollTop = p2TerminalLines.scrollHeight;
    }

    p2BtnSigterm?.addEventListener('click', () => {
      if (isP2Busy) return;
      isP2Busy = true;
      playClick(750);

      if (p2StatusBadge) {
        p2StatusBadge.className = 'font-mono text-[9px] sm:text-[10px] tracking-wider px-2 py-0.5 border border-accent/40 bg-accent/10 text-accent font-bold flex items-center gap-1.5 transition-all duration-150';
      }
      if (p2BadgeDot) p2BadgeDot.className = 'w-1.5 h-1.5 rounded-full bg-accent animate-ping';
      if (p2BadgeText) p2BadgeText.textContent = `PID ${currentWorkerPid}: SIGTERM (15)`;
      if (p2TerminalStatus) {
        p2TerminalStatus.className = 'flex items-center gap-1 text-accent';
        p2TerminalStatus.innerHTML = '<span>⚡</span> TRAP TRIGGERED';
      }

      appendTerminalLine(`<div class="text-accent flex items-center gap-1 pt-1 border-t border-grid-line-dark/40 font-bold">
        <span>⚡</span> [SIG] kill -15 ${currentWorkerPid} (SIGTERM) dispatched
      </div>`);

      setTimeout(() => {
        playViolation();
        appendTerminalLine(`<div class="text-neutral-200">
          [INTERRUPT] Received SIGTERM... Draining batch (12/12)...
        </div>`);

        setTimeout(() => {
          playSuccess();
          appendTerminalLine(`<div class="text-emerald-400 font-bold flex items-center gap-1">
            <span>✓</span> Process exited with code 0 (No zombies)
          </div>`);

          if (p2StatusBadge) {
            p2StatusBadge.className = 'font-mono text-[9px] sm:text-[10px] tracking-wider px-2 py-0.5 border border-emerald-500/40 bg-emerald-500/10 text-emerald-400 font-bold flex items-center gap-1.5 transition-all duration-150';
          }
          if (p2BadgeDot) p2BadgeDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400';
          if (p2BadgeText) p2BadgeText.textContent = 'PASS: ZERO_ZOMBIES (CODE 0)';
          if (p2ExitCode) {
            p2ExitCode.className = 'text-emerald-400 font-bold';
            p2ExitCode.textContent = 'EXIT_CODE: 0 ✓';
          }
          if (p2TerminalStatus) {
            p2TerminalStatus.className = 'flex items-center gap-1 text-emerald-400';
            p2TerminalStatus.innerHTML = '<span>✓</span> SUPERVISOR DRAINED';
          }
          isP2Busy = false;
        }, 280);
      }, 280);
    });

    p2BtnSigint?.addEventListener('click', () => {
      if (isP2Busy) return;
      isP2Busy = true;
      playClick(850);

      if (p2StatusBadge) {
        p2StatusBadge.className = 'font-mono text-[9px] sm:text-[10px] tracking-wider px-2 py-0.5 border border-accent/40 bg-accent/10 text-accent font-bold flex items-center gap-1.5 transition-all duration-150';
      }
      if (p2BadgeDot) p2BadgeDot.className = 'w-1.5 h-1.5 rounded-full bg-accent animate-ping';
      if (p2BadgeText) p2BadgeText.textContent = `PID ${currentWorkerPid}: SIGINT (2)`;

      appendTerminalLine(`<div class="text-accent flex items-center gap-1 pt-1 border-t border-grid-line-dark/40 font-bold">
        <span>⚡</span> [SIG] KeyboardInterrupt (SIGINT) received
      </div>`);

      setTimeout(() => {
        playViolation();
        appendTerminalLine(`<div class="text-neutral-200">
          [INTERRUPT] Flushing model checkpoint to /tmp/ckpt_epoch12.pt...
        </div>`);

        setTimeout(() => {
          playSuccess();
          appendTerminalLine(`<div class="text-emerald-400 font-bold flex items-center gap-1">
            <span>✓</span> Checkpoint synced. Clean shutdown with exit code 130
          </div>`);

          if (p2StatusBadge) {
            p2StatusBadge.className = 'font-mono text-[9px] sm:text-[10px] tracking-wider px-2 py-0.5 border border-emerald-500/40 bg-emerald-500/10 text-emerald-400 font-bold flex items-center gap-1.5 transition-all duration-150';
          }
          if (p2BadgeDot) p2BadgeDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400';
          if (p2BadgeText) p2BadgeText.textContent = 'PASS: STATE_PRESERVED (CODE 130)';
          if (p2ExitCode) {
            p2ExitCode.className = 'text-emerald-400 font-bold';
            p2ExitCode.textContent = 'EXIT_CODE: 130 ✓';
          }
          isP2Busy = false;
        }, 280);
      }, 280);
    });

    p2BtnSigkill?.addEventListener('click', () => {
      if (isP2Busy) return;
      isP2Busy = true;
      playViolation();

      if (p2StatusBadge) {
        p2StatusBadge.className = 'font-mono text-[9px] sm:text-[10px] tracking-wider px-2 py-0.5 border border-rose-500/40 bg-rose-500/10 text-rose-400 font-bold flex items-center gap-1.5 transition-all duration-150';
      }
      if (p2BadgeDot) p2BadgeDot.className = 'w-1.5 h-1.5 rounded-full bg-rose-500 animate-ping';
      if (p2BadgeText) p2BadgeText.textContent = `PID ${currentWorkerPid}: KILLED (SIGKILL 9)`;

      appendTerminalLine(`<div class="text-rose-400 flex items-center gap-1 pt-1 border-t border-grid-line-dark/40 font-bold">
        <span>✗</span> [CHAOS] kill -9 ${currentWorkerPid} unmaskable signal delivered
      </div>`);

      setTimeout(() => {
        appendTerminalLine(`<div class="text-rose-300">
          [SUPERVISOR] Process ${currentWorkerPid} dropped unexpectedly. Reaping PID...
        </div>`);

        setTimeout(() => {
          playSuccess();
          currentWorkerPid += 1;
          appendTerminalLine(`<div class="text-emerald-400 font-bold flex items-center gap-1">
            <span>✓</span> Supervisor respawned new worker PID ${currentWorkerPid} (Zero zombie leaks)
          </div>`);

          if (p2StatusBadge) {
            p2StatusBadge.className = 'font-mono text-[9px] sm:text-[10px] tracking-wider px-2 py-0.5 border border-emerald-500/40 bg-emerald-500/10 text-emerald-400 font-bold flex items-center gap-1.5 transition-all duration-150';
          }
          if (p2BadgeDot) p2BadgeDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse';
          if (p2BadgeText) p2BadgeText.textContent = `RESPAWNED: PID ${currentWorkerPid} (ACTIVE)`;
          if (p2ExitCode) {
            p2ExitCode.className = 'text-rose-400';
            p2ExitCode.textContent = 'EXIT_CODE: 137 (KILLED)';
          }
          if (p2ZombieCount) {
            p2ZombieCount.textContent = 'ZOMBIES: 0';
          }
          isP2Busy = false;
        }, 280);
      }, 280);
    });

    // =======================================================================
    // SIMULATOR 03: MULTI-FAULT CONTRACT INJECTION
    // =======================================================================
    const p3BtnExtra = document.getElementById('p3-btn-extra');
    const p3BtnDim = document.getElementById('p3-btn-dim');
    const p3BtnNull = document.getElementById('p3-btn-null');
    const p3BtnReset = document.getElementById('p3-btn-reset');
    const p3StatusBadge = document.getElementById('p3-status-badge');
    const p3BadgeDot = document.getElementById('p3-badge-dot');
    const p3BadgeText = document.getElementById('p3-badge-text');
    const p3PayloadType = document.getElementById('p3-payload-type');
    const p3EmbeddingsLine = document.getElementById('p3-embeddings-line');
    const p3ExtraLine = document.getElementById('p3-extra-line');
    const p3ResponseCode = document.getElementById('p3-response-code');
    const p3EvalLatency = document.getElementById('p3-eval-latency');

    function resetP3Valid() {
      playSuccess();
      if (p3StatusBadge) {
        p3StatusBadge.className = 'font-mono text-[9px] sm:text-[10px] tracking-wider px-2 py-0.5 border border-emerald-500/40 bg-emerald-500/10 text-emerald-400 font-bold flex items-center gap-1.5 transition-all duration-150';
      }
      if (p3BadgeDot) p3BadgeDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400';
      if (p3BadgeText) p3BadgeText.textContent = 'PASS: 200_VALIDATED';
      if (p3PayloadType) {
        p3PayloadType.textContent = 'VALID_JSON_SCHEMA';
        p3PayloadType.className = 'text-accent font-bold';
      }
      if (p3EmbeddingsLine) {
        p3EmbeddingsLine.className = 'text-neutral-dark';
        p3EmbeddingsLine.textContent = '"embeddings": [0.182, -0.429, ... 128 items],';
      }
      if (p3ExtraLine) p3ExtraLine.className = 'hidden';
      if (p3EvalLatency) p3EvalLatency.textContent = 'LATENCY: 0.04ms';

      if (p3ResponseCode) {
        p3ResponseCode.className = 'text-emerald-400 text-[10px] block select-all whitespace-pre font-mono leading-relaxed';
        p3ResponseCode.textContent = `InferenceRequest(embeddings=[128 items])
Status: 200 OK — Strict schema verified via Rust core ✓`;
      }
    }

    p3BtnExtra?.addEventListener('click', () => {
      playViolation();
      if (p3StatusBadge) {
        p3StatusBadge.className = 'font-mono text-[9px] sm:text-[10px] tracking-wider px-2 py-0.5 border border-rose-500/40 bg-rose-500/10 text-rose-400 font-bold flex items-center gap-1.5 transition-all duration-150';
      }
      if (p3BadgeDot) p3BadgeDot.className = 'w-1.5 h-1.5 rounded-full bg-rose-500 animate-ping';
      if (p3BadgeText) p3BadgeText.textContent = 'FAIL: EXTRA_FORBIDDEN';
      if (p3PayloadType) {
        p3PayloadType.textContent = 'ILLEGAL_EXTRA_FIELD';
        p3PayloadType.className = 'text-rose-400 font-bold';
      }
      if (p3EmbeddingsLine) {
        p3EmbeddingsLine.className = 'text-neutral-dark';
        p3EmbeddingsLine.textContent = '"embeddings": [0.182, -0.429, ... 128 items],';
      }
      if (p3ExtraLine) p3ExtraLine.className = 'inline text-rose-400 bg-rose-950/40 px-1 font-bold';
      if (p3EvalLatency) p3EvalLatency.textContent = 'LATENCY: 0.02ms (REJECTED)';

      if (p3ResponseCode) {
        p3ResponseCode.className = 'text-rose-400 text-[10px] block select-all whitespace-pre font-mono leading-relaxed';
        p3ResponseCode.textContent = `ValidationError: 1 validation error for InferenceRequest
extra_param
  Extra inputs are not permitted [type=extra_forbidden, input_value='malicious_injection', input_type=str]`;
      }
    });

    p3BtnDim?.addEventListener('click', () => {
      playViolation();
      if (p3StatusBadge) {
        p3StatusBadge.className = 'font-mono text-[9px] sm:text-[10px] tracking-wider px-2 py-0.5 border border-rose-500/40 bg-rose-500/10 text-rose-400 font-bold flex items-center gap-1.5 transition-all duration-150';
      }
      if (p3BadgeDot) p3BadgeDot.className = 'w-1.5 h-1.5 rounded-full bg-rose-500 animate-ping';
      if (p3BadgeText) p3BadgeText.textContent = 'FAIL: DIMENSION_MISMATCH';
      if (p3PayloadType) {
        p3PayloadType.textContent = 'DEGENERATE_VECTOR_LENGTH';
        p3PayloadType.className = 'text-rose-400 font-bold';
      }
      if (p3ExtraLine) p3ExtraLine.className = 'hidden';
      if (p3EmbeddingsLine) {
        p3EmbeddingsLine.className = 'inline text-rose-400 bg-rose-950/40 px-1 font-bold';
        p3EmbeddingsLine.textContent = '"embeddings": [0.182, -0.429, ... 64 items ONLY], // [TOO_SHORT]';
      }
      if (p3EvalLatency) p3EvalLatency.textContent = 'LATENCY: 0.02ms (REJECTED)';

      if (p3ResponseCode) {
        p3ResponseCode.className = 'text-rose-400 text-[10px] block select-all whitespace-pre font-mono leading-relaxed';
        p3ResponseCode.textContent = `ValidationError: 1 validation error for InferenceRequest
embeddings
  List should have at least 128 items after validation, not 64 [type=too_short, input_length=64]`;
      }
    });

    p3BtnNull?.addEventListener('click', () => {
      playViolation();
      if (p3StatusBadge) {
        p3StatusBadge.className = 'font-mono text-[9px] sm:text-[10px] tracking-wider px-2 py-0.5 border border-rose-500/40 bg-rose-500/10 text-rose-400 font-bold flex items-center gap-1.5 transition-all duration-150';
      }
      if (p3BadgeDot) p3BadgeDot.className = 'w-1.5 h-1.5 rounded-full bg-rose-500 animate-ping';
      if (p3BadgeText) p3BadgeText.textContent = 'FAIL: NULL_TYPE_VIOLATION';
      if (p3PayloadType) {
        p3PayloadType.textContent = 'INVALID_NULL_TYPE';
        p3PayloadType.className = 'text-rose-400 font-bold';
      }
      if (p3ExtraLine) p3ExtraLine.className = 'hidden';
      if (p3EmbeddingsLine) {
        p3EmbeddingsLine.className = 'inline text-rose-400 bg-rose-950/40 px-1 font-bold';
        p3EmbeddingsLine.textContent = '"embeddings": null, // [STRICT_TYPE_VIOLATION]';
      }
      if (p3EvalLatency) p3EvalLatency.textContent = 'LATENCY: 0.01ms (REJECTED)';

      if (p3ResponseCode) {
        p3ResponseCode.className = 'text-rose-400 text-[10px] block select-all whitespace-pre font-mono leading-relaxed';
        p3ResponseCode.textContent = `ValidationError: 1 validation error for InferenceRequest
embeddings
  Input should be a valid list [type=list_type, input_value=None, input_type=NoneType]`;
      }
    });

    p3BtnReset?.addEventListener('click', resetP3Valid);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPrinciplesScrollytelling);
  } else {
    initPrinciplesScrollytelling();
  }
  document.addEventListener('astro:page-load', initPrinciplesScrollytelling);
</script>
