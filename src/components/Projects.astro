---
// Projects.astro (Daniele Buser exact Section 2 layout, cards, and prominent micro-interactions)
const projects = [
  {
    title: "LeakGuard-ML",
    subtitle: "Zero-Leakage Feature Store & Split Validator",
    summary:
      "A high-throughput feature verification engine that cryptographically guarantees zero data leakage across cross-validation folds and temporal training windows.",
    previewCode: `$ mlesys verify --target production-pipeline
[PASS] partition_boundary: 0.00% leakage
[PASS] tombstone_guards: temporal integrity verified
[PASS] strict_schemas: Pydantic v2 enforced
[BENCH] split_generation: 12x throughput`,
    techStack: ["Python", "PyTorch", "FastAPI", "Pydantic", "Docker"],
    metric: "0.00% Leak Guarantee",
    secondaryMetric: "12x Throughput",
    githubUrl: "https://github.com/reshandytaftazani",
  },
  {
    title: "AxiomServe",
    subtitle: "Low-Latency Supervised Inference Runtime",
    summary:
      "High-reliability asynchronous machine learning serving runtime designed with defensive child process supervision and zero-hang shutdown guarantees.",
    previewCode: `$ axiomserve --runtime onnx --workers 8
[INIT] worker_pool initialized in shared memory
[SIGNAL] POSIX SIGTERM handler registered
[PASS] p99_latency: 3.82ms | throughput: 14.2k req/s
[STATUS] zero zombie processes on exit`,
    techStack: ["FastAPI", "C++", "ONNX", "Linux", "Docker"],
    metric: "p99 < 3.8ms Latency",
    secondaryMetric: "Zero Zombie Procs",
    githubUrl: "https://github.com/reshandytaftazani",
  },
  {
    title: "SynthDist-Engine",
    subtitle: "Degenerate Distribution & TDD Chaos Harness",
    summary:
      "Property-based testing and synthetic anomaly generator specifically built to verify machine learning models against extreme distribution shifts and malformed inputs.",
    previewCode: `$ pytest tests/fuzz/ --coverage
[GENERATE] 10,000 degenerate distribution edge cases
[PASS] empty_tensor_handling: ok
[PASS] zero_variance_covariance: defended
[STATUS] 100% boundary isolation verified`,
    techStack: ["Python", "NumPy", "scikit-learn", "Pytest", "Hypothesis"],
    metric: "10,000+ Fuzz Cases/s",
    secondaryMetric: "OS Sandboxed",
    githubUrl: "https://github.com/reshandytaftazani",
  },
  {
    title: "HexaML Core",
    subtitle: "Clean Architecture Engine for ML Systems",
    summary:
      "Production-ready Hexagonal (Ports & Adapters) architecture template isolating core ML domain algorithms from transport protocols and persistence engines.",
    previewCode: `$ python -m hexaml.verify_contracts
class InferenceRequest(BaseModel):
    model_config = ConfigDict(strict=True, extra="forbid")
    tensor_id: UUID4
    features: Annotated[list[float], Field(min_length=64)]
[STATUS] zero framework deps in domain layer`,
    techStack: ["Python", "Clean Arch", "Pydantic", "SQLAlchemy", "Docker"],
    metric: "Zero Framework Lock-in",
    secondaryMetric: "< 0.4ms Contract Check",
    githubUrl: "https://github.com/reshandytaftazani",
  },
];
---

<section id="projects" class="relative z-10 flex w-full flex-col pt-24 pb-36" aria-labelledby="projects-list-heading">
  
  <!-- Section Heading (Daniele Buser text-caption / text-body uppercase) -->
  <div class="reveal-init flex items-center justify-between border-b border-grid-line-light pb-4">
    <h2 class="text-caption md:text-body uppercase text-neutral-dark font-mono tracking-wider" id="projects-list-heading">
      SELECTED WORKS
    </h2>
    <span class="text-caption font-mono text-neutral-dark font-semibold">
      [04 SYSTEMS]
    </span>
  </div>

  <!-- 12-Column Grid (Daniele Buser exact 2-column on desktop) -->
  <div class="mt-6 grid w-full grid-cols-12 gap-6 lg:gap-8">
    {projects.map((proj, idx) => (
      <div class="reveal-init col-span-12 flex w-full flex-col lg:col-span-6" style={`transition-delay: ${idx * 120}ms;`}>
        <a 
          data-project-card="true" 
          class="group bg-card-dark focus-visible:outline-foreground flex w-full flex-col p-4 pb-8 focus-visible:outline-2 focus-visible:outline-offset-4 border border-transparent hover:border-neutral-dark/50 hover:-translate-y-1 hover:shadow-[0_20px_45px_rgba(0,0,0,0.55)] transition-all duration-300 ease-out" 
          aria-label={`Project: ${proj.title}`} 
          href={proj.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <!-- Aspect container with Code/Telemetry showcase and prominent micro-interactions -->
          <div class="relative aspect-4/3 w-full overflow-hidden select-none bg-black border border-grid-line-dark group-hover:border-neutral-dark/60 transition-colors duration-300 p-4 flex flex-col justify-between font-mono text-xs">
            
            <!-- Header bar inside card with prominent SOURCE pill -->
            <div class="flex items-center justify-between text-caption text-neutral-dark border-b border-grid-line-dark pb-2.5">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-accent group-hover:scale-125 transition-transform duration-300"></span>
                <span class="text-foreground uppercase font-bold tracking-tight text-xs">{proj.title}</span>
              </div>
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-sm bg-white/10 group-hover:bg-accent group-hover:text-white text-neutral transition-all duration-200">
                <span class="font-bold text-[11px] tracking-wider">SOURCE</span>
                <span class="text-accent group-hover:text-white transition-transform duration-200 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5 font-bold">↗</span>
              </div>
            </div>

            <!-- Terminal code preview block with hover scaling -->
            <pre class="text-neutral text-[11px] leading-relaxed my-auto overflow-x-hidden transition-transform duration-500 ease-out group-hover:scale-[1.025]">
              <code>{proj.previewCode}</code>
            </pre>

            <!-- Card Bottom Telemetry -->
            <div class="flex items-center justify-between pt-2.5 border-t border-grid-line-dark text-[10px] uppercase">
              <span class="text-accent font-bold group-hover:scale-105 transition-transform duration-200 origin-left inline-block">{proj.metric}</span>
              <span class="text-neutral-dark group-hover:text-foreground font-semibold transition-colors duration-200">{proj.secondaryMetric}</span>
            </div>
          </div>

          <!-- Bottom description & tags (Daniele Buser exact card layout) -->
          <div class="text-foreground mt-6 flex items-start justify-between gap-4 sm:mt-8">
            <div class="min-w-0 flex-1">
              <h3 class="text-section min-w-0 flex-1 font-bold text-foreground group-hover:text-accent group-hover:translate-x-1 transition-all duration-300">
                {proj.title}
              </h3>
              <p class="text-body text-neutral mt-1 line-clamp-2 leading-relaxed">
                {proj.summary}
              </p>
            </div>
            <div class="flex shrink-0 flex-col items-end gap-1">
              {proj.techStack.map((tech) => (
                <span class="text-caption md:text-body uppercase text-neutral group-hover:text-foreground/90 transition-colors duration-200 font-mono font-medium">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </a>
      </div>
    ))}
  </div>

</section>
