---
// Projects.astro (Daniele Buser exact Section 2 layout with real projects, spotlight flagship layout, and grounded copy)
const projects = [
  {
    id: "modelarena",
    category: "MACHINE LEARNING",
    title: "ModelArena",
    subtitle: "Dynamic Resource Allocation & Multi-Agent Training Framework",
    summary:
      "Competitive multi-agent learning ecosystem that dynamically allocates compute and memory quotas across heterogeneous models based on real-time loss trajectory.",
    isWip: true,
    progressText: "20/28 TASKS // 71%",
    progressBar: "[███████░░░]",
    runCommand: "python main.py --arena --agents 4",
    previewCode: `$ python main.py --arena --agents 4
[ARENA] initializing 4 heterogeneous agent workers
[EVAL] step 120: Agent_A relative loss gradient: +0.42
[ALLOC] reallocating +40% shared memory pool -> Agent_A
[STATUS] 20/28 milestone tasks verified [███████░░░] 71%`,
    techStack: ["PyTorch", "Transformers", "CUDA", "Multi-Agent", "Python"],
    metric: "20/28 Tasks Completed",
    secondaryMetric: "Dynamic Memory Alloc",
    githubUrl: "https://github.com/reshandytaftazani/modelarena",
  },
  {
    id: "finance-tracker",
    category: "SYSTEMS & DATA",
    title: "Finance Tracker",
    subtitle: "Defensive Personal Accounting Engine & Transaction Ledger",
    summary:
      "Double-entry accounting engine built with fixed-point decimal arithmetic and SQLite WAL transactions to guarantee balance integrity and zero floating-point drift.",
    isWip: false,
    progressText: "PRODUCTION // VERIFIED",
    progressBar: "[██████████] 100%",
    runCommand: "python -m ledger.cli sync --audit",
    previewCode: `$ python -m ledger.cli sync --audit
[INGEST] 50,000 transaction records scanned
[ASSERT] debit_sum == credit_sum: $0.00 drift
[ACID] atomic WAL journal commit: 4.12ms
[STATUS] 100% ledger invariant verified`,
    techStack: ["Python", "FastAPI", "SQLite", "Pydantic v2", "Docker"],
    metric: "100% Balanced Ledger",
    secondaryMetric: "Zero Float Drift",
    githubUrl: "https://github.com/reshandytaftazani/finance-tracker",
  },
  {
    id: "savebite",
    category: "PLATFORM & WEB",
    title: "SaveBite",
    subtitle: "Surplus Food Rescue & Distribution Platform",
    summary:
      "Coursework platform developed for Pemrograman Berbasis Platform (PBP CS UI) coordinating surplus food rescue between commercial donors and beneficiaries.",
    isWip: false,
    progressText: "COURSEWORK // COMPLETED",
    progressBar: "[██████████] 100%",
    runCommand: "python manage.py runserver",
    previewCode: `$ python manage.py runserver
[PBP-UI] SaveBite core cluster active on :8000
[AUTH] session token & CSRF security verified
[API] food listing claim endpoint: 48ms p95
[STATUS] PBP CS UI capstone evaluated`,
    techStack: ["Django", "Python", "Flutter", "PostgreSQL", "REST API"],
    metric: "PBP Fasilkom UI '25",
    secondaryMetric: "RESTful Architecture",
    githubUrl: "https://github.com/PBP-D-Kelompok-8/SaveBite",
  },
];

const categories = ["ALL", "MACHINE LEARNING", "SYSTEMS & DATA", "PLATFORM & WEB"];
---

<section id="projects" class="relative z-10 flex w-full flex-col pt-24 pb-36" aria-labelledby="projects-list-heading">
  
  <!-- Section Heading (Daniele Buser text-caption / text-body uppercase) -->
  <div class="reveal-init flex flex-col sm:flex-row sm:items-center justify-between border-b border-grid-line-light pb-4 gap-4">
    <div class="flex items-center gap-3">
      <h2 class="text-caption md:text-body uppercase text-neutral-dark font-mono tracking-wider" id="projects-list-heading">
        SELECTED WORKS
      </h2>
      <span class="text-caption font-mono text-neutral-dark font-semibold">
        [03 SYSTEMS]
      </span>
    </div>

    <!-- Swiss Category Filter Pills -->
    <div class="flex flex-wrap items-center gap-2 font-mono text-[11px]" role="tablist" aria-label="Project filter categories">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-project-filter={cat}
          class={`filter-btn px-2.5 py-1 rounded-xs border transition-all duration-200 cursor-pointer select-none font-semibold ${
            idx === 0 
              ? "active bg-background text-foreground border-background" 
              : "border-neutral-300 text-neutral-dark hover:border-accent hover:text-background bg-white/60"
          }`}
          role="tab"
          aria-selected={idx === 0 ? "true" : "false"}
        >
          {cat === "ALL" ? `ALL [03]` : cat}
        </button>
      ))}
    </div>
  </div>

  <!-- 12-Column Grid (Flagship Spotlight #01 + Balanced 6-Column Cards) -->
  <div class="mt-8 grid w-full grid-cols-12 gap-6 lg:gap-8" id="projects-grid">
    {projects.map((proj, idx) => (
      <div 
        class={`reveal-init col-span-12 flex w-full flex-col ${idx === 0 ? "lg:col-span-12" : "lg:col-span-6"} project-card-wrapper transition-opacity duration-300`} 
        data-category={proj.category}
        style={`transition-delay: ${idx * 120}ms;`}
      >
        <a 
          href={`/projects/${proj.id}`}
          data-project-card="true" 
          class="group bg-card-dark focus-visible:outline-foreground flex w-full flex-col p-4 pb-8 focus-visible:outline-2 focus-visible:outline-offset-4 border border-transparent hover:border-neutral-dark/50 hover:-translate-y-1 hover:shadow-[0_20px_45px_rgba(0,0,0,0.55)] transition-all duration-300 ease-out cursor-pointer block no-underline" 
          aria-label={`Project: ${proj.title} - View full architectural case study`}
        >
          <!-- Aspect container with Code/Telemetry showcase and prominent micro-interactions -->
          <div class={`relative ${idx === 0 ? "aspect-16/9 lg:aspect-[2.4/1]" : "aspect-4/3"} w-full overflow-hidden select-none bg-black border border-grid-line-dark group-hover:border-neutral-dark/60 transition-colors duration-300 p-4 flex flex-col justify-between font-mono text-xs`}>
            
            <!-- Header bar inside card with SPEC, RUN & SOURCE pills -->
            <div class="flex items-center justify-between text-caption text-neutral-dark border-b border-grid-line-dark pb-2.5">
              <div class="flex items-center gap-2">
                <span class={`w-2.5 h-2.5 rounded-full ${proj.isWip ? "bg-accent animate-pulse" : "bg-accent"} group-hover:scale-125 transition-transform duration-300`}></span>
                <span class="text-foreground uppercase font-bold tracking-tight text-xs">{proj.title}</span>
                {proj.isWip && (
                  <span class="hidden sm:inline-block px-1.5 py-0.5 rounded-xs bg-accent/20 border border-accent/40 text-accent font-bold text-[10px] tracking-wider">
                    {proj.progressText}
                  </span>
                )}
              </div>
              
              <div class="flex items-center gap-2">
                <!-- Interactive Quick-Run Copy Micro-interaction -->
                <button 
                  type="button" 
                  class="copy-run-cmd-btn group/cmd inline-flex items-center gap-1 px-2 py-0.5 rounded-xs bg-white/5 hover:bg-accent text-neutral hover:text-black font-mono text-[10px] font-bold transition-all duration-200 cursor-pointer"
                  data-run-cmd={proj.runCommand}
                  onclick="event.preventDefault(); event.stopPropagation();"
                  title={`Copy command: ${proj.runCommand}`}
                  aria-label={`Copy run command for ${proj.title}`}
                >
                  <span class="text-accent group-hover/cmd:text-black font-bold transition-colors duration-200">$</span>
                  <span class="cmd-label">RUN</span>
                </button>

                {proj.id === 'modelarena' && (
                  <button 
                    type="button"
                    class="group/sim inline-flex items-center gap-1.5 px-2.5 py-1 rounded-xs bg-[#ff4500] hover:bg-white text-black font-mono font-bold text-[11px] tracking-wider transition-all duration-200 cursor-pointer select-none active:scale-95 shadow-2xs"
                    data-navigate-curtain="/projects/modelarena#interactive-simulator"
                    onclick="event.preventDefault(); event.stopPropagation(); if (window.navigateWithCurtain) { window.navigateWithCurtain('/projects/modelarena#interactive-simulator'); } else { window.location.href='/projects/modelarena#interactive-simulator'; }"
                    title="Run live in-browser VRAM simulation"
                    aria-label="Open live VRAM simulation for ModelArena"
                  >
                    <span class="text-[9px]">►</span>
                    <span>SIM</span>
                  </button>
                )}

                <!-- Spec Button Pill (triggers quick modal) -->
                <button 
                  type="button"
                  data-open-spec={proj.id}
                  onclick="event.preventDefault(); event.stopPropagation();"
                  class="group/spec inline-flex items-center gap-1.5 px-3 py-1 rounded-xs bg-accent/15 hover:bg-accent text-accent hover:text-black border border-accent/40 hover:border-accent font-mono font-bold text-[11px] tracking-wider transition-all duration-200 cursor-pointer select-none active:scale-95 shadow-2xs"
                  title={`Open quick spec modal for ${proj.title}`}
                  aria-label={`Quick spec sheet for ${proj.title}`}
                >
                  <span>SPEC</span>
                  <span class="font-bold text-xs transition-all duration-200 group-hover/spec:text-black group-hover/spec:translate-x-0.5 group-hover/spec:-translate-y-0.5">↗</span>
                </button>

                <!-- Direct GitHub link -->
                <button 
                  type="button"
                  class="group/src inline-flex items-center gap-1.5 px-3 py-1 rounded-xs bg-white/10 hover:bg-white text-neutral-300 hover:text-black border border-white/15 hover:border-white font-mono font-bold text-[11px] tracking-wider transition-all duration-200 cursor-pointer select-none active:scale-95 shadow-2xs"
                  onclick={`event.preventDefault(); event.stopPropagation(); window.open('${proj.githubUrl}', '_blank', 'noopener,noreferrer');`}
                  aria-label={`Open ${proj.title} source code on GitHub`}
                  title={`View ${proj.title} source code on GitHub`}
                >
                  <span>SOURCE</span>
                  <span class="text-accent group-hover/src:text-black font-bold text-xs transition-transform duration-200 group-hover/src:translate-x-0.5 group-hover/src:-translate-y-0.5">↗</span>
                </button>
              </div>
            </div>

            <!-- Terminal code preview block with hover scaling -->
            <pre class="text-neutral text-[11px] leading-relaxed my-auto overflow-x-hidden transition-transform duration-500 ease-out group-hover:scale-[1.02] select-text">
              <code>{proj.previewCode}</code>
            </pre>

            <!-- Card Bottom Telemetry -->
            <div class="flex items-center justify-between pt-2.5 border-t border-grid-line-dark text-[10px] uppercase">
              <span class="text-accent font-bold group-hover:scale-105 transition-transform duration-200 origin-left inline-block">{proj.metric}</span>
              <span class="text-neutral-dark group-hover:text-foreground font-semibold transition-colors duration-200">
                {proj.isWip ? `${proj.progressBar} ${proj.secondaryMetric}` : proj.secondaryMetric}
              </span>
            </div>
          </div>

          <!-- Bottom description & tags (Daniele Buser exact card layout) -->
          <div class="text-foreground mt-6 flex items-start justify-between gap-4 sm:mt-8">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-3.5 group-hover:translate-x-1.5 transition-transform duration-300 ease-out">
                <h3 class="text-section min-w-0 font-bold text-foreground group-hover:text-accent transition-colors duration-200">
                  {proj.title}
                </h3>
                <span class="text-[10px] font-mono font-semibold px-2.5 py-0.5 rounded-xs bg-white/5 border border-white/10 text-neutral-400 group-hover:text-accent group-hover:border-accent/40 group-hover:bg-accent/10 transition-all duration-200">
                  [{proj.category}]
                </span>
                {proj.isWip && (
                  <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-xs bg-accent/20 border border-accent/40 text-accent">
                    {proj.progressText}
                  </span>
                )}
              </div>
              <p class="text-body text-neutral mt-2 line-clamp-2 leading-relaxed">
                {proj.summary}
              </p>
            </div>
            <div class="flex shrink-0 flex-col items-end gap-1">
              {proj.techStack.map((tech) => (
                <span class="text-caption md:text-body uppercase text-neutral group-hover:text-foreground/90 transition-colors duration-200 font-mono font-medium">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </a>
      </div>
    ))}
  </div>

  <!-- Complete Directory & Archive Callout -->
  <div class="reveal-init mt-12 flex flex-col sm:flex-row items-center justify-between border-t border-grid-line-light pt-8 gap-4 font-mono">
    <div class="flex items-center gap-2.5 text-caption text-neutral-dark">
      <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
      <span>HIGHLIGHTED SELECTION (03)</span>
      <span class="opacity-40">•</span>
      <span class="text-neutral-dark hover:text-foreground transition-colors">FULL REPOSITORY DIRECTORY AVAILABLE</span>
    </div>

    <a 
      href="/projects" 
      class="group inline-flex items-center gap-2 px-5 py-2.5 rounded-sm bg-background hover:bg-accent text-foreground hover:text-black font-bold text-caption uppercase tracking-wider transition-all duration-200 shadow-sm active:scale-95 cursor-pointer select-none"
      title="View complete engineering projects directory and archive"
    >
      <span>VIEW ALL PROJECTS &amp; ARCHIVE</span>
      <span class="text-accent group-hover:text-black font-bold text-sm transition-transform duration-200 group-hover:translate-x-1">→</span>
    </a>
  </div>

</section>

<!-- Filter Tabs & Quick-Copy Logic -->
<script>
  function setupProjectInteractions() {
    // 1. Filter Tabs
    const filterBtns = document.querySelectorAll<HTMLButtonElement>("[data-project-filter]");
    const cards = document.querySelectorAll<HTMLElement>(".project-card-wrapper");

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetCategory = btn.getAttribute("data-project-filter");

        filterBtns.forEach((b) => {
          b.classList.remove("active", "bg-background", "text-foreground", "border-background");
          b.classList.add("border-neutral-300", "text-neutral-dark", "bg-white/60");
          b.setAttribute("aria-selected", "false");
        });
        btn.classList.add("active", "bg-background", "text-foreground", "border-background");
        btn.classList.remove("border-neutral-300", "text-neutral-dark", "bg-white/60");
        btn.setAttribute("aria-selected", "true");

        cards.forEach((card) => {
          const category = card.getAttribute("data-category");
          if (targetCategory === "ALL" || category === targetCategory) {
            card.style.display = "flex";
            requestAnimationFrame(() => {
              card.style.opacity = "1";
              card.style.transform = "scale(1)";
            });
          } else {
            card.style.opacity = "0";
            card.style.transform = "scale(0.96)";
            setTimeout(() => {
              if (btn.getAttribute("data-project-filter") !== "ALL" && category !== targetCategory) {
                card.style.display = "none";
              }
            }, 200);
          }
        });
      });
    });

    // 2. Quick Run Command Copy Micro-interaction
    document.querySelectorAll<HTMLButtonElement>(".copy-run-cmd-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const cmd = btn.getAttribute("data-run-cmd");
        const label = btn.querySelector(".cmd-label");
        if (!cmd || !label) return;

        navigator.clipboard.writeText(cmd).then(() => {
          const originalText = label.textContent;
          label.textContent = "COPIED ✓";
          btn.classList.add("bg-accent", "text-black");

          setTimeout(() => {
            label.textContent = originalText;
            btn.classList.remove("bg-accent", "text-black");
          }, 2000);
        });
      });
    });

    // 3. Keyboard Enter/Space to open spec on cards
    document.querySelectorAll<HTMLElement>("[data-open-spec]").forEach((card) => {
      card.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          card.click();
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupProjectInteractions);
  } else {
    setupProjectInteractions();
  }
  document.addEventListener("astro:page-load", setupProjectInteractions);
</script>
