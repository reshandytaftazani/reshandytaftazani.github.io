---
// Contact.astro (Daniele Buser exact Section 3 "Say Hello." layout with tactile Quick-Copy Email & easter egg dot micro-interactions)
---

<section id="contacts" class="w-full bg-background text-foreground relative flex min-h-dvh flex-col justify-center px-4 sm:px-6 lg:px-8 border-t border-grid-line-dark">
  <div class="relative mx-auto flex w-full max-w-[120rem] flex-1 flex-col justify-center py-20 md:py-28">
    
    <!-- Dark Grid Lines for Contact Section -->
    <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
      <div class="grid size-full grid-cols-4 gap-4 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-10 xl:grid-cols-12">
        <div class="relative h-full border-x border-solid border-grid-line-dark"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark hidden sm:block"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark hidden sm:block"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark hidden md:block"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark hidden md:block"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark hidden lg:block"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark hidden lg:block"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark hidden xl:block"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark hidden xl:block"></div>
      </div>
    </div>

    <div class="relative z-10 flex flex-col gap-16 md:gap-24">
      
      <!-- Giant Heading (Daniele Buser Say Hello. text-display-xl with interactive period dot) -->
      <div class="space-y-2">
        <h2 class="reveal-hero text-display-xl text-foreground leading-[0.92] tracking-tight md:leading-[0.85] select-none" aria-label="Say Hello - Contact section heading">
          Say <br class="md:hidden"/>Hello<span 
            id="contact-period-dot" 
            class="text-accent inline-block hover:scale-125 active:scale-90 transition-transform duration-200 cursor-pointer select-none" 
            title="Click for Depok ping"
            aria-label="Interactive orange accent dot"
          >.</span>
        </h2>
        <div id="dot-ping-badge" class="font-mono text-caption text-accent opacity-0 transition-opacity duration-300 h-4">
          [SIGNAL // DEPOK_WIB ACTIVE]
        </div>
      </div>

      <!-- Sub-grid with narrative & large clickable email -->
      <div class="grid w-full grid-cols-4 items-start gap-8 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-10 xl:grid-cols-12">
        
        <!-- Left narrative paragraph (text-section) -->
        <div class="reveal-init col-span-4 sm:col-span-5 md:col-span-6 lg:col-span-5 space-y-4" style="transition-delay: 150ms;">
          <p class="text-section leading-snug font-normal text-neutral">
            Interested in machine learning systems, reproducible data pipelines, or prospective engineering roles? Feel free to reach out.
          </p>
          <p class="text-caption font-mono text-neutral-dark">
            Faculty of Computer Science, <a href="https://cs.ui.ac.id/" target="_blank" rel="noopener noreferrer" class="group text-neutral hover:text-accent underline underline-offset-4 decoration-accent/60 hover:decoration-accent transition-colors">Universitas Indonesia</a> (Depok, West Java).
          </p>
        </div>

        <!-- Right big email & professional links -->
        <div class="reveal-init col-span-4 sm:col-span-6 md:col-span-8 lg:col-span-5 lg:col-start-6 xl:col-span-6 xl:col-start-7 lg:justify-self-start" style="transition-delay: 250ms;">
          
          <a 
            href="mailto:reshandy.taftazani@ui.ac.id" 
            class="group relative inline-block max-w-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent pb-1" 
            aria-label="Send email to reshandy.taftazani@ui.ac.id"
          >
            <h3 class="text-display-sm text-foreground group-hover:text-accent transition-colors duration-300 font-bold tracking-tight">
              reshandy.taftazani<wbr/>@ui.ac.id
            </h3>
            <!-- Prominent Swiss sweep underline micro-interaction -->
            <span class="absolute bottom-0 left-0 w-full h-[2.5px] bg-accent scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-out" aria-hidden="true"></span>
          </a>

          <!-- Tactile Swiss Quick-Copy Button -->
          <div class="mt-4 flex items-center gap-3">
            <button 
              type="button" 
              id="copy-email-btn"
              class="group relative inline-flex items-center gap-2 px-3.5 py-1.5 rounded-sm border border-neutral-dark/40 hover:border-accent bg-card-dark hover:bg-accent text-neutral hover:text-black font-mono font-bold text-caption transition-all duration-300 shadow-sm cursor-pointer select-none active:scale-95"
              aria-label="Copy email address to clipboard"
            >
              <span class="text-neutral-dark group-hover:text-black transition-transform duration-200 group-hover:-translate-x-0.5">[</span>
              <span id="copy-btn-label" class="text-foreground group-hover:text-black tracking-wider transition-colors duration-200">COPY ADDRESS</span>
              <span id="copy-btn-icon" class="text-accent group-hover:text-black font-bold text-xs transition-transform duration-200">📋</span>
              <span class="text-neutral-dark group-hover:text-black transition-transform duration-200 group-hover:translate-x-0.5">]</span>
            </button>
            
            <span id="copy-feedback-sr" class="sr-only" aria-live="polite"></span>
            <span class="text-[11px] font-mono text-neutral-dark hidden sm:inline">DEP-WIB // FAST RESPONSE</span>
          </div>

          <!-- Professional Links (High-visibility Swiss micro-interactions & directional arrow leap) -->
          <nav class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 text-body md:text-body-lg font-medium" aria-label="Social and professional links">
            <a 
              href="https://linkedin.com/in/reshandy-taftazani-aulya" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group relative inline-flex items-center gap-1.5 py-1 text-foreground hover:text-accent transition-colors duration-200"
            >
              <span class="relative">
                <span>LinkedIn</span>
                <span class="absolute -bottom-0.5 left-0 w-full h-[1.5px] bg-accent scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-out" aria-hidden="true"></span>
              </span>
              <span class="text-accent font-bold text-sm transition-transform duration-200 ease-out group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
            </a>

            <span class="text-neutral-dark/80 select-none" aria-hidden="true">|</span>

            <a 
              href="https://github.com/reshandytaftazani" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group relative inline-flex items-center gap-1.5 py-1 text-foreground hover:text-accent transition-colors duration-200"
            >
              <span class="relative">
                <span>GitHub</span>
                <span class="absolute -bottom-0.5 left-0 w-full h-[1.5px] bg-accent scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-out" aria-hidden="true"></span>
              </span>
              <span class="text-accent font-bold text-sm transition-transform duration-200 ease-out group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
            </a>

            <span class="text-neutral-dark/80 select-none" aria-hidden="true">|</span>

            <a 
              href="https://cs.ui.ac.id/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group relative inline-flex items-center gap-1.5 py-1 text-foreground hover:text-accent transition-colors duration-200"
            >
              <span class="relative">
                <span>Universitas Indonesia</span>
                <span class="absolute -bottom-0.5 left-0 w-full h-[1.5px] bg-accent scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-out" aria-hidden="true"></span>
              </span>
              <span class="text-accent font-bold text-sm transition-transform duration-200 ease-out group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
            </a>
          </nav>
        </div>

      </div>

    </div>

  </div>
</section>

<!-- Tactile Copy Email & Period Ping Script -->
<script>
  function setupContactInteractions() {
    // 1. Copy Email
    const copyBtn = document.getElementById("copy-email-btn");
    const label = document.getElementById("copy-btn-label");
    const icon = document.getElementById("copy-btn-icon");
    const srFeedback = document.getElementById("copy-feedback-sr");

    if (copyBtn && label && icon) {
      const emailAddress = "reshandy.taftazani@ui.ac.id";
      let resetTimeout: NodeJS.Timeout | null = null;

      copyBtn.addEventListener("click", () => {
        navigator.clipboard.writeText(emailAddress).then(() => {
          if (resetTimeout) clearTimeout(resetTimeout);

          label.textContent = "COPIED TO CLIPBOARD";
          icon.textContent = "✓";
          copyBtn.classList.remove("bg-card-dark", "text-neutral");
          copyBtn.classList.add("bg-accent", "text-black", "border-accent");
          if (srFeedback) srFeedback.textContent = "Email address copied to clipboard";

          resetTimeout = setTimeout(() => {
            label.textContent = "COPY ADDRESS";
            icon.textContent = "📋";
            copyBtn.classList.remove("bg-accent", "text-black", "border-accent");
            copyBtn.classList.add("bg-card-dark", "text-neutral");
            if (srFeedback) srFeedback.textContent = "";
          }, 2500);
        });
      });
    }

    // 2. Period Dot Micro-interaction
    const dot = document.getElementById("contact-period-dot");
    const badge = document.getElementById("dot-ping-badge");
    if (dot && badge) {
      dot.addEventListener("click", () => {
        badge.classList.remove("opacity-0");
        badge.classList.add("opacity-100");
        setTimeout(() => {
          badge.classList.remove("opacity-100");
          badge.classList.add("opacity-0");
        }, 2000);
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupContactInteractions);
  } else {
    setupContactInteractions();
  }
  document.addEventListener("astro:page-load", setupContactInteractions);
</script>
