---
// Contact.astro (Daniele Buser exact Section 3 "Say Hello." layout with perfectly aligned email & rich micro-interactions)
---

<section id="contacts" class="bg-background text-foreground relative -mx-4 sm:-mx-6 lg:-mx-8 flex min-h-dvh flex-col justify-center px-4 sm:px-6 lg:px-8 border-t border-grid-line-dark">
  <div class="relative mx-auto flex w-full max-w-[120rem] flex-1 flex-col justify-center py-20 md:py-28">
    
    <!-- Dark Grid Lines for Contact Section -->
    <div class="pointer-events-none absolute inset-0 z-0" aria-hidden="true">
      <div class="grid size-full grid-cols-4 gap-4 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-10 xl:grid-cols-12">
        <div class="relative h-full border-x border-solid border-grid-line-dark"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark hidden sm:block"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark hidden sm:block"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark hidden md:block"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark hidden md:block"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark hidden lg:block"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark hidden lg:block"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark hidden xl:block"></div>
        <div class="relative h-full border-x border-solid border-grid-line-dark hidden xl:block"></div>
      </div>
    </div>

    <div class="relative z-10 flex flex-col gap-16 md:gap-24">
      
      <!-- Giant Heading (Daniele Buser Say Hello. text-display-xl) -->
      <h2 class="reveal-hero text-display-xl text-foreground leading-[0.92] tracking-tight md:leading-[0.85] select-none" aria-label="Say Hello - Contact section heading">
        Say <br class="md:hidden"/>Hello<span class="text-accent inline-block hover:scale-125 transition-transform duration-300 cursor-pointer" aria-hidden="true">.</span>
      </h2>

      <!-- Sub-grid with narrative & large clickable email -->
      <div class="grid w-full grid-cols-4 items-start gap-8 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-10 xl:grid-cols-12">
        
        <!-- Left narrative paragraph (text-section) -->
        <div class="reveal-init col-span-4 sm:col-span-5 md:col-span-6 lg:col-span-5 space-y-4" style="transition-delay: 150ms;">
          <p class="text-section leading-snug font-normal text-neutral">
            Interested in leak-free machine learning pipelines, verified process boundaries, or prospective engineering roles? Feel free to reach out.
          </p>
          <p class="text-caption font-mono text-neutral-dark">
            Faculty of Computer Science, <a href="https://cs.ui.ac.id/" target="_blank" rel="noopener noreferrer" class="group text-neutral hover:text-accent underline underline-offset-4 decoration-accent/60 hover:decoration-accent transition-colors">Universitas Indonesia</a> (Depok, West Java).
          </p>
        </div>

        <!-- Right big email & professional links (adjusted alignment to eliminate right-edge cramming) -->
        <div class="reveal-init col-span-4 sm:col-span-6 md:col-span-8 lg:col-span-5 lg:col-start-6 xl:col-span-6 xl:col-start-7 lg:justify-self-start" style="transition-delay: 250ms;">
          <a 
            href="mailto:reshandy.taftazani@ui.ac.id" 
            class="group relative inline-block max-w-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent pb-1" 
            aria-label="Send email to reshandy.taftazani@ui.ac.id"
          >
            <h3 class="text-display-sm text-foreground group-hover:text-accent transition-colors duration-300 font-bold tracking-tight">
              reshandy.taftazani<wbr/>@ui.ac.id
            </h3>
            <!-- Prominent Swiss sweep underline micro-interaction -->
            <span class="absolute bottom-0 left-0 w-full h-[2.5px] bg-accent scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-out" aria-hidden="true"></span>
          </a>

          <!-- Professional Links (High-visibility Swiss micro-interactions & directional arrow leap) -->
          <nav class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 text-body md:text-body-lg font-medium" aria-label="Social and professional links">
            <a 
              href="https://linkedin.com/in/reshandy-taftazani-aulya" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group relative inline-flex items-center gap-1.5 py-1 text-foreground hover:text-accent transition-colors duration-200"
            >
              <span class="relative">
                <span>LinkedIn</span>
                <span class="absolute -bottom-0.5 left-0 w-full h-[1.5px] bg-accent scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-out" aria-hidden="true"></span>
              </span>
              <span class="text-accent font-bold text-sm transition-transform duration-200 ease-out group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
            </a>

            <span class="text-neutral-dark/80 select-none" aria-hidden="true">|</span>

            <a 
              href="https://github.com/reshandytaftazani" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group relative inline-flex items-center gap-1.5 py-1 text-foreground hover:text-accent transition-colors duration-200"
            >
              <span class="relative">
                <span>GitHub</span>
                <span class="absolute -bottom-0.5 left-0 w-full h-[1.5px] bg-accent scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-out" aria-hidden="true"></span>
              </span>
              <span class="text-accent font-bold text-sm transition-transform duration-200 ease-out group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
            </a>

            <span class="text-neutral-dark/80 select-none" aria-hidden="true">|</span>

            <a 
              href="https://cs.ui.ac.id/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group relative inline-flex items-center gap-1.5 py-1 text-foreground hover:text-accent transition-colors duration-200"
            >
              <span class="relative">
                <span>Universitas Indonesia</span>
                <span class="absolute -bottom-0.5 left-0 w-full h-[1.5px] bg-accent scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-out" aria-hidden="true"></span>
              </span>
              <span class="text-accent font-bold text-sm transition-transform duration-200 ease-out group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
            </a>
          </nav>
        </div>

      </div>

    </div>

  </div>
</section>
