---
// Navbar.astro (Daniele Buser Swiss Responsive Header: Un-clipped flex layout, tactile mobile drawer, live clock & scrollspy)
const navLinks = [
  { id: "projects", name: "PROJECTS", href: "/#projects", num: "01" },
  { id: "notes", name: "NOTES", href: "/notes", num: "02" },
  { id: "experience", name: "TRACK", href: "/#experience", num: "03" },
  { id: "principles", name: "PRINCIPLES", href: "/#principles", num: "04" },
  { id: "skills", name: "STACK", href: "/#skills", num: "05" },
  { id: "contacts", name: "CONTACTS", href: "/#contacts", num: "06" },
];
---

<!-- Fixed mix-blend-difference Navigation Bar (Fluid Flex layout preventing any truncation) -->
<header class="pointer-events-none fixed top-0 left-1/2 z-30 w-full max-w-[120rem] -translate-x-1/2 p-4 sm:px-6 lg:px-8 mix-blend-difference">
  <div class="flex w-full items-center justify-between gap-4">
    
    <!-- Left: Identity & Role with Master Swiss 'RT' Monogram -->
    <div class="pointer-events-auto flex shrink-0 items-center">
      <a 
        id="brand-home-link"
        data-trigger-transition="true"
        class="flex w-fit items-center gap-3 select-none group cursor-pointer" 
        aria-label="Reshandy Taftazani - ML & Systems Engineer" 
        href="/"
      >
        <!-- Master Geometric 'RT' Monogram Hallmark Badge -->
        <div class="relative shrink-0 flex items-center justify-center w-8 h-8 md:w-9 md:h-9 bg-[#0a0a0a] border border-[#262626] group-hover:border-[#ff4500] transition-all duration-300 shadow-sm shadow-black overflow-hidden select-none">
          <!-- Top-Left & Bottom-Right Corner Crosshairs -->
          <span class="absolute top-0 left-0 w-1.5 h-1.5 border-t border-l border-[#ff4500] pointer-events-none"></span>
          <span class="absolute bottom-0 right-0 w-1.5 h-1.5 border-b border-r border-[#ff4500] pointer-events-none"></span>

          <!-- Inline Monogram SVG -->
          <svg class="w-5 h-5 md:w-5.5 md:h-5.5 block" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <!-- Letter 'R': Vertical Stem -->
            <rect x="12" y="16" width="5.5" height="32" fill="#f6f6f6" />
            <!-- Letter 'R': Upper Bowl -->
            <path d="M 17.5 16 L 26 16 C 29.5 16 31 18 31 21.5 L 31 23.5 C 31 27 29.5 29 26 29 L 17.5 29 Z M 17.5 21 L 25 21 C 26 21 26.5 21.5 26.5 22.5 L 26.5 22.5 C 26.5 23.5 26 24 25 24 L 17.5 24 Z" fill="#f6f6f6" />
            <!-- Letter 'R': Signature Safety Orange Diagonal Kick -->
            <polygon points="21,28.5 27,28.5 31.5,48 25.5,48" fill="#ff4500" class="rt-accent-leg group-hover:scale-105 origin-bottom transition-transform duration-200" />
            <!-- Letter 'T': Top Crossbar -->
            <rect x="34" y="16" width="18" height="5" fill="#f6f6f6" />
            <!-- Letter 'T': Vertical Center Stem -->
            <rect x="40.25" y="21" width="5.5" height="27" fill="#f6f6f6" />
            <!-- Systems Telemetry Active Dot -->
            <circle cx="51.5" cy="46" r="1.5" fill="#ff4500" class="group-hover:animate-ping" />
          </svg>
        </div>

        <!-- Name & Subtitle Stack -->
        <div class="flex flex-col items-start">
          <div class="reveal-init flex items-center gap-1.5">
            <span class="text-body md:text-body-lg text-foreground leading-tight font-bold tracking-tight group-hover:text-white transition-colors duration-200">
              RESHANDY TAFTAZANI
            </span>
            <span class="w-1.5 h-1.5 rounded-full bg-accent opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100 transition-all duration-300" aria-hidden="true"></span>
          </div>
          <p class="reveal-init text-[11px] md:text-caption text-neutral group-hover:text-foreground transition-colors duration-200 hidden sm:block" style="transition-delay: 80ms;">
            Machine Learning &amp; Systems
          </p>
        </div>
      </a>
    </div>

    <!-- Center: Swiss Telemetry & Live Clock (Desktop & Large screens) -->
    <div class="pointer-events-auto hidden xl:flex justify-center items-center">
      <div 
        id="nav-clock-wrapper"
        class="group flex items-center gap-2.5 font-mono text-[11px] tracking-wider select-none px-3.5 py-1 rounded-full border border-current/20 bg-current/5 hover:border-accent hover:bg-current/10 transition-all duration-200 cursor-default"
        title="Depok, Indonesia (UTC+7)"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse group-hover:scale-125 transition-transform duration-200"></span>
        <span class="text-foreground font-bold tracking-widest">DEPOK</span>
        <span class="text-neutral opacity-60">•</span>
        <span id="nav-live-clock" class="text-foreground font-bold tracking-widest tabular-nums">--:--:-- WIB</span>
      </div>
    </div>

    <!-- Right: Desktop Navigation Links (Visible on lg and above) -->
    <div class="pointer-events-auto hidden lg:flex items-center">
      <nav aria-label="Main desktop navigation" class="select-none">
        <ul class="flex items-center gap-2.5 xl:gap-4.5 2xl:gap-6">
          {navLinks.map((item, idx) => (
            <li class="reveal-init" style={`transition-delay: ${100 + idx * 40}ms;`}>
              <a 
                data-nav-link={item.id}
                class="nav-link group relative -my-2 inline-flex items-center py-2 text-caption xl:text-body uppercase font-bold text-neutral hover:text-foreground transition-all duration-200" 
                href={item.href}
              >
                <!-- Swiss expanding brackets on hover/active -->
                <span class="bracket-left text-accent opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 font-mono text-xs select-none">[</span>
                <span class="relative px-0.5">
                  <span class="nav-text tracking-wide transition-colors duration-200">{item.name}</span>
                  <!-- Swiss sweep underline -->
                  <span 
                    class="nav-underline absolute -bottom-0.5 left-0 w-full h-[2px] bg-current scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-out" 
                    aria-hidden="true"
                  ></span>
                </span>
                <span class="bracket-right text-accent opacity-0 translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 font-mono text-xs select-none">]</span>
              </a>
            </li>
          ))}
          <!-- Swiss Actions Deck: Segmented Control Cluster [ ⌘K | TERM $ | CV ↗ ] -->
          <li class="reveal-init pl-1.5" style={`transition-delay: ${100 + navLinks.length * 40}ms;`}>
            <div 
              class="flex items-center rounded-xs border border-current/25 bg-current/5 divide-x divide-current/20 font-mono text-[11px] font-bold select-none overflow-hidden"
              role="group"
              aria-label="Developer and Quick Actions"
            >
              <!-- Command Palette (⌘K) -->
              <button 
                type="button" 
                data-open-command-palette
                class="group relative inline-flex items-center gap-1 px-2.5 py-1 text-foreground hover:bg-accent hover:text-black transition-colors duration-150 active:scale-95 cursor-pointer"
                title="Global Command Palette (Ctrl+K / Cmd+K)"
                aria-label="Open command palette"
              >
                <span class="text-accent group-hover:text-black font-bold">⌘K</span>
              </button>

              <!-- Interactive UNIX Terminal (~ / Ctrl+J) -->
              <button 
                type="button"
                data-open-terminal
                class="group relative inline-flex items-center gap-0.5 px-2.5 py-1 text-foreground hover:bg-accent hover:text-black transition-colors duration-150 active:scale-95 cursor-pointer"
                title="Interactive Kernel Terminal (~ / Ctrl+J)"
                aria-label="Open terminal drawer"
              >
                <span class="tracking-wider">TERM</span>
                <span class="text-accent group-hover:text-black font-bold">$</span>
              </button>

              <!-- Curriculum Vitae (CV ↗) -->
              <a 
                href="/resume" 
                class="group relative inline-flex items-center gap-0.5 px-2.5 py-1 text-foreground hover:bg-accent hover:text-black transition-colors duration-150 active:scale-95"
                title="Technical CV / Printable Resume"
                aria-label="View Curriculum Vitae"
              >
                <span class="tracking-wider">CV</span>
                <span class="text-accent group-hover:text-black font-bold text-[10px] transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
              </a>
            </div>
          </li>
        </ul>
      </nav>
    </div>

    <!-- Mobile / Tablet Menu Button (< lg screens) -->
    <div class="pointer-events-auto lg:hidden flex items-center">
      <button 
        type="button" 
        id="mobile-menu-toggle-btn"
        class="group inline-flex items-center gap-2 px-3.5 py-1.5 rounded-sm border border-neutral-dark/40 hover:border-accent bg-current/5 hover:bg-accent text-foreground hover:text-black font-mono font-bold text-caption transition-all duration-200 cursor-pointer select-none"
        aria-label="Open mobile navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
      >
        <span class="text-neutral-dark group-hover:text-black transition-transform duration-200 group-hover:-translate-x-0.5">[</span>
        <span class="tracking-wider group-hover:text-black">MENU</span>
        <span class="text-accent group-hover:text-black font-bold text-xs transition-transform duration-200">☰</span>
        <span class="text-neutral-dark group-hover:text-black transition-transform duration-200 group-hover:translate-x-0.5">]</span>
      </button>
    </div>

  </div>
</header>

<!-- Swiss Mobile Menu Drawer (Opaque Full-Screen Overlay, completely un-clipped) -->
<div 
  id="mobile-menu-drawer" 
  class="fixed inset-0 z-50 bg-[#0a0a0a]/98 backdrop-blur-2xl text-foreground flex flex-col justify-between p-6 sm:p-8 transition-all duration-300 opacity-0 pointer-events-none translate-y-4"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile site navigation"
>
  <!-- Drawer Header -->
  <div class="flex items-center justify-between border-b border-grid-line-dark pb-4 font-mono text-caption">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
      <span class="font-bold tracking-wider text-foreground">RESHANDY TAFTAZANI</span>
    </div>

    <button 
      type="button" 
      id="mobile-menu-close-btn"
      class="group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-sm border border-neutral-dark/40 hover:border-accent bg-card-dark hover:bg-accent text-neutral hover:text-black font-mono font-bold text-caption transition-all duration-200 cursor-pointer select-none"
      aria-label="Close navigation menu"
    >
      <span class="text-neutral-dark group-hover:text-black">[</span>
      <span class="tracking-wider">CLOSE</span>
      <span class="text-accent group-hover:text-black font-bold">✕</span>
      <span class="text-neutral-dark group-hover:text-black">]</span>
    </button>
  </div>

  <!-- Drawer Nav Links (Giant Swiss Editorial Typography) -->
  <nav class="my-auto py-8">
    <ul class="flex flex-col space-y-4 sm:space-y-5">
      {navLinks.map((item) => (
        <li class="border-b border-grid-line-dark/60 pb-2.5">
          <a 
            href={item.href} 
            data-mobile-nav-link={item.id}
            class="mobile-nav-link group flex items-baseline justify-between text-display-sm font-bold tracking-tight text-neutral hover:text-accent transition-all duration-200"
          >
            <div class="flex items-baseline gap-3">
              <span class="text-caption font-mono text-neutral-dark group-hover:text-accent transition-colors">[{item.num}]</span>
              <span class="group-hover:translate-x-2 transition-transform duration-200">{item.name}</span>
            </div>
            <span class="text-accent opacity-0 group-hover:opacity-100 transition-opacity duration-200 font-mono text-sm">→</span>
          </a>
        </li>
      ))}
      <li class="border-b border-grid-line-dark/60 pb-2.5">
        <a 
          href="/resume" 
          class="mobile-nav-link group flex items-baseline justify-between text-display-sm font-bold tracking-tight text-foreground hover:text-accent transition-all duration-200"
        >
          <div class="flex items-baseline gap-3">
            <span class="text-caption font-mono text-accent">[07]</span>
            <span class="group-hover:translate-x-2 transition-transform duration-200">CURRICULUM VITAE</span>
          </div>
          <span class="text-accent group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform duration-200 font-mono text-sm">↗</span>
        </a>
      </li>
      <li class="border-b border-grid-line-dark/60 pb-2.5">
        <button 
          type="button" 
          data-open-command-palette
          onclick="document.getElementById('mobile-menu-close-btn')?.click();"
          class="w-full text-left group flex items-baseline justify-between text-display-sm font-bold tracking-tight text-neutral hover:text-accent transition-all duration-200 cursor-pointer"
        >
          <div class="flex items-baseline gap-3">
            <span class="text-caption font-mono text-neutral-dark group-hover:text-accent transition-colors">[⌘K]</span>
            <span class="group-hover:translate-x-2 transition-transform duration-200">COMMAND PALETTE</span>
          </div>
          <span class="text-accent font-mono text-sm">↵</span>
        </button>
      </li>
      <li class="border-b border-grid-line-dark/60 pb-2.5">
        <button 
          type="button" 
          data-open-terminal
          onclick="document.getElementById('mobile-menu-close-btn')?.click();"
          class="w-full text-left group flex items-baseline justify-between text-display-sm font-bold tracking-tight text-neutral hover:text-accent transition-all duration-200 cursor-pointer"
        >
          <div class="flex items-baseline gap-3">
            <span class="text-caption font-mono text-accent">[TERM $]</span>
            <span class="group-hover:translate-x-2 transition-transform duration-200">INTERACTIVE TERMINAL</span>
          </div>
          <span class="text-accent font-mono text-sm">&gt;_</span>
        </button>
      </li>
    </ul>
  </nav>

  <!-- Drawer Footer Telemetry -->
  <div class="border-t border-grid-line-dark pt-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 font-mono text-caption text-neutral-dark">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-accent"></span>
      <span>DEPOK, INDONESIA // <span id="mobile-live-clock" class="text-foreground tabular-nums">--:--:-- WIB</span></span>
    </div>

    <div class="flex items-center gap-3 sm:gap-4 text-xs font-semibold">
      <a href="/notes" class="text-neutral hover:text-accent transition-colors font-mono font-bold">NOTES ↗</a>
      <span>•</span>
      <a href="/resume" class="text-accent hover:underline font-mono font-bold">CV ↗</a>
      <span>•</span>
      <a href="https://github.com/reshandytaftazani" target="_blank" rel="noopener noreferrer" class="text-neutral hover:text-accent transition-colors">GITHUB ↗</a>
      <span>•</span>
      <a href="https://linkedin.com/in/reshandy-taftazani-aulya" target="_blank" rel="noopener noreferrer" class="text-neutral hover:text-accent transition-colors">LINKEDIN ↗</a>
    </div>
  </div>
</div>

<script>
  import { playClick } from '../utils/audio';

  function setupNavbar() {
    // Brand Home Link tactile click
    const brandLink = document.getElementById("brand-home-link");
    if (brandLink) {
      brandLink.addEventListener("click", () => {
        playClick(1500, 0.015, 0.035);
      });
    }

    // 1. Live Swiss Clock in UTC+7 (WIB) for Desktop & Mobile
    function updateClock() {
      const clockDesktop = document.getElementById("nav-live-clock");
      const clockMobile = document.getElementById("mobile-live-clock");

      const now = new Date();
      const options: Intl.DateTimeFormatOptions = {
        timeZone: "Asia/Jakarta",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
      };
      const timeStr = new Intl.DateTimeFormat("en-GB", options).format(now);
      if (clockDesktop) clockDesktop.textContent = `${timeStr} WIB`;
      if (clockMobile) clockMobile.textContent = `${timeStr} WIB`;
    }

    updateClock();
    const clockInterval = setInterval(updateClock, 1000);

    // 2. Mobile Menu Drawer Toggle
    const mobileBtn = document.getElementById("mobile-menu-toggle-btn");
    const closeBtn = document.getElementById("mobile-menu-close-btn");
    const drawer = document.getElementById("mobile-menu-drawer");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");

    function openMobileMenu() {
      if (!drawer || !mobileBtn) return;
      drawer.classList.remove("opacity-0", "pointer-events-none", "translate-y-4");
      drawer.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");
      mobileBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    }

    function closeMobileMenu() {
      if (!drawer || !mobileBtn) return;
      drawer.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
      drawer.classList.add("opacity-0", "pointer-events-none", "translate-y-4");
      mobileBtn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    }

    if (mobileBtn) mobileBtn.addEventListener("click", openMobileMenu);
    if (closeBtn) closeBtn.addEventListener("click", closeMobileMenu);

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        closeMobileMenu();
      });
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && drawer && !drawer.classList.contains("opacity-0")) {
        closeMobileMenu();
      }
    });

    // Smooth-scroll interception for /#hash links on the home page
    document.querySelectorAll<HTMLAnchorElement>('a[href^="/#"]').forEach((anchor) => {
      anchor.addEventListener("click", (e) => {
        if (window.location.pathname === "/" || window.location.pathname === "") {
          const hash = anchor.getAttribute("href")?.replace(/^\/#/, "#");
          if (hash) {
            const target = document.querySelector(hash);
            if (target) {
              e.preventDefault();
              target.scrollIntoView({ behavior: "smooth" });
              history.pushState(null, "", hash);
            }
          }
        }
      });
    });

    // 3. Real-time Scrollspy & Active Page Highlighting
    const sections = ["projects", "experience", "principles", "skills", "contacts"];
    const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");

    function updateActiveNav() {
      const isHome = window.location.pathname === "/" || window.location.pathname === "";
      const isNotes = window.location.pathname.startsWith("/notes");

      let currentSectionId = "";

      if (isNotes) {
        currentSectionId = "notes";
      } else if (isHome) {
        const scrollPos = window.scrollY + 200;
        sections.forEach((id) => {
          const el = document.getElementById(id);
          if (el) {
            const top = el.offsetTop;
            const height = el.offsetHeight;
            if (scrollPos >= top && scrollPos < top + height) {
              currentSectionId = id;
            }
          }
        });
      }

      navLinks.forEach((link) => {
        const targetId = link.getAttribute("data-nav-link");
        const underline = link.querySelector(".nav-underline");
        const bLeft = link.querySelector(".bracket-left");
        const bRight = link.querySelector(".bracket-right");

        if (targetId === currentSectionId) {
          link.classList.add("is-active", "text-foreground");
          link.classList.remove("text-neutral");
          if (underline) underline.classList.remove("scale-x-0");
          if (underline) underline.classList.add("scale-x-100");
          if (bLeft) bLeft.classList.remove("opacity-0", "-translate-x-1");
          if (bLeft) bLeft.classList.add("opacity-100", "translate-x-0");
          if (bRight) bRight.classList.remove("opacity-0", "translate-x-1");
          if (bRight) bRight.classList.add("opacity-100", "translate-x-0");
        } else {
          link.classList.remove("is-active", "text-foreground");
          link.classList.add("text-neutral");
          if (underline) underline.classList.add("scale-x-0");
          if (underline) underline.classList.remove("scale-x-100");
          if (bLeft) bLeft.classList.add("opacity-0", "-translate-x-1");
          if (bLeft) bLeft.classList.remove("opacity-100", "translate-x-0");
          if (bRight) bRight.classList.add("opacity-0", "translate-x-1");
          if (bRight) bRight.classList.remove("opacity-100", "translate-x-0");
        }
      });
    }

    window.addEventListener("scroll", updateActiveNav, { passive: true });
    updateActiveNav();

    document.addEventListener(
      "astro:before-swap",
      () => {
        clearInterval(clockInterval);
        window.removeEventListener("scroll", updateActiveNav);
        document.body.style.overflow = "";
      },
      { once: true }
    );
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupNavbar);
  } else {
    setupNavbar();
  }
  document.addEventListener("astro:page-load", setupNavbar);
</script>
