---
const navLinks = [
  { key: "1", name: "About", href: "#about" },
  { key: "2", name: "Principles", href: "#principles" },
  { key: "3", name: "Projects", href: "#projects" },
  { key: "4", name: "Skills", href: "#skills" },
  { key: "5", name: "Contact", href: "#contact" },
];
---

<header class="sticky top-0 z-50 w-full border-b border-slate-800/80 bg-[#0B0F19]/90 backdrop-blur-md transition-all duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand with coordinate marker -->
      <div class="flex items-center gap-3">
        <a 
          href="#" 
          class="group flex items-center gap-2 font-mono text-sm tracking-tight text-slate-200 hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400/50 rounded-sm py-1 px-1.5"
          aria-label="Reshandy Taftazani Home"
        >
          <span class="text-emerald-400 group-hover:translate-x-0.5 transition-transform duration-150">&gt;</span>
          <span class="font-semibold text-slate-100 group-hover:text-emerald-300">reshandy.dev</span>
          <span class="inline-block w-1.5 h-3.5 bg-emerald-400/80 animate-pulse"></span>
        </a>

        <!-- Swiss style coordinate / status chip -->
        <div class="hidden lg:flex items-center gap-2 text-[10.5px] font-mono text-slate-500 pl-2 border-l border-slate-800">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>UI • CS</span>
          <span class="text-slate-600">|</span>
          <span id="nav-time" class="text-slate-400">WIB</span>
        </div>
      </div>

      <!-- Desktop Navigation Menu with Keyboard Nav Hints -->
      <nav class="hidden md:flex items-center gap-1 sm:gap-1.5" aria-label="Main Navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="group px-2.5 py-1.5 text-xs font-mono text-slate-400 hover:text-emerald-300 hover:bg-slate-800/60 rounded-md transition-all duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400/50 flex items-center gap-1.5"
          >
            <span class="text-[10px] text-slate-600 group-hover:text-emerald-500/70 transition-colors">[{link.key}]</span>
            <span>{link.name}</span>
          </a>
        ))}
      </nav>

      <!-- Right Actions: GitHub Button & Mobile Menu Toggle -->
      <div class="flex items-center gap-3">
        <a
          href="https://github.com/reshandytaftazani"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 text-xs font-mono font-medium text-slate-200 bg-slate-900/90 border border-slate-800 hover:border-emerald-500/50 hover:text-emerald-300 rounded-md transition-all duration-200 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400/50"
          aria-label="GitHub Profile"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          <span>GitHub</span>
          <span class="text-slate-500 font-normal">↗</span>
        </a>

        <!-- Mobile hamburger button -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="md:hidden p-2 text-slate-400 hover:text-slate-200 hover:bg-slate-800/60 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
        >
          <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-800 bg-[#0B0F19]/95 px-4 pt-2 pb-4 space-y-1">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="flex items-center justify-between px-3 py-2 text-sm font-mono text-slate-300 hover:text-emerald-400 hover:bg-slate-900 rounded-md transition-colors"
      >
        <span>{link.name}</span>
        <span class="text-xs text-slate-600">[{link.key}]</span>
      </a>
    ))}
    <div class="pt-2 border-t border-slate-800/80">
      <a
        href="https://github.com/reshandytaftazani"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full py-2 px-3 text-xs font-mono font-medium text-slate-200 bg-slate-900 border border-slate-800 hover:border-emerald-500/40 rounded-md"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>GitHub Profile ↗</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Mobile menu handling
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        btn.setAttribute('aria-expanded', 'false');
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      });
    });
  }

  // Live time ticker in WIB
  function updateTime() {
    const el = document.getElementById('nav-time');
    if (!el) return;
    const now = new Date();
    const timeString = new Intl.DateTimeFormat('id-ID', {
      timeZone: 'Asia/Jakarta',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false
    }).format(now);
    el.textContent = `${timeString} WIB`;
  }
  updateTime();
  setInterval(updateTime, 1000);
</script>
