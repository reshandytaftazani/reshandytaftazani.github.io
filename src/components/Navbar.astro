---
// Navbar.astro (Daniele Buser exact header with Swiss micro-interactions, live clock telemetry & scrollspy)
const navLinks = [
  { id: "projects", name: "PROJECTS", href: "#projects" },
  { id: "principles", name: "PRINCIPLES", href: "#principles" },
  { id: "skills", name: "STACK", href: "#skills" },
  { id: "contacts", name: "CONTACTS", href: "#contacts" },
];
---

<header class="pointer-events-none fixed top-0 left-1/2 z-30 w-full max-w-[120rem] -translate-x-1/2 p-4 sm:px-6 lg:px-8 mix-blend-difference">
  <div class="flex w-full items-start justify-between sm:grid sm:grid-cols-6 sm:gap-4 md:grid-cols-8 lg:grid-cols-12">
    
    <!-- Left: Identity with hover micro-interaction -->
    <div class="pointer-events-auto flex shrink-0 items-start sm:col-span-3 lg:col-span-4">
      <a class="flex w-fit flex-col items-start select-none group" aria-label="Reshandy Taftazani - ML & Systems Engineer" href="#about">
        <div class="reveal-init flex items-center gap-2">
          <span class="text-body md:text-body-lg text-foreground leading-tight font-bold tracking-tight group-hover:tracking-normal transition-all duration-300">
            RESHANDY TAFTAZANI
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-accent opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100 transition-all duration-300" aria-hidden="true"></span>
        </div>
        <p class="reveal-init text-caption md:text-body text-neutral group-hover:text-foreground transition-colors duration-300" style="transition-delay: 80ms;">
          Machine Learning &amp; Systems
        </p>
      </a>
    </div>

    <!-- Center: Swiss Telemetry & Live Clock (Visible on desktop) -->
    <div class="pointer-events-auto hidden lg:flex lg:col-span-4 justify-center items-center pt-1">
      <div class="flex items-center gap-2.5 font-mono text-[11px] tracking-wider select-none px-3 py-1 rounded-full border border-current/20 bg-current/5">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
        <span class="text-foreground font-bold tracking-widest">DEPOK</span>
        <span class="text-neutral opacity-60">•</span>
        <span id="nav-live-clock" class="text-foreground font-bold tracking-widest tabular-nums">--:--:-- WIB</span>
      </div>
    </div>

    <!-- Right: Minimalist Swiss Nav with brackets & sweep underline micro-interactions -->
    <div class="pointer-events-auto flex flex-1 justify-end sm:col-span-3 sm:col-start-4 sm:block md:col-span-5 md:col-start-4 lg:col-span-4 lg:col-start-9">
      <nav aria-label="Main navigation" class="w-full select-none">
        <ul class="flex w-full justify-between items-center gap-2 sm:gap-4 md:gap-6">
          {navLinks.map((item, idx) => (
            <li class="reveal-init" style={`transition-delay: ${100 + idx * 50}ms;`}>
              <a 
                data-nav-link={item.id}
                class="nav-link group relative -my-2 inline-flex items-center py-2 text-caption md:text-body uppercase font-bold text-neutral hover:text-foreground transition-all duration-200" 
                href={item.href}
              >
                <!-- Swiss expanding brackets on hover/active -->
                <span class="bracket-left text-accent opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 font-mono text-xs select-none">[</span>
                <span class="relative px-0.5">
                  <span class="nav-text tracking-wide transition-colors duration-200">{item.name}</span>
                  <!-- Swiss sweep underline -->
                  <span 
                    class="nav-underline absolute -bottom-0.5 left-0 w-full h-[2px] bg-current scale-x-0 group-hover:scale-x-100 origin-left transition-transform duration-300 ease-out" 
                    aria-hidden="true"
                  ></span>
                </span>
                <span class="bracket-right text-accent opacity-0 translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 font-mono text-xs select-none">]</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

  </div>
</header>

<script>
  function setupNavbar() {
    // 1. Live Swiss Clock in UTC+7 (WIB)
    function updateClock() {
      const clockEl = document.getElementById("nav-live-clock");
      if (!clockEl) return;

      const now = new Date();
      // Format to WIB (Asia/Jakarta)
      const options: Intl.DateTimeFormatOptions = {
        timeZone: "Asia/Jakarta",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
      };
      const timeStr = new Intl.DateTimeFormat("en-GB", options).format(now);
      clockEl.textContent = `${timeStr} WIB`;
    }

    updateClock();
    const clockInterval = setInterval(updateClock, 1000);

    // 2. Real-time Scrollspy for Nav Links
    const sections = ["projects", "principles", "skills", "contacts"];
    const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");

    function onScroll() {
      const scrollPos = window.scrollY + 200;

      let currentSectionId = "";
      sections.forEach((id) => {
        const el = document.getElementById(id);
        if (el) {
          const top = el.offsetTop;
          const height = el.offsetHeight;
          if (scrollPos >= top && scrollPos < top + height) {
            currentSectionId = id;
          }
        }
      });

      navLinks.forEach((link) => {
        const targetId = link.getAttribute("data-nav-link");
        const underline = link.querySelector(".nav-underline");
        const bLeft = link.querySelector(".bracket-left");
        const bRight = link.querySelector(".bracket-right");
        const text = link.querySelector(".nav-text");

        if (targetId === currentSectionId) {
          link.classList.add("is-active", "text-foreground");
          link.classList.remove("text-neutral");
          if (underline) underline.classList.remove("scale-x-0");
          if (underline) underline.classList.add("scale-x-100");
          if (bLeft) bLeft.classList.remove("opacity-0", "-translate-x-1");
          if (bLeft) bLeft.classList.add("opacity-100", "translate-x-0");
          if (bRight) bRight.classList.remove("opacity-0", "translate-x-1");
          if (bRight) bRight.classList.add("opacity-100", "translate-x-0");
        } else {
          link.classList.remove("is-active", "text-foreground");
          link.classList.add("text-neutral");
          if (underline) underline.classList.add("scale-x-0");
          if (underline) underline.classList.remove("scale-x-100");
          if (bLeft) bLeft.classList.add("opacity-0", "-translate-x-1");
          if (bLeft) bLeft.classList.remove("opacity-100", "translate-x-0");
          if (bRight) bRight.classList.add("opacity-0", "translate-x-1");
          if (bRight) bRight.classList.remove("opacity-100", "translate-x-0");
        }
      });
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    document.addEventListener(
      "astro:before-swap",
      () => {
        clearInterval(clockInterval);
        window.removeEventListener("scroll", onScroll);
      },
      { once: true }
    );
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupNavbar);
  } else {
    setupNavbar();
  }
  document.addEventListener("astro:page-load", setupNavbar);
</script>
