    invariants: [
      "Debit and credit entries must balance precisely to zero difference on every transaction.",
      "All monetary values are strictly represented as 4-place fixed Decimal instances.",
      "Batch migrations execute within single atomic transactions with automatic rollback.",
    ],
    cliCommand: "python -m ledger.cli sync --audit --verify-invariants",
    githubUrl: "https://github.com/reshandytaftazani/finance-tracker",
    techStack: ["Python", "FastAPI", "SQLite", "Pydantic v2", "Docker", "Pytest"],
