│        [Debit == Credit] ──> [Audit Assertion Gate]         │
└──────────────────────────────┬──────────────────────────────┘
                               │
                               ▼
            [SQLite WAL Journal (Atomic Commit)]`,
    benchmarks: [
      { label: "Ledger Balance", value: "100.00%", detail: "Zero floating-point discrepancy across ledger history" },
      { label: "Query Speed", value: "4.12ms", detail: "Fast analytical query response on 50,000 transactions" },
      { label: "Batch Ingest", value: "0.28s", detail: "Atomic commit for 5,000 imported transaction rows" },
      { label: "Transaction Safety", value: "ACID", detail: "Zero orphaned records during unexpected runtime aborts" },
