  id: string;
  name: string;
  summary: string;
  categoryClass: string;
  systemInvariant: string;
  productionTelemetry: string;
  blueprintLabel: string;
  blueprintUrl: string;
}

interface SkillDomain {
  index: string;
  category: string;
  code: string;
  badge: string;
  tagline: string;
  description: string;
  skills: SkillItem[];
}

