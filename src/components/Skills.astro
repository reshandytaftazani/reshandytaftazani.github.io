// Initial default selection for SSR Inspector rendering
const defaultSkill = skillDomains[0].skills[0]; // Python
const defaultDomain = skillDomains[0]; // LANG
---

<section id="skills" class="relative z-10 flex w-full flex-col pt-16 pb-36" aria-labelledby="skills-heading">
  
  <!-- Section Heading (Daniele Buser Swiss High-Density Header) -->
  <div class="reveal-init flex flex-col sm:flex-row sm:items-center justify-between border-b border-grid-line-light pb-4 gap-2">
    <div class="flex items-center gap-3">
      <h2 class="text-caption md:text-body uppercase text-neutral-dark font-mono tracking-wider" id="skills-heading">
        TECHNICAL STACK & TELEMETRY
      </h2>
      <span class="text-caption font-mono text-neutral-dark font-semibold">
        [04 DOMAIN TABS // 20 TECHNOLOGIES]
      </span>
    </div>

    <div class="flex items-center gap-4">
      <span class="hidden sm:inline-block font-mono text-[11px] text-neutral-dark">
        PROJECTION: <span class="text-accent font-semibold">TABBED_SPLIT_MATRIX</span>
      </span>
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-mono bg-neutral-900 border border-grid-line-dark text-neutral-dark uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        REACTIVE_PROBE
      </span>
    </div>
  </div>

  <!-- Desktop 12-Column Split Grid Layout -->
  <div class="mt-8 grid w-full grid-cols-12 gap-8 lg:gap-10 items-start">
    
    <!-- ========================================================================= -->
    <!-- SISI KIRI (7 KOLOM): TABBED DOMAIN STACK MATRIX                           -->
    <!-- ========================================================================= -->
    <div class="col-span-12 lg:col-span-7 flex flex-col space-y-6">
      
      <!-- SWISS BRUTALIST TAB STRIP: LANG | MLE | ARCH | TEST -->
      <div 
        class="reveal-init grid grid-cols-2 sm:grid-cols-4 border border-grid-line-dark bg-card-dark divide-x divide-y sm:divide-y-0 divide-grid-line-dark font-mono text-[11px]" 
        role="tablist" 
        aria-label="Technical domain category tabs"
      >
        {skillDomains.map((domain, idx) => {
          const isDefaultTab = idx === 0;
          return (
            <button
              type="button"
              role="tab"
              id={`tab-btn-${domain.code}`}
              aria-selected={isDefaultTab ? "true" : "false"}
              aria-controls={`panel-${domain.code}`}
              data-tab-target={domain.code}
              class={`domain-tab-btn relative px-3 sm:px-4 py-3 text-left transition-all duration-150 cursor-pointer select-none flex flex-col justify-between overflow-hidden active:scale-[0.99] ${
                isDefaultTab
                  ? 'is-active bg-black text-white'
                  : 'bg-card-dark text-neutral hover:bg-neutral-900 hover:text-white'
              }`}
              style="transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);"
            >
              <!-- Active Top Accent Hairline -->
              <span 
                class={`tab-accent-indicator absolute inset-x-0 top-0 h-[2px] bg-accent transition-opacity duration-150 ${
                  isDefaultTab ? 'opacity-100' : 'opacity-0'
                }`}
              ></span>

              <div class="flex items-center justify-between w-full">
                <span class="tab-code font-bold tracking-wider">[{domain.index}] {domain.code}</span>
                <span class="tab-dot text-accent text-[9px] font-bold">
                  {isDefaultTab ? '●' : '○'}
                </span>
              </div>
              
              <div class="mt-1 flex items-center justify-between text-[9px] font-mono">
                <span class="tab-tagline text-neutral-dark uppercase tracking-wider truncate">
                  {domain.tagline}
                </span>
              </div>
            </button>
          );
        })}
      </div>

      <!-- TAB PANELS CONTAINER -->
      <div class="tab-panels-container relative flex flex-col">
        {skillDomains.map((domain, domainIdx) => {
          const isDefaultTab = domainIdx === 0;
          return (
            <div 
              id={`panel-${domain.code}`}
              role="tabpanel"
              aria-labelledby={`tab-btn-${domain.code}`}
              data-tab-panel={domain.code}
              class={`domain-tab-panel relative flex-col space-y-3 overflow-hidden ${
                isDefaultTab ? 'flex is-entering' : 'hidden'
              }`}
              data-domain-code={domain.code}
            >
              <!-- High-Speed Scanline Calibration Laser Beam -->
              <div class="panel-scanline-laser pointer-events-none absolute inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-accent to-transparent opacity-0 z-30" aria-hidden="true"></div>

              <!-- Active Domain Header Bar -->
              <div class="domain-header-block flex flex-col sm:flex-row sm:items-center justify-between border-b border-grid-line-dark/80 pb-2.5 gap-2">
                <div class="flex items-center gap-2 font-mono">
                  <span class="text-accent font-bold text-caption">[{domain.index}] {domain.code}</span>
                  <span class="text-neutral-dark text-caption font-bold">/</span>
                  <h3 class="text-body font-bold uppercase tracking-tight text-foreground">
                    {domain.category}
                  </h3>
                </div>
                <span class="text-[10px] font-mono uppercase px-2 py-0.5 bg-card-dark text-accent border border-grid-line-dark font-semibold self-start sm:self-auto">
                  STATUS: {domain.badge}
                </span>
              </div>

              <!-- Active Domain Description -->
              <p class="domain-desc-block text-caption text-neutral font-mono leading-relaxed pb-1">
                {domain.description}
              </p>

              <!-- Technology Rows Container -->
              <div class="tech-rows-stack flex flex-col border border-grid-line-dark divide-y divide-grid-line-dark bg-card-dark">
                {domain.skills.map((skill, skillIdx) => {
                  const isDefaultActive = skill.id === defaultSkill.id;
                  return (
                    <div class="skill-row-container relative flex flex-col group/row-container">
                      <!-- Clickable/Hoverable Technology Row -->
                      <button
                        type="button"
                        class={`skill-row relative w-full flex items-center justify-between px-4 py-3.5 text-left transition-all duration-150 cursor-pointer select-none overflow-hidden ${
                          isDefaultActive
                            ? 'is-active bg-black text-white'
                            : 'bg-card-dark text-foreground hover:bg-black hover:text-white'
                        }`}
                        style="transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);"
                        data-skill-id={skill.id}
                        data-name={skill.name}
                        data-category-code={domain.code}
                        data-category-class={skill.categoryClass}
                        data-invariant={skill.systemInvariant}
                        data-telemetry={skill.productionTelemetry}
                        data-blueprint-label={skill.blueprintLabel}
                        data-blueprint-url={skill.blueprintUrl}
                        aria-label={`Inspect telemetry and invariant for ${skill.name}`}
                      >
                        <!-- Left Scanline Accent Indicator -->
                        <span 
                          class={`scanline-bar absolute left-0 top-0 bottom-0 w-[3px] bg-accent transition-opacity duration-150 pointer-events-none ${
                            isDefaultActive ? 'opacity-100' : 'opacity-0 group-hover/row-container:opacity-100'
                          }`}
                        ></span>

                        <!-- Row Identity (Index + Name + Summary) -->
                        <div class="flex items-center gap-3.5 min-w-0 pr-2">
                          <span class="row-index font-mono text-[11px] text-neutral-dark group-hover/row-container:text-accent font-semibold transition-colors duration-150 shrink-0">
                            {domain.index}.{skillIdx + 1}
                          </span>
                          <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3 min-w-0">
                            <span class="row-name text-body font-bold tracking-tight text-foreground group-hover/row-container:text-white transition-colors duration-150 shrink-0">
                              {skill.name}
                            </span>
                            <span class="row-summary font-mono text-caption text-neutral-dark group-hover/row-container:text-neutral-200 transition-colors duration-150 truncate">
                              {skill.summary}
                            </span>
                          </div>
                        </div>

                        <!-- Right Indicator Glyph -->
                        <div class="flex items-center gap-2 shrink-0 font-mono text-[11px]">
                          <span class="hidden md:inline-block text-[10px] text-neutral-dark group-hover/row-container:text-accent uppercase tracking-wider font-semibold">
                            {skill.categoryClass}
                          </span>
                          <span class="row-glyph text-accent font-bold transition-transform duration-150 group-hover/row-container:translate-x-0.5">
                            ►
                          </span>
                        </div>
                      </button>

                      <!-- ========================================================= -->
                      <!-- MOBILE/TABLET RESPONSIVE INLINE ACCORDION (< 1024px)       -->
                      <!-- Mechanical expansion right beneath tapped item             -->
                      <!-- ========================================================= -->
                      <div 
                        class={`skill-accordion lg:hidden overflow-hidden transition-all duration-200 border-t border-grid-line-dark bg-black ${
                          isDefaultActive ? 'max-h-[500px] p-4' : 'max-h-0 px-4 py-0'
                        }`}
                        style="transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);"
                        data-accordion-id={skill.id}
                      >
                        <div class="space-y-3.5 font-mono text-[11px]">
                          <!-- Header Badge -->
                          <div class="flex items-center justify-between pb-2 border-b border-grid-line-dark/60">
                            <span class="text-[10px] uppercase text-neutral-dark font-semibold">
                              TELEMETRY_PROBE // [{skill.name}]
                            </span>
                            <span class="text-[10px] px-2 py-0.5 bg-neutral-900 border border-neutral-700 text-accent font-bold uppercase">
                              {skill.categoryClass}
                            </span>
                          </div>

                          <!-- System Invariant -->
                          <div>
                            <div class="text-[9px] uppercase text-neutral-dark tracking-wider mb-1 font-semibold">
                              // SYSTEM_INVARIANT:
                            </div>
                            <p class="text-neutral font-sans text-body leading-relaxed">
                              {skill.systemInvariant}
                            </p>
                          </div>

                          <!-- Production Telemetry -->
                          <div>
                            <div class="text-[9px] uppercase text-neutral-dark tracking-wider mb-1 font-semibold">
                              // PRODUCTION_TELEMETRY:
                            </div>
                            <div class="bg-neutral-950 p-2.5 border border-grid-line-dark text-neutral-200 text-[10px]">
                              {skill.productionTelemetry}
                            </div>
                          </div>

                          <!-- Integrated Blueprint Link -->
                          <div class="pt-1">
                            <a 
                              href={skill.blueprintUrl}
                              class="w-full flex items-center justify-between px-3 py-2 bg-neutral-900 hover:bg-accent text-foreground hover:text-black border border-grid-line-dark hover:border-accent text-[11px] font-bold tracking-wider transition-colors duration-150"
                            >
                              <span class="text-accent group-hover:text-black">[{skill.blueprintLabel}]</span>
                              <span class="text-[10px]">BLUEPRINT ↗</span>
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })}
      </div>

    </div>

    <!-- ========================================================================= -->
    <!-- SISI KANAN (5 KOLOM): STICKY TELEMETRY INSPECTOR (DESKTOP)                -->
    <!-- ========================================================================= -->
    <div class="col-span-12 lg:col-span-5 hidden lg:block">
      <div 
        id="desktop-inspector-panel"
        class="sticky top-28 bg-card-dark border border-grid-line-dark p-6 sm:p-7 space-y-6 shadow-[0_20px_50px_rgba(0,0,0,0.6)] transition-all duration-150"
        style="transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);"
      >
        <!-- Inspector Top Telemetry Bar -->
        <div class="flex items-center justify-between font-mono text-[10px] text-neutral-dark border-b border-grid-line-dark pb-3 select-none">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-foreground font-bold tracking-wider">[INSPECTOR // LIVE_PROBE]</span>
          </div>
          <span class="text-accent font-semibold transition-colors duration-150" id="inspector-category-code">
            [{defaultDomain.code} // {defaultSkill.categoryClass}]
          </span>
        </div>

        <!-- Selected Parameter Name & Class -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <span class="font-mono text-[10px] uppercase text-neutral-dark tracking-wider select-none">
              PARAMETER_NAME:
            </span>
            <span 
              id="inspector-category-class" 
              class="font-mono text-[10px] px-2 py-0.5 bg-neutral-900 border border-neutral-700 text-accent font-bold uppercase tracking-wider transition-all duration-150"
            >
              {defaultSkill.categoryClass}
            </span>
          </div>

          <h4 
            id="inspector-parameter-name" 
            class="text-section font-bold tracking-tight text-foreground transition-all duration-150"
          >
            {defaultSkill.name}
          </h4>
        </div>

        <!-- Architectural System Invariant -->
        <div class="space-y-2 pt-4 border-t border-grid-line-dark">
          <div class="font-mono text-[10px] uppercase text-neutral-dark tracking-wider select-none flex items-center justify-between">
            <span>// SYSTEM_INVARIANT:</span>
            <span class="text-accent text-[9px]">ARCHITECTURAL_ROLE</span>
          </div>
          <p 
            id="inspector-system-invariant" 
            class="text-body text-neutral leading-relaxed font-sans transition-all duration-150"
          >
            {defaultSkill.systemInvariant}
          </p>
        </div>

        <!-- Production Telemetry & Real-World Benchmark -->
        <div class="space-y-2 pt-4 border-t border-grid-line-dark">
          <div class="font-mono text-[10px] uppercase text-neutral-dark tracking-wider select-none flex items-center justify-between">
            <span>// PRODUCTION_TELEMETRY:</span>
            <span class="text-emerald-400 text-[9px]">SLA_VERIFIED ✓</span>
          </div>
          <div class="bg-black p-3.5 border border-grid-line-dark font-mono text-[11px] space-y-2">
            <div 
              id="inspector-production-telemetry" 
              class="text-neutral-200 leading-relaxed font-mono select-all transition-all duration-150"
            >
              {defaultSkill.productionTelemetry}
            </div>
            
            <!-- Real-time activity pulse bar -->
            <div class="w-full h-1 bg-neutral-900 overflow-hidden flex" aria-hidden="true">
              <div class="h-full bg-accent animate-pulse w-3/4"></div>
            </div>
          </div>
        </div>

        <!-- Integrated Blueprint Link -->
        <div class="pt-4 border-t border-grid-line-dark">
          <div class="font-mono text-[10px] uppercase text-neutral-dark tracking-wider mb-2 select-none">
            // INTEGRATED_BLUEPRINT:
          </div>
          <a 
            id="inspector-blueprint-btn" 
            href={defaultSkill.blueprintUrl} 
            class="group/btn w-full flex items-center justify-between px-4 py-3 bg-black hover:bg-accent text-foreground hover:text-black border border-grid-line-dark hover:border-accent font-mono text-[11px] font-bold tracking-wider transition-all duration-150 cursor-pointer select-none"
            style="transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);"
          >
            <span id="inspector-blueprint-label" class="text-accent group-hover/btn:text-black transition-colors duration-150">
              [{defaultSkill.blueprintLabel}]
            </span>
            <span class="flex items-center gap-1">
              <span>EXPLORE CASE STUDY</span>
              <span class="group-hover/btn:translate-x-1 transition-transform duration-150">↗</span>
            </span>
          </a>
        </div>

        <!-- Subtle Hardware/Bus Telemetry Stamp -->
        <div class="pt-2 flex items-center justify-between font-mono text-[9px] text-neutral-dark border-t border-grid-line-dark/40 select-none">
          <span id="inspector-bus-channel">BUS: /DEV/SHM // PROTO: IPC_RING</span>
          <span>LATENCY: &lt; 0.12ms</span>
        </div>
      </div>
    </div>

  </div>

</section>

<!-- ========================================================================= -->
<!-- STYLES: SWISS TELEMETRY MECHANICAL MOTION & SCANLINE LASER ANIMATIONS    -->
<!-- ========================================================================= -->
<style>
  @keyframes tabRowSlideIn {
    0% {
      opacity: 0;
      transform: translateY(12px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes scanlineSweep {
    0% {
      top: 0%;
      opacity: 1;
    }
    60% {
      opacity: 0.85;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  @keyframes inspectorSyncPulse {
    0% {
      border-color: #ff4500;
      box-shadow: 0 0 25px rgba(255, 69, 0, 0.28);
    }
    100% {
      border-color: #1a1a1a;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    }
  }

  /* Staggered Row Entrance on Tab Activation */
  .domain-tab-panel.is-entering .domain-header-block {
    animation: tabRowSlideIn 150ms cubic-bezier(0.16, 1, 0.3, 1) 0ms both;
  }
  .domain-tab-panel.is-entering .domain-desc-block {
    animation: tabRowSlideIn 150ms cubic-bezier(0.16, 1, 0.3, 1) 20ms both;
  }
  .domain-tab-panel.is-entering .skill-row-container:nth-child(1) {
    animation: tabRowSlideIn 180ms cubic-bezier(0.16, 1, 0.3, 1) 25ms both;
  }
  .domain-tab-panel.is-entering .skill-row-container:nth-child(2) {
    animation: tabRowSlideIn 180ms cubic-bezier(0.16, 1, 0.3, 1) 50ms both;
  }
  .domain-tab-panel.is-entering .skill-row-container:nth-child(3) {
    animation: tabRowSlideIn 180ms cubic-bezier(0.16, 1, 0.3, 1) 75ms both;
  }
  .domain-tab-panel.is-entering .skill-row-container:nth-child(4) {
    animation: tabRowSlideIn 180ms cubic-bezier(0.16, 1, 0.3, 1) 100ms both;
  }
  .domain-tab-panel.is-entering .skill-row-container:nth-child(5) {
    animation: tabRowSlideIn 180ms cubic-bezier(0.16, 1, 0.3, 1) 125ms both;
  }

  /* Scanline Laser Sweep */
  .domain-tab-panel.is-entering .panel-scanline-laser {
    animation: scanlineSweep 280ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Inspector Hardware Bus Synchronize Flash */
  #desktop-inspector-panel.is-syncing {
    animation: inspectorSyncPulse 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Accessibility: Prefers Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .domain-tab-panel.is-entering .domain-header-block,
    .domain-tab-panel.is-entering .domain-desc-block,
    .domain-tab-panel.is-entering .skill-row-container,
    .domain-tab-panel.is-entering .panel-scanline-laser,
    #desktop-inspector-panel.is-syncing {
      animation: none !important;
      transform: none !important;
    }
  }
</style>

<!-- ========================================================================= -->
<!-- CLIENT-SIDE SCRIPT: SPLIT MATRIX & LIVE TELEMETRY INSPECTOR CONTROLLER    -->
<!-- ========================================================================= -->
<script>
  import { playClick } from '../utils/audio';

  function initSkillsMatrix() {
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.domain-tab-btn');
    const tabPanels = document.querySelectorAll<HTMLElement>('.domain-tab-panel');
    const skillRows = document.querySelectorAll<HTMLButtonElement>('.skill-row');
    const accordions = document.querySelectorAll<HTMLElement>('.skill-accordion');
    const desktopInspector = document.getElementById('desktop-inspector-panel');

    // Desktop Inspector Elements
    const inspectorParamName = document.getElementById('inspector-parameter-name');
    const inspectorCatClass = document.getElementById('inspector-category-class');
    const inspectorCatCode = document.getElementById('inspector-category-code');
    const inspectorInvariant = document.getElementById('inspector-system-invariant');
    const inspectorTelemetry = document.getElementById('inspector-production-telemetry');
    const inspectorBlueprintBtn = document.getElementById('inspector-blueprint-btn') as HTMLAnchorElement | null;
    const inspectorBlueprintLabel = document.getElementById('inspector-blueprint-label');
    const inspectorBusChannel = document.getElementById('inspector-bus-channel');

    let currentActiveId = 'python';
    let currentActiveTab = 'LANG';
    let lastAudioTime = 0;

    function playDebouncedClick(freq = 1100) {
      const now = performance.now();
      // Debounce audio to prevent distortion if user hovers rapidly across rows
      if (now - lastAudioTime > 50) {
        playClick(freq);
        lastAudioTime = now;
      }
    }

    function animateValueChange(element: HTMLElement | null, newText: string) {
      if (!element || element.textContent === newText) return;
      element.textContent = newText;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      element.animate(
        [
          { opacity: 0.45, transform: 'translateY(3px)' },
          { opacity: 1, transform: 'translateY(0)' }
        ],
        { duration: 150, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
      );
    }

    function setActiveSkill(targetRow: HTMLButtonElement, shouldPlaySound = true) {
      const skillId = targetRow.dataset.skillId || '';
      const name = targetRow.dataset.name || '';
      const categoryCode = targetRow.dataset.categoryCode || '';
      const categoryClass = targetRow.dataset.categoryClass || '';
      const invariant = targetRow.dataset.invariant || '';
      const telemetry = targetRow.dataset.telemetry || '';
      const blueprintLabel = targetRow.dataset.blueprintLabel || '';
      const blueprintUrl = targetRow.dataset.blueprintUrl || '';

      if (shouldPlaySound && currentActiveId !== skillId) {
        playDebouncedClick(1050);
      }
      currentActiveId = skillId;

      // 1. Update all desktop row styles (monochrome color inversion)
      skillRows.forEach((row) => {
        const isActive = row.dataset.skillId === skillId;
        const scanline = row.querySelector('.scanline-bar');

        if (isActive) {
          row.classList.add('is-active', 'bg-black', 'text-white');
          row.classList.remove('bg-card-dark');
          if (scanline) {
            scanline.classList.remove('opacity-0');
            scanline.classList.add('opacity-100');
          }
        } else {
          row.classList.remove('is-active', 'bg-black', 'text-white');
          row.classList.add('bg-card-dark');
          if (scanline) {
            scanline.classList.remove('opacity-100');
            scanline.classList.add('opacity-0');
          }
        }
      });

      // 2. Update Desktop Inspector Elements with precision micro-transition
      animateValueChange(inspectorParamName, name);
      animateValueChange(inspectorCatClass, categoryClass);
      animateValueChange(inspectorCatCode, `[${categoryCode} // ${categoryClass}]`);
      animateValueChange(inspectorInvariant, invariant);
      animateValueChange(inspectorTelemetry, telemetry);
      if (inspectorBlueprintBtn) inspectorBlueprintBtn.href = blueprintUrl;
      animateValueChange(inspectorBlueprintLabel, `[${blueprintLabel}]`);
      if (inspectorBusChannel) {
        inspectorBusChannel.textContent = `BUS: /DEV/SHM/${categoryCode.toLowerCase()} // PROTO: IPC_RING`;
      }
    }

    function switchTab(targetCode: string) {
      if (currentActiveTab === targetCode) return;
      currentActiveTab = targetCode;
      playClick(1320, 0.02, 0.04);

      // Update Tab Buttons
      tabBtns.forEach((btn) => {
        const isTarget = btn.dataset.tabTarget === targetCode;
        const accentIndicator = btn.querySelector('.tab-accent-indicator');
        const dot = btn.querySelector('.tab-dot');

        btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');

        if (isTarget) {
          btn.classList.add('is-active', 'bg-black', 'text-white');
          btn.classList.remove('bg-card-dark', 'text-neutral');
          if (accentIndicator) accentIndicator.classList.replace('opacity-0', 'opacity-100');
          if (dot) dot.textContent = '●';
        } else {
          btn.classList.remove('is-active', 'bg-black', 'text-white');
          btn.classList.add('bg-card-dark', 'text-neutral');
          if (accentIndicator) accentIndicator.classList.replace('opacity-100', 'opacity-0');
          if (dot) dot.textContent = '○';
        }
      });

      // Update Tab Panels with Staggered Slide & Laser Sweep
      tabPanels.forEach((panel) => {
        const isTarget = panel.dataset.tabPanel === targetCode;
        if (isTarget) {
          panel.classList.remove('hidden');
          panel.classList.add('flex');

          // Trigger entrance animation & laser sweep by reflowing DOM
          panel.classList.remove('is-entering');
          void panel.offsetWidth; // Force reflow
          panel.classList.add('is-entering');

          // Flash sync pulse on desktop inspector
          if (desktopInspector) {
            desktopInspector.classList.remove('is-syncing');
            void desktopInspector.offsetWidth; // Force reflow
            desktopInspector.classList.add('is-syncing');
          }

          // Automatically select the first skill in the newly active tab
          const firstRow = panel.querySelector<HTMLButtonElement>('.skill-row');
          if (firstRow) {
            setActiveSkill(firstRow, false);
          }
        } else {
          panel.classList.add('hidden');
          panel.classList.remove('flex', 'is-entering');
        }
      });

      // Reset any open mobile accordions in newly switched tab
      accordions.forEach((acc) => {
        acc.classList.remove('max-h-[500px]', 'p-4');
        acc.classList.add('max-h-0', 'py-0');
      });
    }

    function toggleMobileAccordion(targetRow: HTMLButtonElement) {
      const skillId = targetRow.dataset.skillId || '';
      const matchingAccordion = document.querySelector<HTMLElement>(`[data-accordion-id="${skillId}"]`);

      if (!matchingAccordion) return;

      const isCurrentlyOpen = matchingAccordion.classList.contains('max-h-[500px]');
      playClick(isCurrentlyOpen ? 800 : 1200);

      // Collapse all accordions first
      accordions.forEach((acc) => {
        acc.classList.remove('max-h-[500px]', 'p-4');
        acc.classList.add('max-h-0', 'py-0');
      });

      // If it was closed, open this one
      if (!isCurrentlyOpen) {
        matchingAccordion.classList.remove('max-h-0', 'py-0');
        matchingAccordion.classList.add('max-h-[500px]', 'p-4');
      }

      // Also sync active row styling
      setActiveSkill(targetRow, false);
    }

    // Attach Tab Button Click Listeners
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.tabTarget;
        if (target) switchTab(target);
      });
    });

    // Attach Skill Row Event Listeners
    skillRows.forEach((row) => {
      // Desktop: hover or focus changes inspector immediately
      row.addEventListener('mouseenter', () => {
        if (window.innerWidth >= 1024) {
          setActiveSkill(row, true);
        }
      });

      row.addEventListener('focus', () => {
        if (window.innerWidth >= 1024) {
          setActiveSkill(row, true);
        }
      });

      // Click: handles both desktop active select and mobile inline accordion expansion
      row.addEventListener('click', () => {
        if (window.innerWidth < 1024) {
          toggleMobileAccordion(row);
        } else {
          setActiveSkill(row, true);
        }
      });
    });
  }

  // Initialize on load and on Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSkillsMatrix);
  } else {
    initSkillsMatrix();
  }
  document.addEventListener('astro:page-load', initSkillsMatrix);
</script>
