---
// Skills.astro (Split Matrix & Live Telemetry Inspector - Awwwards / Swiss Brutalist Standard)
// Desktop 12-Column Split: 7 Cols Segmented Domain Tabs + 5 Cols Sticky Live Telemetry Inspector
// Mobile/Tablet: Responsive Mechanical Inline Accordion beneath tapped skill row
// Impeccable Motion: Staggered mechanical row slide-in, scanline laser sweep, and inspector bus sync flash

interface SkillItem {
  id: string;
  name: string;
  summary: string;
  categoryClass: string;
  systemInvariant: string;
  productionTelemetry?: string;
  blueprintLabel: string;
  blueprintUrl: string;
}

interface SkillDomain {
  index: string;
  category: string;
  code: string;
  badge: string;
  tagline: string;
  description: string;
  skills: SkillItem[];
}

