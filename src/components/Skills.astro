---
// Skills.astro (Daniele Buser Swiss Modular Stack Grid with motion reveals & high-visibility micro-interactions)
const skillGroups = [
  {
    index: "01",
    category: "Languages",
    code: "LANG",
    badge: "100%_TYPED",
    description: "Core languages for systems, pipelines, and type-safe computation.",
    skills: [
      { name: "Python", detail: "AsyncIO, Typing, C-Extensions" },
      { name: "C / C++", detail: "Memory safety, High-perf routines" },
      { name: "TypeScript", detail: "Strict compiler, Generics" },
      { name: "SQL", detail: "PostgreSQL, Window functions" },
      { name: "Bash", detail: "Process pipes, Kernel tooling" },
    ],
  },
  {
    index: "02",
    category: "ML & Data Systems",
    code: "MLE",
    badge: "LEAK_FREE",
    description: "Leak-free feature pipelines and reproducible model execution.",
    skills: [
      { name: "PyTorch", detail: "Custom architectures, Autograd hooks" },
      { name: "scikit-learn", detail: "Leak-free pipelines, Estimators" },
      { name: "NumPy / Pandas", detail: "Vectorized compute, Memory layout" },
      { name: "Pipeline Design", detail: "Tombstone guards, Point-in-time" },
      { name: "ONNX Runtime", detail: "Graph optimization, Quantization" },
    ],
  },
  {
    index: "03",
    category: "Systems Architecture",
    code: "ARCH",
    badge: "HEXAGONAL",
    description: "Decoupled domain cores, explicit contracts, and container runtimes.",
    skills: [
      { name: "FastAPI", detail: "Asynchronous I/O, High throughput" },
      { name: "Clean Architecture", detail: "Hexagonal / Ports & Adapters" },
      { name: "Pydantic V2", detail: "Strict mode, Rust core validator" },
      { name: "Linux / OS", detail: "Signals (SIGINT/TERM), IPC, Sockets" },
      { name: "Docker", detail: "Multi-stage builds, Distroless images" },
    ],
  },
  {
    index: "04",
    category: "Testing & DevOps",
    code: "TEST",
    badge: "VERIFIED_CI",
    description: "Defensive verification, deterministic tests, and automated releases.",
    skills: [
      { name: "Pytest & TDD", detail: "Fixtures, Parametric isolation" },
      { name: "Verification Suites", detail: "Process interrupt chaos tests" },
      { name: "Git", detail: "Trunk-based workflow, Atomic commits" },
      { name: "CI/CD Actions", detail: "Test matrices, Pages deployment" },
      { name: "Defensive Programming", detail: "Invariant assertion guards" },
    ],
  },
];
---

<section id="skills" class="relative z-10 flex w-full flex-col pt-16 pb-36" aria-labelledby="skills-heading">
  
  <!-- Section Heading (Daniele Buser Swiss Style) -->
  <div class="reveal-init flex items-center justify-between border-b border-grid-line-light pb-4">
    <h2 class="text-caption md:text-body uppercase text-neutral-dark font-mono tracking-wider" id="skills-heading">
      MY TECH STACK
    </h2>
    <span class="text-caption font-mono text-neutral-dark font-semibold">
      [04 DOMAINS]
    </span>
  </div>

  <!-- 4-Column Grid in bg-card-dark with micro-interactions -->
  <div class="mt-6 grid w-full grid-cols-12 gap-4 lg:gap-6">
    {skillGroups.map((g, idx) => (
      <div 
        class="group reveal-init col-span-12 sm:col-span-6 lg:col-span-3 flex w-full flex-col bg-card-dark p-6 sm:p-7 justify-between border border-transparent hover:border-neutral-dark/40 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgba(0,0,0,0.45)] transition-all duration-300 ease-out"
        style={`transition-delay: ${idx * 100}ms;`}
      >
        <div>
          <!-- Header -->
          <div class="flex items-center justify-between font-mono text-caption text-neutral-dark border-b border-grid-line-dark pb-3 mb-4">
            <span class="text-foreground font-bold group-hover:text-accent transition-colors duration-200">[{g.index}] {g.code}</span>
            <span class="text-accent font-semibold">{g.badge}</span>
          </div>

          <h3 class="text-section font-bold tracking-tight text-foreground group-hover:text-accent transition-colors duration-200">
            {g.category}
          </h3>
          <p class="text-caption text-neutral mt-1 mb-6 leading-relaxed">
            {g.description}
          </p>

          <!-- Skill List with item hover micro-interactions -->
          <ul class="space-y-3">
            {g.skills.map((s) => (
              <li class="group/item border-b border-grid-line-dark/60 pb-2 px-1.5 -mx-1.5 rounded-xs transition-colors duration-200 hover:bg-white/5 cursor-default">
                <div class="text-body font-semibold text-foreground group-hover/item:text-accent flex items-center justify-between transition-colors duration-150">
                  <span class="group-hover/item:translate-x-1 transition-transform duration-150 inline-block">{s.name}</span>
                  <span class="text-accent text-[11px] font-bold group-hover/item:scale-150 transition-transform duration-150">●</span>
                </div>
                <div class="text-caption text-neutral-dark group-hover/item:text-neutral font-mono mt-0.5 transition-colors duration-150">
                  {s.detail}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>

</section>
