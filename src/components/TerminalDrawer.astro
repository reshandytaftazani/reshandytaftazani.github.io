        e.preventDefault();
        const val = input.value;
        input.value = "";
        updateCursorDisplay();
        executeCommand(val);
        return;
      }

      if (e.key === "ArrowUp") {
        e.preventDefault();
        if (commandHistory.length === 0) return;
        if (historyIndex > 0) {
          historyIndex--;
        } else if (historyIndex === -1) {
          historyIndex = commandHistory.length - 1;
        }
        input.value = commandHistory[historyIndex] ?? "";
        updateCursorDisplay();
        return;
      }

      if (e.key === "ArrowDown") {
        e.preventDefault();
        if (commandHistory.length === 0) return;
        if (historyIndex < commandHistory.length - 1 && historyIndex !== -1) {
          historyIndex++;
          input.value = commandHistory[historyIndex] ?? "";
        } else {
          historyIndex = -1;
          input.value = "";
        }
        updateCursorDisplay();
        return;
      }

      if (e.key === "Tab") {
        e.preventDefault();
        const val = input.value.trim().toLowerCase();
        const candidates = ["help", "whoami", "run modelarena --train", "eval --split test", "cat modelarena", "cat finance-tracker", "cat savebite", "curl /contact", "clear", "exit"];
        const match = candidates.find((c) => c.startsWith(val));
        if (match) {
          input.value = match;
          updateCursorDisplay();
        }
      }
    });

