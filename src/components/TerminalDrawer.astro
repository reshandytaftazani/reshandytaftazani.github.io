---
// TerminalDrawer.astro
// UNIX Monospaced Interactive Terminal Drawer (Client-Side Pure TypeScript REPL Shell)
// High-precision Swiss Brutalist design, live IPC status, multi-agent training simulation & verified invariants
---

<!-- Scrim Backdrop -->
<div 
  id="terminal-scrim"
  class="fixed inset-0 z-[99990] bg-black/60 backdrop-blur-[2px] opacity-0 pointer-events-none transition-opacity duration-300 no-print print:hidden"
  aria-hidden="true"
></div>

<!-- Terminal Drawer Sliding Panel -->
<aside
  id="terminal-drawer"
  class="fixed bottom-0 left-0 right-0 z-[99992] flex flex-col bg-[#08090a] border-t-2 border-accent/80 font-mono text-xs translate-y-full no-print print:hidden shadow-[0_-16px_50px_rgba(0,0,0,0.95)]"
  role="region"
  aria-label="Interactive UNIX Kernel Terminal Drawer"
>
  <!-- Animated Top Accent Beam -->
  <div class="terminal-top-beam pointer-events-none absolute top-0 left-0 right-0 h-[2px] opacity-0 transition-opacity duration-500 z-10" aria-hidden="true"></div>
  <!-- Header Bar -->
  <div class="flex items-center justify-between px-3 sm:px-4 py-2 bg-[#0e1113] border-b border-[#1c2227] select-none text-[11px] sm:text-xs">
    <!-- Left: Identity & IPC Telemetry -->
    <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
      <!-- Traffic Light Dots -->
      <div class="hidden sm:flex items-center gap-1.5 shrink-0" aria-hidden="true">
        <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56] border border-[#e0443e]/50"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e] border border-[#dea123]/50"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f] border border-[#1aab29]/50"></span>
      </div>

      <!-- Kernel Identity -->
      <div class="flex items-center gap-1.5 font-bold tracking-wider text-foreground truncate">
        <span class="text-accent">&gt;</span>
        <span class="truncate">[KERNEL // LINUX 6.8 RESHANDY-x86_64]</span>
      </div>

      <!-- Live Status Badge -->
      <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-xs bg-emerald-950/60 border border-emerald-500/40 text-emerald-400 font-bold text-[10px] shrink-0">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="tracking-widest">IPC: POSIX_RING_ACTIVE</span>
      </div>
    </div>

    <!-- Right: Window Controls -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <button
        type="button"
        id="term-btn-help"
        class="hidden md:inline-flex items-center gap-1 px-2 py-0.5 rounded-xs border border-[#2a2a2a] hover:border-accent bg-[#14181b] hover:bg-accent text-neutral-300 hover:text-black font-bold text-[10px] transition-colors cursor-pointer select-none"
        title="Show command dictionary"
      >
        <span>[HELP]</span>
      </button>

      <button
        type="button"
        id="term-btn-clear"
        class="hidden sm:inline-flex items-center gap-1 px-2 py-0.5 rounded-xs border border-[#2a2a2a] hover:border-accent bg-[#14181b] hover:bg-accent text-neutral-300 hover:text-black font-bold text-[10px] transition-colors cursor-pointer select-none"
        title="Clear screen buffer"
      >
        <span>[CLR]</span>
      </button>

      <button
        type="button"
        id="term-btn-resize"
        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-xs border border-[#2a2a2a] hover:border-accent bg-[#14181b] hover:bg-accent text-neutral-300 hover:text-black font-bold text-[10px] transition-colors cursor-pointer select-none"
        title="Toggle full screen / default height"
        aria-label="Maximize terminal drawer"
      >
        <span id="term-btn-resize-text">[MAX]</span>
      </button>

      <button
        type="button"
        id="term-btn-close"
        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-xs border border-accent/40 hover:border-accent bg-accent/10 hover:bg-accent text-accent hover:text-black font-bold text-[10px] transition-colors cursor-pointer select-none"
        title="Close terminal drawer (ESC)"
        aria-label="Close terminal drawer"
      >
        <span>[ESC / CLOSE]</span>
      </button>
    </div>
  </div>

  <!-- Terminal Screen (Scrollable History Buffer + Active Prompt) -->
  <div
    id="terminal-screen"
    class="flex-1 overflow-y-auto p-3 sm:p-4 font-mono text-[11px] sm:text-xs leading-relaxed select-text space-y-3 bg-[#08090a] text-neutral-300 cursor-text"
  >
    <!-- Screen Log Buffer (Dynamic history items inserted here) -->
    <div id="terminal-log" class="space-y-3"></div>

    <!-- Active Input Line with Blinking Monospaced Cursor & Dynamic Agent Badge -->
    <div id="terminal-active-line" class="flex flex-col sm:flex-row sm:items-center gap-1.5 sm:gap-2.5 pt-2 border-t border-[#181f25]/80">
      <div class="flex items-center gap-2 select-none shrink-0 font-bold">
        <span 
          id="term-status-badge" 
          class="px-1.5 py-0.5 rounded-xs bg-emerald-950/70 text-emerald-400 border border-emerald-500/30 text-[9.5px] tracking-wider uppercase transition-colors"
        >
          ● IDLE
        </span>
        <span class="text-neutral-400">guest@reshandy-kernel</span>
        <span class="text-neutral-600">:</span>
        <span class="text-[#38bdf8]">~</span>
        <span class="text-accent font-bold">❯</span>
      </div>
      <div class="relative flex-1 min-w-0 font-mono text-foreground flex items-center">
        <!-- Rendered Text with Inline Hovering Cursor -->
        <span id="term-before-cursor" class="whitespace-pre-wrap break-all"></span>
        <span id="term-cursor" class="inline-block min-w-[8px] sm:min-w-[9px] h-4 bg-accent text-black font-bold text-center leading-4 select-none animate-pulse"> </span>
        <span id="term-after-cursor" class="whitespace-pre-wrap break-all"></span>
        
        <!-- Native invisible input receiving keyboard input & paste events -->
        <input
          type="text"
          id="terminal-input"
          class="absolute inset-0 w-full h-full opacity-0 cursor-text z-10"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          aria-label="Kernel Terminal Command Prompt"
        />
      </div>
    </div>
  </div>

  <!-- Quick Command Pills / Status Footer -->
  <div class="flex items-center justify-between px-3 sm:px-4 py-1.5 bg-[#0b0e10] border-t border-[#181d21] text-[10px] text-neutral-500 overflow-x-auto whitespace-nowrap gap-2 select-none">
    <div class="flex items-center gap-1.5 shrink-0">
      <span class="text-neutral-600 font-bold hidden sm:inline">QUICK:</span>
      <button type="button" class="term-quick-cmd px-1.5 py-0.5 rounded-xs bg-[#121619] hover:bg-accent hover:text-black text-neutral-400 font-bold transition-colors cursor-pointer" data-cmd="help">help</button>
      <button type="button" class="term-quick-cmd px-1.5 py-0.5 rounded-xs bg-[#121619] hover:bg-accent hover:text-black text-[#38bdf8] font-bold transition-colors cursor-pointer" data-cmd="whoami">whoami</button>
      <button type="button" class="term-quick-cmd px-1.5 py-0.5 rounded-xs bg-[#121619] hover:bg-accent hover:text-black text-emerald-400 font-bold transition-colors cursor-pointer" data-cmd="run modelarena --train">run modelarena --train</button>
      <button type="button" class="term-quick-cmd px-1.5 py-0.5 rounded-xs bg-[#121619] hover:bg-accent hover:text-black text-amber-300 font-bold transition-colors cursor-pointer" data-cmd="eval --split test">eval --split test</button>
      <button type="button" class="term-quick-cmd px-1.5 py-0.5 rounded-xs bg-[#121619] hover:bg-accent hover:text-black text-neutral-400 font-bold transition-colors cursor-pointer" data-cmd="cat modelarena">cat modelarena</button>
      <button type="button" class="term-quick-cmd px-1.5 py-0.5 rounded-xs bg-[#121619] hover:bg-accent hover:text-black text-neutral-400 font-bold transition-colors cursor-pointer" data-cmd="cat leakguard-ml">cat leakguard-ml</button>
      <button type="button" class="term-quick-cmd px-1.5 py-0.5 rounded-xs bg-[#121619] hover:bg-accent hover:text-black text-neutral-400 font-bold transition-colors cursor-pointer" data-cmd="cat finance-tracker">cat finance-tracker</button>
      <button type="button" class="term-quick-cmd px-1.5 py-0.5 rounded-xs bg-[#121619] hover:bg-accent hover:text-black text-neutral-400 font-bold transition-colors cursor-pointer" data-cmd="roofline">roofline</button>
      <button type="button" class="term-quick-cmd px-1.5 py-0.5 rounded-xs bg-[#121619] hover:bg-accent hover:text-black text-neutral-400 font-bold transition-colors cursor-pointer" data-cmd="curl /contact">curl /contact</button>
    </div>

    <div class="hidden lg:flex items-center gap-3 shrink-0 text-neutral-500 text-[10px]">
      <span><kbd class="text-neutral-400">`</kbd> or <kbd class="text-neutral-400">Ctrl+J</kbd> toggle</span>
      <span>•</span>
      <span><kbd class="text-neutral-400">↑↓</kbd> history</span>
      <span>•</span>
      <span><kbd class="text-neutral-400">ESC</kbd> close</span>
    </div>
  </div>
</aside>

<style>
  @media print {
    #terminal-drawer,
    #terminal-scrim {
      display: none !important;
      visibility: hidden !important;
      box-shadow: none !important;
    }
  }

  /* Scrim Backdrop Smooth Fade (Synchronized for Open & Close) */
  #terminal-scrim {
    transition: opacity 320ms cubic-bezier(0.16, 1, 0.3, 1),
                backdrop-filter 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Default Drawer Height & Accelerated Exit Motion */
  #terminal-drawer {
    position: fixed !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    z-index: 99992 !important;
    height: 60vh;
    transform: translateY(100%);
    pointer-events: none;
    transition: transform 320ms cubic-bezier(0.32, 0, 0.67, 0),
                height 380ms cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 320ms ease-in;
    will-change: transform, height;
    box-shadow: 0 -16px 50px rgba(0, 0, 0, 0.95);
  }

  @media (min-width: 768px) {
    #terminal-drawer {
      height: 44vh;
    }
  }

  /* Active Open State: Tactile Spring Slide-Up Deceleration */
  #terminal-drawer.translate-y-0,
  #terminal-drawer.is-open {
    transform: translateY(0) !important;
    pointer-events: auto !important;
    box-shadow: 0 -24px 60px rgba(0, 0, 0, 0.98), 0 -2px 28px rgba(255, 69, 0, 0.28);
    transition: transform 440ms cubic-bezier(0.16, 1, 0.3, 1),
                height 400ms cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 440ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Active Closing State: Swift, natural gravity drop off-screen */
  #terminal-drawer.is-closing {
    transform: translateY(100%) !important;
    pointer-events: none !important;
    transition: transform 320ms cubic-bezier(0.32, 0, 0.67, 0) !important,
                box-shadow 280ms ease-out !important;
  }

  #terminal-drawer.translate-y-full:not(.is-open) {
    transform: translateY(100%) !important;
    pointer-events: none !important;
  }

  /* Maximized Drawer Viewport Clamp with Smooth Transition */
  #terminal-drawer.is-maximized {
    height: 92vh !important;
  }

  /* Luminous top border sweep beam */
  @keyframes beamSweep {
    0% {
      background-position: -200% 0;
      opacity: 0.7;
    }
    50% {
      opacity: 1;
    }
    100% {
      background-position: 200% 0;
      opacity: 0.7;
    }
  }

  #terminal-drawer.translate-y-0 .terminal-top-beam {
    opacity: 1;
    background: linear-gradient(90deg, transparent 0%, #ff4500 50%, transparent 100%);
    background-size: 200% 100%;
    animation: beamSweep 3.2s infinite linear;
  }

  /* Entrance keyframes for initial boot banner and prompt */
  @keyframes termEntranceAppear {
    0% {
      opacity: 0;
      transform: translateY(14px);
      filter: brightness(1.25);
    }
    70% {
      filter: brightness(1.05);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      filter: brightness(1);
    }
  }

  .term-entrance-appear {
    animation: termEntranceAppear 360ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Entrance keyframes for command execution cards */
  @keyframes termCardEntrance {
    0% {
      opacity: 0;
      transform: translateY(12px) scale(0.995);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .term-card-entrance {
    animation: termCardEntrance 280ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Entrance keyframes for streaming lines */
  @keyframes termLineEntrance {
    0% {
      opacity: 0;
      transform: translateX(-6px);
    }
    100% {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .term-line-entrance {
    animation: termLineEntrance 140ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Scanline texture for authentic UNIX terminal buffer */
  #terminal-screen {
    background-image: linear-gradient(
      rgba(14, 18, 22, 0) 50%,
      rgba(0, 0, 0, 0.3) 50%
    );
    background-size: 100% 4px;
  }

  /* Sleek monospaced scrollbar */
  #terminal-screen::-webkit-scrollbar {
    width: 6px;
  }
  #terminal-screen::-webkit-scrollbar-track {
    background: #08090a;
  }
  #terminal-screen::-webkit-scrollbar-thumb {
    background: #22292f;
    border-radius: 2px;
  }
  #terminal-screen::-webkit-scrollbar-thumb:hover {
    background: #ff4500;
  }
</style>

