      },
      invariants: [
        "Pickup deadlines must be strictly in the future at submission time",
        "Concurrent claim requests resolve with strict database row atomicity",
        "Session tokens and CSRF validations guard all mutating state operations"
      ],
      source_repo: "https://github.com/PBP-D-Kelompok-8/SaveBite"
    },
    "leakguard-ml": {
      id: "leakguard-ml",
      name: "LeakGuard ML",
      title: "Point-in-Time Feature Store & Lookahead Leakage Prevention",
      status: "100% TEMPORAL ISOLATION",
      architecture: {
        temporal_join: "Polars Rust Vectorized As-Of Joins",
        cross_validation: "Purged & Embargoed Rolling Splits",
        audit_harness: "Chaos Timestamp Scrambler with Invariant Assertions",
        columnar_store: "DuckDB & Apache Parquet"
      },
      verified_metrics: {
        throughput: "14.2M rows/sec temporal join throughput",
        peak_memory: "412 MB streaming footprint on 50k events",
        leakage_violations: "0 / 50,000 verified against future information",
        vectorized_speedup: "6.4x vs standard Pandas temporal joins"
      },
      invariants: [
        "Query timestamp strictly upper-bounds feature availability horizon",
        "Purge window strips lookahead overlap on overlapping trade/signal labels"
      ],
      source_repo: "https://github.com/reshandytaftazani/leakguard-ml"
    }
  };

  function setupTerminalDrawer() {
    const drawer = document.getElementById("terminal-drawer");
    const scrim = document.getElementById("terminal-scrim");
    const screen = document.getElementById("terminal-screen");
    const log = document.getElementById("terminal-log");
    const input = document.getElementById("terminal-input") as HTMLInputElement | null;
    const beforeCursor = document.getElementById("term-before-cursor");
    const cursor = document.getElementById("term-cursor");
    const afterCursor = document.getElementById("term-after-cursor");
    const btnResize = document.getElementById("term-btn-resize");
    const btnResizeText = document.getElementById("term-btn-resize-text");
    const btnClose = document.getElementById("term-btn-close");
    const btnHelp = document.getElementById("term-btn-help");
    const btnClear = document.getElementById("term-btn-clear");

    if (!drawer || !scrim || !screen || !log || !input || !beforeCursor || !cursor || !afterCursor) {
      return;
    }

    let isOpen = false;
    let isMaximized = false;
    let isStreaming = false;
    let activeTrainingInterval: ReturnType<typeof setInterval> | null = null;
    const commandHistory: string[] = [];
    let historyIndex = -1;

    // Helper: Escape HTML
    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    // Helper: Syntax highlight JSON
    function syntaxHighlightJson(json: unknown): string {
      const str = JSON.stringify(json, null, 2);
      return str.replace(
        /("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+-]?\d+)?)/g,
        (match) => {
          let cls = "text-amber-300"; // number
          if (/^"/.test(match)) {
            if (/:$/.test(match)) {
              cls = "text-[#38bdf8] font-bold"; // key
            } else {
              cls = "text-[#a7f3d0]"; // string
            }
          } else if (/true|false/.test(match)) {
            cls = "text-[#f472b6] font-bold"; // boolean
          } else if (/null/.test(match)) {
            cls = "text-neutral-500 italic"; // null
          }
          return `<span class="${cls}">${escapeHtml(match)}</span>`;
        }
      );
    }

    // Update the custom monospaced block cursor representation
    function updateCursorDisplay() {
      const val = input.value;
      const selStart = input.selectionStart ?? val.length;
      
      const before = val.slice(0, selStart);
      const charAtCursor = selStart < val.length ? val[selStart] : " ";
      const after = selStart < val.length ? val.slice(selStart + 1) : "";

      beforeCursor.textContent = before;
      cursor.textContent = charAtCursor;
      afterCursor.textContent = after;
    }

    function scrollScreenToBottom() {
      requestAnimationFrame(() => {
        screen.scrollTop = screen.scrollHeight;
      });
    }

    // Display initial boot welcome banner once
    function renderBootBanner() {
      if (log.children.length === 0) {
        const banner = document.createElement("div");
        banner.className = "p-3 rounded-xs bg-[#0b0e11] border border-[#1b2228] text-neutral-400 space-y-1.5";
        banner.innerHTML = `
          <div class="flex items-center justify-between border-b border-[#1c2228] pb-1.5 text-[10px] text-neutral-500">
            <span class="text-accent font-bold">RESHANDY_KERNEL v2.4 (x86_64-pc-none-elf)</span>
            <span>DEPOK, ID // UTC+7</span>
          </div>
          <p class="text-foreground font-semibold">
            Interactive ML &amp; Systems Engineering Shell. Zero Data Leakage • Clean Invariants.
          </p>
          <p class="text-[11px] text-neutral-400">
            Type <span class="text-accent font-bold">help</span> for command dictionary, <span class="text-[#38bdf8] font-bold">whoami</span> for candidate profile,
            or <span class="text-emerald-400 font-bold">run modelarena --train</span> for multi-agent simulation.
          </p>
        `;
        log.appendChild(banner);
        scrollScreenToBottom();
      }
    }

    // Open terminal drawer
    function openTerminal() {
      if (isOpen) return;
      isOpen = true;
      drawer.classList.remove("translate-y-full");
      drawer.classList.add("translate-y-0");
      scrim.classList.remove("opacity-0", "pointer-events-none");
      scrim.classList.add("opacity-100", "pointer-events-auto");
      
      renderBootBanner();
      
      requestAnimationFrame(() => {
        input.focus();
        updateCursorDisplay();
        scrollScreenToBottom();
      });
      playClick();
    }

    // Close terminal drawer
    function closeTerminal() {
      if (!isOpen) return;
      isOpen = false;
      drawer.classList.remove("translate-y-0");
      drawer.classList.add("translate-y-full");
      scrim.classList.remove("opacity-100", "pointer-events-auto");
      scrim.classList.add("opacity-0", "pointer-events-none");
      
      // Stop background interval immediately if user closes during training stream
      if (activeTrainingInterval) {
        clearInterval(activeTrainingInterval);
        activeTrainingInterval = null;
        isStreaming = false;
        input.disabled = false;
      }

      input.blur();
      playClick();
    }

    // Toggle terminal drawer
    function toggleTerminal() {
      if (isOpen) {
        closeTerminal();
      } else {
        openTerminal();
      }
    }

    // Toggle maximize state
    function toggleMaximize() {
      isMaximized = !isMaximized;
      if (isMaximized) {
        drawer.classList.add("is-maximized");
        if (btnResizeText) btnResizeText.textContent = "[RESTORE]";
      } else {
        drawer.classList.remove("is-maximized");
        if (btnResizeText) btnResizeText.textContent = "[MAX]";
      }
      playClick();
      scrollScreenToBottom();
    }

    // Abort ongoing training stream
    function abortTraining() {
      if (activeTrainingInterval) {
        clearInterval(activeTrainingInterval);
        activeTrainingInterval = null;
      }
      isStreaming = false;
      appendLogLine("^C", "text-neutral-500 font-bold");
      appendLogLine("[TRAINING ABORTED BY USER]", "text-amber-400 font-bold");
      input.disabled = false;
      input.focus();
      playViolation();
      scrollScreenToBottom();
    }

    // Append a raw log entry
    function appendLogEntry(command: string, htmlOutput: string) {
      const entry = document.createElement("div");
      entry.className = "space-y-1.5";
      entry.innerHTML = `
        <div class="flex items-baseline gap-2 font-bold text-neutral-400">
          <span class="text-accent select-none">guest@reshandy-kernel:~$</span>
          <span class="text-foreground">${escapeHtml(command)}</span>
        </div>
        <div class="term-stdout pl-2 sm:pl-3 border-l-2 border-[#1c2227] space-y-1">${htmlOutput}</div>
      `;
      log.appendChild(entry);
      scrollScreenToBottom();
    }

    // Append single line
    function appendLogLine(text: string, className = "text-neutral-300") {
      const line = document.createElement("div");
      line.className = className;
      line.textContent = text;
      log.appendChild(line);
      scrollScreenToBottom();
    }

    // REPL Command Execution Engine
    function executeCommand(rawCommand: string) {
      const trimmed = rawCommand.trim();
      if (!trimmed) return;

      // History recording
      if (commandHistory.length === 0 || commandHistory[commandHistory.length - 1] !== trimmed) {
        commandHistory.push(trimmed);
      }
      historyIndex = commandHistory.length;

      const tokens = trimmed.split(/\s+/);
      const cmd = tokens[0].toLowerCase();
      const args = tokens.slice(1);

      switch (cmd) {
        case "help": {
          playSuccess();
          const html = `
            <div class="overflow-x-auto text-[11px] sm:text-xs">
              <div class="text-accent font-bold pb-1">[SYSTEM COMMAND DICTIONARY &amp; KERNEL INTERFACES]</div>
              <table class="w-full text-left border-collapse border border-[#222]">
                <thead>
                  <tr class="bg-[#121619] text-neutral-400 border-b border-[#222]">
                    <th class="p-1.5">COMMAND</th>
                    <th class="p-1.5">ARGUMENTS</th>
                    <th class="p-1.5">DESCRIPTION</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[#1a1a1a]">
                  <tr>
                    <td class="p-1.5 text-accent font-bold">help</td>
                    <td class="p-1.5 text-neutral-500">—</td>
                    <td class="p-1.5 text-neutral-300">Display this command dictionary table</td>
                  </tr>
                  <tr>
                    <td class="p-1.5 text-accent font-bold">whoami</td>
                    <td class="p-1.5 text-neutral-500">—</td>
                    <td class="p-1.5 text-neutral-300">Candidate profile (Reshandy Taftazani Aulya, CS @ UI, MLE &amp; Systems)</td>
                  </tr>
                  <tr>
                    <td class="p-1.5 text-accent font-bold">cat</td>
                    <td class="p-1.5 text-[#38bdf8]">[modelarena|finance-tracker|savebite]</td>
                    <td class="p-1.5 text-neutral-300">Display JSON architecture &amp; verified engineering invariants</td>
                  </tr>
                  <tr>
                    <td class="p-1.5 text-accent font-bold">run</td>
                    <td class="p-1.5 text-emerald-400">modelarena --train</td>
                    <td class="p-1.5 text-neutral-300">Execute multi-agent RL simulation with 100ms streaming stdout logs</td>
                  </tr>
                  <tr>
                    <td class="p-1.5 text-accent font-bold">eval</td>
                    <td class="p-1.5 text-[#a7f3d0]">--split test</td>
                    <td class="p-1.5 text-neutral-300">Display quantitative table (Sharpe ratio, max drawdown, inference latency)</td>
                  </tr>
                  <tr>
                    <td class="p-1.5 text-accent font-bold">curl</td>
                    <td class="p-1.5 text-amber-300">/contact</td>
                    <td class="p-1.5 text-neutral-300">Display contact email, PGP public key fingerprint, and social endpoints</td>
                  </tr>
                  <tr>
                    <td class="p-1.5 text-accent font-bold">clear</td>
                    <td class="p-1.5 text-neutral-500">—</td>
                    <td class="p-1.5 text-neutral-300">Clear terminal output screen buffer</td>
                  </tr>
                  <tr>
