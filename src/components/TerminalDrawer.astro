    // Open terminal drawer
    function openTerminal() {
      if (isOpen) return;
      isOpen = true;
      if (isClosingTimeout) {
        clearTimeout(isClosingTimeout);
        isClosingTimeout = null;
      }
      drawer.classList.remove("translate-y-full", "is-closing");
      drawer.classList.add("translate-y-0", "is-open");
      scrim.classList.remove("opacity-0", "pointer-events-none");
      scrim.classList.add("opacity-100", "pointer-events-auto");
      
      renderBootBanner();
      
      requestAnimationFrame(() => {
        input.focus();
        updateCursorDisplay();
        scrollScreenToBottom();
      });
      playClick();
    }

    // Close terminal drawer
    function closeTerminal() {
      if (!isOpen) return;
      isOpen = false;
      drawer.classList.remove("translate-y-0", "is-open");
      drawer.classList.add("translate-y-full", "is-closing");
      scrim.classList.remove("opacity-100", "pointer-events-auto");
      scrim.classList.add("opacity-0", "pointer-events-none");
      
      if (isClosingTimeout) clearTimeout(isClosingTimeout);
      isClosingTimeout = setTimeout(() => {
        drawer.classList.remove("is-closing");
        // Reset maximize cleanly while hidden offscreen
        if (isMaximized) {
          isMaximized = false;
          drawer.classList.remove("is-maximized");
          if (btnResizeText) btnResizeText.textContent = "[MAX]";
        }
        isClosingTimeout = null;
      }, 340);

      // Stop background interval immediately if user closes during training stream
      if (activeTrainingInterval) {
        clearInterval(activeTrainingInterval);
        activeTrainingInterval = null;
        isStreaming = false;
        input.disabled = false;
      }

      setKernelStatus("idle");
      input.blur();
      playClick();
    }

    // Toggle terminal drawer
    function toggleTerminal() {
      if (isOpen) {
        closeTerminal();
      } else {
        openTerminal();
      }
    }

    // Toggle maximize state with fluid spring animation
    function toggleMaximize() {
      isMaximized = !isMaximized;
      if (isMaximized) {
        drawer.classList.add("is-maximized");
        if (btnResizeText) btnResizeText.textContent = "[RESTORE]";
        if (btnResize) btnResize.setAttribute("aria-label", "Restore terminal drawer to default height");
      } else {
        drawer.classList.remove("is-maximized");
        if (btnResizeText) btnResizeText.textContent = "[MAX]";
        if (btnResize) btnResize.setAttribute("aria-label", "Maximize terminal drawer");
      }
      playClick();
      scrollScreenToBottom();
    }

    // Abort ongoing training stream
    function abortTraining() {
      if (activeTrainingInterval) {
        clearInterval(activeTrainingInterval);
        activeTrainingInterval = null;
      }
      isStreaming = false;
      appendLogLine("^C", "text-neutral-500 font-bold");
      appendLogLine("[TRAINING ABORTED BY USER (SIGINT)]", "text-amber-400 font-bold");
      input.disabled = false;
      input.focus();
      setKernelStatus("idle");
      playViolation();
      scrollScreenToBottom();
    }

