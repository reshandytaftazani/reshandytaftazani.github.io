              <span class="text-accent font-bold">SYSTEMS:</span>
              <span class="text-neutral-300"> Worker Supervision, SQLite Queue</span>
            </div>
            <div class="p-2 rounded-xs bg-[#101419] border border-[#1d2630]">
              <span class="text-accent font-bold">ML / DATA:</span>
              <span class="text-neutral-300"> Zero Leakage, Fold-Local Preprocessing, MLflow</span>
            </div>
            <div class="p-2 rounded-xs bg-[#101419] border border-[#1d2630]">
              <span class="text-accent font-bold">FINTECH:</span>
              <span class="text-neutral-300"> Integer Rupiah, Database Constraints, Backups</span>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-1.5 pt-1 text-[11px] text-neutral-400">
            <span class="text-neutral-500">Quick start:</span>
            <button type="button" class="term-quick-cmd px-1.5 py-0.5 rounded-xs bg-[#151b22] hover:bg-accent hover:text-black text-neutral-300 font-bold transition-colors cursor-pointer" data-cmd="help">help</button>
            <button type="button" class="term-quick-cmd px-1.5 py-0.5 rounded-xs bg-[#151b22] hover:bg-accent hover:text-black text-[#38bdf8] font-bold transition-colors cursor-pointer" data-cmd="whoami">whoami</button>
