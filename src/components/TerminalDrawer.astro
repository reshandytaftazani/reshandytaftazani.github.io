  function setupTerminalDrawer() {
    const drawer = document.getElementById("terminal-drawer");
    const scrim = document.getElementById("terminal-scrim");
    const screen = document.getElementById("terminal-screen");
    const log = document.getElementById("terminal-log");
    const input = document.getElementById("terminal-input") as HTMLInputElement | null;
    const beforeCursor = document.getElementById("term-before-cursor");
    const cursor = document.getElementById("term-cursor");
    const afterCursor = document.getElementById("term-after-cursor");
    const btnResize = document.getElementById("term-btn-resize");
    const btnResizeText = document.getElementById("term-btn-resize-text");
    const btnClose = document.getElementById("term-btn-close");
    const btnHelp = document.getElementById("term-btn-help");
    const btnClear = document.getElementById("term-btn-clear");
    const statusBadge = document.getElementById("term-status-badge");

    if (!drawer || !scrim || !screen || !log || !input || !beforeCursor || !cursor || !afterCursor) {
      return;
    }

    let isOpen = false;
    let isMaximized = false;
    let isStreaming = false;
    let activeTrainingInterval: ReturnType<typeof setInterval> | null = null;
    let isClosingTimeout: ReturnType<typeof setTimeout> | null = null;
    const commandHistory: string[] = [];
    let historyIndex = -1;

    // Helper: Update dynamic status badge
    function setKernelStatus(state: "idle" | "busy" | "exec") {
      if (!statusBadge) return;
      if (state === "exec") {
        statusBadge.className = "px-1.5 py-0.5 rounded-xs bg-amber-950/80 text-amber-400 border border-amber-500/40 text-[9.5px] tracking-wider uppercase font-bold animate-pulse";
        statusBadge.textContent = "⚡ EXEC";
      } else if (state === "busy") {
        statusBadge.className = "px-1.5 py-0.5 rounded-xs bg-accent/20 text-accent border border-accent/40 text-[9.5px] tracking-wider uppercase font-bold animate-pulse";
        statusBadge.textContent = "▲ BUSY";
      } else {
        statusBadge.className = "px-1.5 py-0.5 rounded-xs bg-emerald-950/70 text-emerald-400 border border-emerald-500/30 text-[9.5px] tracking-wider uppercase font-bold";
        statusBadge.textContent = "● IDLE";
      }
    }

    // Helper: Escape HTML
    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    // Helper: Syntax highlight JSON
    function syntaxHighlightJson(json: unknown): string {
      const str = JSON.stringify(json, null, 2);
      return str.replace(
        /("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+-]?\d+)?)/g,
        (match) => {
          let cls = "text-amber-300"; // number
          if (/^"/.test(match)) {
            if (/:$/.test(match)) {
              cls = "text-[#38bdf8] font-bold"; // key
            } else {
              cls = "text-[#a7f3d0]"; // string
            }
          } else if (/true|false/.test(match)) {
            cls = "text-[#f472b6] font-bold"; // boolean
          } else if (/null/.test(match)) {
            cls = "text-neutral-500 italic"; // null
          }
          return `<span class="${cls}">${escapeHtml(match)}</span>`;
        }
      );
    }

    // Update the custom monospaced block cursor representation
    function updateCursorDisplay() {
      const val = input.value;
      const selStart = input.selectionStart ?? val.length;
      
      const before = val.slice(0, selStart);
      const charAtCursor = selStart < val.length ? val[selStart] : " ";
      const after = selStart < val.length ? val.slice(selStart + 1) : "";

      beforeCursor.textContent = before;
      cursor.textContent = charAtCursor;
      afterCursor.textContent = after;
    }

    function scrollScreenToBottom() {
      requestAnimationFrame(() => {
        screen.scrollTop = screen.scrollHeight;
      });
    }

    // Display initial boot welcome banner with modern systems telemetry
    function renderBootBanner() {
      if (log.children.length === 0) {
        const banner = document.createElement("div");
        banner.className = "p-3 sm:p-3.5 rounded-xs bg-[#0b0e12] border border-[#1b232c] text-neutral-300 space-y-2.5 shadow-sm term-entrance-appear";
        banner.innerHTML = `
          <div class="flex flex-wrap items-center justify-between border-b border-[#1f2832] pb-2 gap-2 text-[10.5px]">
            <div class="flex items-center gap-2">
              <span class="text-accent font-bold tracking-wider">[RESHANDY_KERNEL v2.4]</span>
              <span class="text-neutral-500 font-mono">(x86_64-pc-linux-gnu)</span>
            </div>
            <div class="flex items-center gap-2 text-neutral-500 font-mono text-[10px]">
              <span class="text-emerald-400 font-bold">POSIX_IPC: READY</span>
              <span>•</span>
              <span>CUDA_ARBITER: ONLINE</span>
              <span>•</span>
              <span>DEPOK, ID // UTC+07</span>
            </div>
          </div>

          <p class="text-foreground text-[11.5px] sm:text-xs font-semibold leading-relaxed">
            Interactive ML &amp; Systems Engineering Shell. Defensive Invariants • Zero Data Leakage • Clean Hexagonal Architecture.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-[10.5px] pt-0.5">
