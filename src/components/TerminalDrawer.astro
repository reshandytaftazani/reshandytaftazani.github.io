              <div>zsh: command not found: ${escapeHtml(cmd)}</div>
              <div class="text-neutral-400 font-normal text-[11px]">
                Type <button type="button" class="term-quick-cmd text-accent font-bold underline cursor-pointer" data-cmd="help">help</button> to view available kernel interfaces.
              </div>
            </div>
          `;
          appendLogEntry(trimmed, html, "127 NOT_FOUND", "error", tookMs);
          setKernelStatus("idle");
          break;
        }
      }
    }

    // Input handlers
    input.addEventListener("input", () => {
      updateCursorDisplay();
      scrollScreenToBottom();
    });

    input.addEventListener("keyup", () => {
      updateCursorDisplay();
    });

    input.addEventListener("click", () => {
      updateCursorDisplay();
    });

    // Screen click redirects focus to input
    screen.addEventListener("click", (e) => {
      // If user clicked a quick command inside stdout
      const target = e.target as HTMLElement;
      if (target && target.classList.contains("term-quick-cmd")) {
        const cmd = target.getAttribute("data-cmd");
        if (cmd) {
          executeCommand(cmd);
          input.focus();
          return;
        }
      }

      // If user isn't actively selecting text, focus input
      const selection = window.getSelection();
      if (!selection || selection.isCollapsed) {
        input.focus();
        updateCursorDisplay();
      }
    });

    // Keyboard navigation & execution
    input.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Enter") {
        e.preventDefault();
        const val = input.value;
        input.value = "";
        updateCursorDisplay();
        executeCommand(val);
        return;
      }

      if (e.key === "ArrowUp") {
        e.preventDefault();
        if (commandHistory.length === 0) return;
        if (historyIndex > 0) {
          historyIndex--;
        } else if (historyIndex === -1) {
          historyIndex = commandHistory.length - 1;
        }
        input.value = commandHistory[historyIndex] ?? "";
        updateCursorDisplay();
        return;
      }

      if (e.key === "ArrowDown") {
        e.preventDefault();
        if (commandHistory.length === 0) return;
        if (historyIndex < commandHistory.length - 1 && historyIndex !== -1) {
          historyIndex++;
          input.value = commandHistory[historyIndex] ?? "";
        } else {
          historyIndex = -1;
          input.value = "";
        }
        updateCursorDisplay();
        return;
      }

      if (e.key === "Tab") {
        e.preventDefault();
        const val = input.value.trim().toLowerCase();
        const candidates = [
          "help", 
          "whoami", 
          "cat modelarena", 
          "cat finance-tracker", 
          "cat savebite", 
          "roofline",
          "curl /contact", 
          "clear", 
          "exit"
        ];
        const match = candidates.find((c) => c.startsWith(val));
        if (match) {
          input.value = match;
          updateCursorDisplay();
        }
      }
    });

    // Window global shortcut dispatch (prevent conflict when typing in inputs/modals)
    window.addEventListener("keydown", (e: KeyboardEvent) => {
      const activeEl = document.activeElement;
      const isTerminalInput = activeEl === input;
      const isOtherInput = activeEl && (
        activeEl.tagName === "INPUT" ||
        activeEl.tagName === "TEXTAREA" ||
        (activeEl as HTMLElement).isContentEditable
      ) && !isTerminalInput;

      // Check if Command Palette is currently active
      const cmdDialog = document.getElementById("swiss-command-dialog");
      const isCmdPaletteOpen = Boolean(cmdDialog && !cmdDialog.classList.contains("hidden"));

      // Check if Spec modal is open
      const specModal = document.getElementById("spec-sheet-modal");
      const isSpecModalOpen = Boolean(specModal && !specModal.classList.contains("hidden"));

      // If other interactive inputs/modals are active, do NOT intercept backtick or Ctrl+J
      if (isCmdPaletteOpen || isSpecModalOpen || isOtherInput) {
        return;
      }

      const isBacktick = e.key === "`" || e.key === "~" || e.code === "Backquote";
      const isCtrlJ = (e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "j";
      const isEscape = e.key === "Escape";

      // ⌘J / Ctrl+J toggles drawer anytime outside modals
      if (isCtrlJ) {
        e.preventDefault();
        toggleTerminal();
        return;
      }

      // Backtick (` / ~) shortcut handling
      if (isBacktick) {
        if (!isOpen) {
          e.preventDefault();
          openTerminal();
          return;
        }
        // If drawer is open and input is currently empty, close drawer
        if (isTerminalInput && input.value === "") {
          e.preventDefault();
          closeTerminal();
          return;
        }
      }

      // Escape key closes drawer if open
      if (isEscape && isOpen) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        closeTerminal();
        return;
      }

      // Ctrl+C aborts streaming training
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "c" && isOpen) {
        if (isStreaming) {
          e.preventDefault();
          abortTraining();
        }
      }
    });

    // Top button handlers
    btnResize?.addEventListener("click", () => toggleMaximize());
    btnClose?.addEventListener("click", () => closeTerminal());
    scrim.addEventListener("click", () => closeTerminal());
    btnHelp?.addEventListener("click", () => {
      executeCommand("help");
      input.focus();
    });
    btnClear?.addEventListener("click", () => {
      executeCommand("clear");
      input.focus();
    });

    // Quick Command Pills
    document.querySelectorAll<HTMLButtonElement>(".term-quick-cmd").forEach((btn) => {
      btn.addEventListener("click", () => {
        const cmd = btn.getAttribute("data-cmd");
        if (cmd) {
          executeCommand(cmd);
          input.focus();
        }
      });
    });

    // Global trigger badges with [data-open-terminal]
    document.querySelectorAll("[data-open-terminal]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        toggleTerminal();
      });
    });

    // Custom window events
    window.addEventListener("terminal:open", () => openTerminal());
    window.addEventListener("terminal:close", () => closeTerminal());
    window.addEventListener("terminal:toggle", () => toggleTerminal());

    // Lifecycle cleanup to guarantee zero memory leaks across page transitions
    document.addEventListener("astro:before-swap", () => {
      if (activeTrainingInterval) {
        clearInterval(activeTrainingInterval);
        activeTrainingInterval = null;
      }
      isStreaming = false;
    }, { once: true });
  }

  // Idempotent initialization
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupTerminalDrawer);
  } else {
    setupTerminalDrawer();
  }
  document.addEventListener("astro:page-load", setupTerminalDrawer);
</script>
