---
import '../styles/global.css';
import CustomCursor from '../components/CustomCursor.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Reshandy Taftazani | ML & Systems Engineer",
  description = "Portfolio of Reshandy Taftazani Aulya - Computer Science at Universitas Indonesia. Machine Learning Engineering & Software Systems focused on zero data leakage, clean architecture, and rigorous verification.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Reshandy Taftazani Aulya" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="twitter:card" content="summary_large_image" />

    <!-- Favicon: Clean Swiss Minimalist Accent Dot SVG -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='4' fill='%230a0a0a'/><circle cx='16' cy='16' r='6' fill='%23ff4500'/></svg>" />

    <!-- Fonts: Hanken Grotesk (Authentic Swiss Neo-Grotesque) & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-background text-foreground font-sans antialiased min-h-screen relative overflow-x-hidden selection:bg-[#ff4500]/25 selection:text-white">
    
    <!-- Custom Interactive Spring Cursor -->
    <CustomCursor />

    <slot />

    <!-- Daniele Buser Scroll-Triggered Reveal Engine -->
    <script>
      function setupScrollReveals() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.querySelectorAll(".reveal-init, .reveal-hero").forEach((el) => {
            el.classList.add("is-revealed");
          });
          return;
        }

        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-revealed");
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        document.querySelectorAll(".reveal-init, .reveal-hero").forEach((el) => {
          revealObserver.observe(el);
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupScrollReveals);
      } else {
        setupScrollReveals();
      }
      document.addEventListener("astro:page-load", setupScrollReveals);
    </script>
  </body>
</html>
