---
import '../styles/global.css';
import CustomCursor from '../components/CustomCursor.astro';
import PageTransition from '../components/PageTransition.astro';
import CommandPalette from '../components/CommandPalette.astro';
import ProjectSpecModal from '../components/ProjectSpecModal.astro';
import TerminalDrawer from '../components/TerminalDrawer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  hideOverlays?: boolean;
}

const {
  title = "Reshandy Taftazani | ML & Systems Engineer",
  description = "Portfolio of Reshandy Taftazani Aulya - Computer Science at Universitas Indonesia. Machine Learning Engineering & Software Systems focused on zero data leakage, clean architecture, and rigorous verification.",
  ogImage = "/api/og/default.png",
  ogType = "website",
  publishedTime,
  hideOverlays = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Reshandy Taftazani Aulya" />
    <link rel="canonical" href={canonicalURL} />

    <!-- RSS Feed Auto-Discovery -->
    <link rel="alternate" type="application/rss+xml" title="Reshandy Taftazani — Technical Notes RSS Feed" href="/rss.xml" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={title} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:creator" content="@reshandytaftazani" />

    <!-- JSON-LD Structured Data (Schema.org Person / ML Engineer) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Reshandy Taftazani Aulya",
      "alternateName": "Reshandy Taftazani",
      "jobTitle": "Machine Learning & Systems Engineer",
      "url": "https://reshandytaftazani.github.io",
      "affiliation": {
        "@type": "Organization",
        "name": "Universitas Indonesia",
        "department": "Faculty of Computer Science"
      },
      "alumniOf": {
        "@type": "EducationalOrganization",
        "name": "Universitas Indonesia"
      },
      "sameAs": [
        "https://github.com/reshandytaftazani",
        "https://linkedin.com/in/reshandytaftazani"
      ],
      "knowsAbout": [
        "Machine Learning Systems",
        "Data Leakage Prevention",
        "Temporal Join Verification",
        "Clean Architecture",
        "Python",
        "C++"
      ]
    })} />

    <!-- Favicon: Swiss Geometric 'RT' Precision Monogram -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Fonts: Hanken Grotesk (Authentic Swiss Neo-Grotesque) & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-background text-foreground font-sans antialiased min-h-screen relative overflow-x-hidden selection:bg-[#ff4500] selection:text-white">
    
    <!-- Swiss Telemetry Boot Sequence & Continuous Upward Wipe Shutter -->
    <PageTransition />

    {!hideOverlays && (
      <>
        <!-- Global Swiss Command Palette (Ctrl+K / Cmd+K) -->
        <CommandPalette />

        <!-- Project Technical Spec Sheet Modal Drawer -->
        <ProjectSpecModal />

        <!-- Global Interactive UNIX Monospaced Terminal Drawer (~ / Ctrl+J) -->
        <TerminalDrawer />
      </>
    )}

    <!-- Custom Interactive Spring Cursor -->
    <CustomCursor />

    <slot />

    <!-- Daniele Buser Scroll-Triggered Reveal Engine -->
    <script>
      function setupScrollReveals() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.querySelectorAll(".reveal-init, .reveal-hero").forEach((el) => {
            el.classList.add("is-revealed");
          });
          return;
        }

        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-revealed");
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        document.querySelectorAll(".reveal-init, .reveal-hero").forEach((el) => {
          revealObserver.observe(el);
        });

        // Trigger immediate smooth reveal for hero elements when curtain lifts
        window.addEventListener("swiss:page-unveiled", () => {
          document.querySelectorAll(".reveal-hero").forEach((el) => {
            el.classList.add("is-revealed");
          });
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupScrollReveals);
      } else {
        setupScrollReveals();
      }
      document.addEventListener("astro:page-load", setupScrollReveals);
    </script>
  </body>
</html>
